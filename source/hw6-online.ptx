<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW6, online version: the same problems as the written       -->
<!-- Assignment 6, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw6-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 6</title>

  <introduction>
    <p>
      Sections: <xref ref="section-triple-integrals-rectangular" text="title"/>, <xref ref="section-triple-integrals-cylindrical" text="title"/>, and <xref ref="section-triple-integrals-spherical" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw6-online">

  <exercise xml:id="ex-hw6o-cone-mass">
    <title>Mass of a Cone Along the <m>x</m>-Axis</title>
    <statement>
      <p>
        An object is bounded by <m>x = \sqrt{y^2+z^2}</m> and
        <m>x = 1</m>, and its density is <m>\rho(x,y,z) = x</m>.
      </p>
      <p>The mass of the object is <var width="10"/>.</p>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition number="3.142" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        With <m>dV = r\,dr\,d\theta\,dx</m> (the cylindrical volume element
        <xref ref="eq-dv-cylindrical"/> about the <m>x</m>-axis) and
        <m>r \le x \le 1</m>,
      </p>
      <md>
        <mrow>
          M \amp = \int_0^1\!\!\int_0^{2\pi}\!\!\int_r^1
          x\,r\,dx\,d\theta\,dr
          = (2\pi)\left(\tfrac12\right)\int_0^1 r\left(1-r^2\right) dr
        </mrow>
        <mrow>
          \amp = \pi\left[\frac{r^2}{2} - \frac{r^4}{4}\right]_0^1
          = \frac{\pi}{4} \approx 0.785 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-convert">
    <title>From Cylindrical Back to Rectangular</title>
    <statement>
      <p>
        Convert
        <m>\displaystyle\int_{-\pi/4}^{\pi/4}\!\!\int_0^{\sec\theta}
        \!\!\int_0^{r^2\cos(2\theta)} r\,dz\,dr\,d\theta</m> to
        rectangular coordinates.
      </p>
      <p>
        In rectangular coordinates the innermost limit for <m>z</m>
        becomes <var width="12"/>; for a fixed <m>x</m>, <m>y</m> runs from
        <var width="8"/> to <var width="8"/>; and <m>x</m> runs from
        <m>0</m> to <var width="6"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="x\s*\^\s*2\s*-\s*y\s*\^\s*2">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var case="insensitive">
        <condition string="-\s*x">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="x">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        Since <m>r^2\cos(2\theta) = r^2\left(\cos^2\theta -
        \sin^2\theta\right) = x^2 - y^2</m> and
        <m>r = \sec\theta</m> is <m>r\cos\theta = 1</m>, that is
        <m>x = 1</m>, the region in the plane is the triangle bounded by
        <m>y = x</m>, <m>y = -x</m>, and <m>x = 1</m>. Hence
      </p>
      <me>
        \int_0^1\!\!\int_{-x}^{x}\!\!\int_0^{x^2-y^2} dz\,dy\,dx .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-signs">
    <title>Two Signs, No Calculation</title>
    <statement>
      <p>
        Let <m>R</m> be the solid between <m>z = x^2+y^2</m> and
        <m>z = 1-x^2-y^2</m>. Type <c>positive</c>, <c>negative</c>, or
        <c>zero</c> for each.
      </p>
      <p>
        <m>\displaystyle\iiint_R \left(z+x^2+y^2-1\right) dV</m>:
        <var width="12"/>
      </p>
      <p>
        <m>\displaystyle\iiint_R \left(z-x^2-y^2\right) dV</m>:
        <var width="12"/>
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="negative">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="positive">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="positive">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="negative">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        On <m>R</m>, <m>x^2+y^2 \le z \le 1-x^2-y^2</m>. The right
        inequality gives <m>z + x^2 + y^2 - 1 \le 0</m>, so the first
        integral is <term>negative</term>; the left gives
        <m>z - x^2 - y^2 \ge 0</m>, so the second is <term>positive</term>.
        Each integrand vanishes only on one of the two bounding surfaces.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-volume">
    <title>Volume Between a Hyperboloid and a Paraboloid</title>
    <statement>
      <p>
        Find the volume of the region bounded by
        <m>x^2+y^2-z^2+5 = 0</m> and <m>x^2+y^2+z-1 = 0</m>.
      </p>
      <p>
        The two surfaces meet at <m>z = </m> <var width="6"/>, over the
        circle of radius <var width="6"/>, and the volume is
        <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="-3" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="20.566" tolerance="0.05">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        The surfaces are <m>z = \pm\sqrt{r^2+5}</m> and
        <m>z = 1-r^2</m>. Setting <m>r^2 = z^2-5</m> equal to
        <m>r^2 = 1-z</m> gives <m>z^2+z-6 = 0</m>, so <m>z = 2</m> or
        <m>z = -3</m>; only <m>z = -3</m> is possible, and then
        <m>r^2 = 4</m>. Therefore
      </p>
      <me>
        V = \int_0^{2\pi}\!\!\int_0^2\!\!\int_{-\sqrt{r^2+5}}^{1-r^2}
        r\,dz\,dr\,d\theta \approx 20.566 .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-hemisphere">
    <title>A Hemisphere in Spherical Coordinates</title>
    <statement>
      <p>
        Evaluate
      </p>
      <me>
        \int_{0}^{6}\!\!\int_{-\sqrt{36-x^2}}^{\sqrt{36-x^2}}\!\!
        \int_{-\sqrt{36-x^2-z^2}}^{\sqrt{36-x^2-z^2}}
        \frac{dy\,dz\,dx}{\left(x^2+y^2+z^2\right)^{1/2}} .
      </me>
      <p>
        The solid of integration is half of a ball; its radius is
        <var width="6"/>, and the value of the integral is
        <var width="12"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="6" tolerance="0.01">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="113.097" tolerance="0.05">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="226.195" tolerance="0.1">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        The bounds describe the hemisphere <m>\rho \le 6</m>,
        <m>x \ge 0</m>. Since <m>dV = \rho^2\sin\phi\,
        d\rho\,d\phi\,d\theta</m> by <xref ref="eq-dv-spherical"/> and
        the integrand is
        <m>1/\rho</m>,
      </p>
      <md>
        <mrow>
          \int_{-\pi/2}^{\pi/2}\!\!\int_0^{\pi}\!\!\int_0^6
          \rho \sin\phi \,d\rho\,d\phi\,d\theta
          \amp = \pi \cdot \frac{6^2}{2}\cdot 2
        </mrow>
        <mrow>
          \amp = 36\pi \approx 113.097 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-spherical-surfaces">
    <title>Surfaces in Spherical Coordinates</title>
    <statement>
      <p>
        Describe each surface, given in rectangular coordinates, in
        spherical coordinates.
      </p>
      <p>
        (a) The plane <m>x = \sqrt3\,y</m> is the union of the two
        half-planes <m>\theta = </m><var width="6"/> and
        <m>\theta = </m><var width="6"/> (the smaller angle first; both
        between <m>0</m> and <m>2\pi</m>).
      </p>
      <p>
        (b) The cone <m>z^2 = x^2 + y^2</m> is the union of the two cones
        <m>\phi = </m><var width="6"/> and <m>\phi = </m><var width="6"/>
        (the smaller angle first).
      </p>
      <p>
        (c) On the ellipsoid <m>x^2 + y^2 + z^2/4 = 1</m>, write the
        equation in spherical coordinates and solve it for <m>\rho</m> in
        terms of <m>\phi</m>. On the <m>z</m>-axis (<m>\phi = 0</m>) the
        surface is at <m>\rho = </m><var width="4"/>, in the
        <m>xy</m>-plane (<m>\phi = \pi/2</m>) at
        <m>\rho = </m><var width="4"/>, and at <m>\phi = \pi/4</m> at
        <m>\rho = </m><var width="6"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.5236" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="3.6652" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.7854" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.3562" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="1.2649" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        Substitute <m>x = \rho\sin\phi\cos\theta</m>,
        <m>y = \rho\sin\phi\sin\theta</m>, <m>z = \rho\cos\phi</m>
        (<xref ref="eq-spherical-to-rect"/>) in each equation.
      </p>
      <p>
        (a) <m>x = \sqrt3\,y</m> becomes
        <m>\rho\sin\phi\,(\cos\theta - \sqrt3\sin\theta) = 0</m>. Off the
        <m>z</m>-axis this says <m>\tan\theta = 1/\sqrt3</m>, so
        <m>\theta = \pi/6</m> or <m>\theta = 7\pi/6</m>; the <m>z</m>-axis
        itself (<m>\rho\sin\phi = 0</m>) lies in the plane and on both
        half-planes. The plane is vertical, so it is determined by its
        trace in the <m>xy</m>-plane, the line through the origin at angle
        <m>\pi/6</m> (<xref ref="fig-hw6o-surfaces-plane"/>).
      </p>
      <figure xml:id="fig-hw6o-surfaces-plane">
        <caption>
          The trace of the plane <m>x = \sqrt3\,y</m> in the <m>xy</m>-plane: the line through the origin making the angle <m>\pi/6</m> with the positive <m>x</m>-axis. Its two rays are <m>\theta = \pi/6</m> and <m>\theta = 7\pi/6</m>, and the plane is the union of the vertical half-planes above and below them.
        </caption>
        <image width="45%">
          <shortdescription>
          A line through the origin in the xy-plane, tilted thirty degrees above the x axis, with its two rays labelled theta equals pi over six and theta equals seven pi over six.
          </shortdescription>
          <description>
            <p>
            Coordinate axes x and y. A blue line through the origin makes an angle of thirty degrees with the positive x axis. The ray into the first quadrant is labelled theta equals pi over six, with a small green arc marking the angle from the x axis; the opposite ray into the third quadrant is labelled theta equals seven pi over six, with a larger green arc from the positive x axis around to it.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw6o-surfaces-plane">
            <diagram dimensions="(300,300)" margins="10">
              <coordinates bbox="(-1.5,-1.5,1.5,1.5)">
              <axes at="sp-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
              <line at="sp-line" endpoints="((-1.3,-0.7506),(1.3,0.7506))" stroke="#0072B2" thickness="3"/>
              <arc at="sp-arc1" center="(0,0)" radius="0.45" range="(0,30)" stroke="#009E73" thickness="2"/>
              <arc at="sp-arc2" center="(0,0)" radius="0.7" range="(0,210)" stroke="#009E73" thickness="2"/>
              <label at="sp-lab1" anchor="(0.62,0.16)" alignment="e" color="#009E73"><m>\tfrac{\pi}{6}</m></label>
              <label at="sp-lab2" anchor="(-0.35,0.7)" alignment="ne" color="#009E73"><m>\tfrac{7\pi}{6}</m></label>
              <label at="sp-ray1" anchor="(0.95,0.548)" alignment="se" offset="(3,-3)" color="#0072B2"><m>\theta=\tfrac{\pi}{6}</m></label>
              <label at="sp-ray2" anchor="(-0.75,-0.433)" alignment="se" offset="(2,-3)" color="#0072B2"><m>\theta=\tfrac{7\pi}{6}</m></label>
              <label at="sp-eq" anchor="(0.45,-1.2)" alignment="c" color="#0072B2"><m>x=\sqrt3\,y</m></label>
              </coordinates>
              <annotations>
              <annotation ref="figure" text="The line x equals root three y in the xy-plane, the trace of the vertical plane.">
                <annotation ref="sp-line" text="The line through the origin at angle pi over six to the x axis." sonify="yes"/>
                <annotation ref="sp-arc1" text="The angle theta equals pi over six, from the positive x axis to the ray in the first quadrant."/>
                <annotation ref="sp-arc2" text="The angle theta equals seven pi over six, from the positive x axis around to the opposite ray."/>
              </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
      <p>
        (b) <m>z^2 = x^2 + y^2</m> becomes
        <m>\rho^2\cos^2\phi = \rho^2\sin^2\phi</m>, that is
        <m>\tan^2\phi = 1</m> with <m>0 \le \phi \le \pi</m>: the upper
        nappe <m>z = \sqrt{x^2+y^2}</m> is <m>\phi = \pi/4</m> and the
        lower nappe <m>z = -\sqrt{x^2+y^2}</m> is <m>\phi = 3\pi/4</m>
        (<xref ref="fig-hw6o-surfaces-cone"/>). (Geometrically: every point
        of the cone has <m>|z| = r</m>, so the line from the origin to it
        makes a <m>45^\circ</m> angle with the <m>z</m>-axis.)
      </p>
      <figure xml:id="fig-hw6o-surfaces-cone">
        <caption>
          The cone <m>z^2 = x^2 + y^2</m>: the upper nappe is <m>\phi = \pi/4</m> and the lower nappe is <m>\phi = 3\pi/4</m>, the angle being measured from the positive <m>z</m>-axis.
        </caption>
        <image width="55%">
          <shortdescription>
          A double cone with its vertex at the origin and the z axis as its axis, the upper nappe in blue and the lower in orange, with the angles pi over four and three pi over four marked from the positive z axis.
          </shortdescription>
          <description>
            <p>
            Coordinate axes x, y and z. A double cone has its vertex at the origin and opens along the z axis. The upper nappe, translucent blue, makes an angle of forty-five degrees with the positive z axis, marked by a small blue arc labelled phi equals pi over four along a generator in the xz-plane. The lower nappe, translucent orange, makes an angle of one hundred thirty-five degrees with the positive z axis, marked by a larger orange arc labelled phi equals three pi over four down to a generator on the opposite side.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \begin{axis}[
                          view={40}{18},
                          width=9.5cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-1.35, xmax=1.35, ymin=-1.35, ymax=1.35, zmin=-1.3, zmax=1.4,
                          clip=false,
                          unit vector ratio=1 1 1,
                        ]
                        \addplot3[surf, shader=faceted, faceted color=oiorange!30,
                                  colormap={lonappe}{color=(oiorange!12!white) color=(oiorange!45!white)},
                                  opacity=0.55, fill opacity=0.55,
                                  domain=0:1, samples=10, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({x*cos(y)}, {x*sin(y)}, {-x});
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={upnappe}{color=(oiblue!12!white) color=(oiblue!50!white)},
                                  opacity=0.55, fill opacity=0.55,
                                  domain=0:1, samples=10, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({x*cos(y)}, {x*sin(y)}, {x});
                        \draw[oiblue, line width=1.3pt] (axis cs:0,0,0) -- (axis cs:-1,0,1);
                        \draw[oiorange!85!black, line width=1.3pt] (axis cs:0,0,0) -- (axis cs:1,0,-1);
                        \addplot3[oiblue, line width=1.2pt, samples=30, samples y=0, domain=0:45, forget plot]
                          ({-0.5*sin(x)}, 0, {0.5*cos(x)});
                        \addplot3[oiorange!85!black, line width=1.2pt, samples=40, samples y=0, domain=0:135, forget plot]
                          ({0.42*sin(x)}, 0, {0.42*cos(x)});
                        \node[oiblue, font=\small, anchor=east] at (axis cs:-1.02,0,1.02) {$\phi=\tfrac{\pi}{4}$};
                        \node[oiorange!85!black, font=\small, anchor=west] at (axis cs:1.02,0,-1.02) {$\phi=\tfrac{3\pi}{4}$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
      <p>
        (c) Since <m>x^2 + y^2 = \rho^2\sin^2\phi</m> and
        <m>z^2 = \rho^2\cos^2\phi</m>, the ellipsoid becomes
      </p>
      <me>
        \rho^2\sin^2\phi + \frac{\rho^2\cos^2\phi}{4} = 1,
        \qquad\text{that is}\qquad
        \rho^2\,(4\sin^2\phi + \cos^2\phi) = 4 .
      </me>
      <p>
        With <m>\cos^2\phi = 1 - \sin^2\phi</m> this is
        <m>\rho^2 = \dfrac{4}{1 + 3\sin^2\phi}</m>, that is,
        <m>\rho = \dfrac{2}{\sqrt{1 + 3\sin^2\phi}}</m>: on the
        ellipsoid the distance from the origin depends on <m>\phi</m>
        alone. On the <m>z</m>-axis, <m>\phi = 0</m> gives
        <m>\rho = 2</m>; in the <m>xy</m>-plane, <m>\phi = \pi/2</m> gives
        <m>\rho = 1</m>; and at <m>\phi = \pi/4</m>,
        <m>\sin^2\phi = 1/2</m> gives
        <m>\rho = 2/\sqrt{5/2} = \sqrt{8/5} \approx 1.265</m>. The
        distance shrinks from <m>2</m> at the poles to <m>1</m> at the
        equator (<xref ref="fig-hw6o-surfaces-ellipsoid"/>).
      </p>
      <figure xml:id="fig-hw6o-surfaces-ellipsoid">
        <caption>
          The ellipsoid <m>x^2 + y^2 + z^2/4 = 1</m>. The distance <m>\rho</m> from the origin to the surface depends on <m>\phi</m> alone: <m>\rho = 2</m> along the <m>z</m>-axis, <m>\rho = 1</m> in the <m>xy</m>-plane, and <m>\rho = 2/\sqrt{1+3\sin^2\phi}</m> in between.
        </caption>
        <image width="40%">
          <shortdescription>
          A translucent ellipsoid, twice as tall as it is wide, with three segments from the origin to its surface labelled with their lengths.
          </shortdescription>
          <description>
            <p>
            Coordinate axes x, y and z. A translucent blue ellipsoid is centered at the origin, reaching height two on the z axis and radius one in the xy-plane. An orange segment from the origin up the z axis to the top of the ellipsoid is labelled rho equals two, and an orange segment along the x axis to the equator is labelled rho equals one. A green segment from the origin to a point of the surface at angle phi from the z axis is labelled rho equals two over the square root of one plus three sine squared phi, with a small green arc marking phi.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \definecolor{oigreen}{RGB}{0,158,115}
                      \begin{axis}[
                          view={40}{18},
                          width=9.5cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-1.7, xmax=1.7, ymin=-1.7, ymax=1.7, zmin=-2.2, zmax=2.45,
                          clip=false,
                          unit vector ratio=1 1 1,
                        ]
                        \addplot3[surf, shader=faceted, faceted color=oiblue!25,
                                  colormap={ellip}{color=(oiblue!10!white) color=(oiblue!50!white)},
                                  opacity=0.45, fill opacity=0.45,
                                  domain=0:180, samples=25, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({sin(x)*cos(y)}, {sin(x)*sin(y)}, {2*cos(x)});
                        \draw[oiorange, line width=1.4pt] (axis cs:0,0,0) -- (axis cs:0,0,2);
                        \node[font=\small, anchor=west] at (axis cs:0.04,0,1.45) {$\rho=2$};
                        \draw[oiorange, line width=1.4pt] (axis cs:0,0,0) -- (axis cs:1,0,0);
                        \node[font=\small, anchor=north east] at (axis cs:0.95,0,-0.12) {$\rho=1$};
                        \draw[oigreen, line width=1.4pt] (axis cs:0,0,0) -- (axis cs:-0.9608,0,0.5547);
                        \node[font=\small, anchor=east] at (axis cs:-1.0,0,0.62) {$\rho$};
                        \node[font=\small, anchor=north] at (axis cs:0,0,-2.3)
                          {$\rho=2/\sqrt{1+3\sin^2\phi}$};
                        \addplot3[oigreen, line width=1pt, samples=30, samples y=0, domain=0:60, forget plot]
                          ({-0.4*sin(x)}, 0, {0.4*cos(x)});
                        \node[oigreen!70!black, font=\small] at (axis cs:-0.2,0,0.64) {$\phi$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-cap">
    <title>A Cap Cut From a Ball</title>
    <statement>
      <p>
        Find the volume of the region bounded by the sphere
        <m>x^2 + y^2 + z^2 = 4</m> and the plane <m>z = 1</m> (the part of
        the ball that lies above the plane).
      </p>
      <p>
        In spherical coordinates the region is <m>0 \le \theta \le 2\pi</m>,
        <m>0 \le \phi \le </m><var width="6"/>, and <m>\rho</m> runs from a
        lower limit that depends on <m>\phi</m> (at <m>\phi = \pi/4</m>
        that limit equals <var width="6"/>) up to <var width="4"/>. The
        volume is <m>V = </m><var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1.0472" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="1.4142" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="5.236" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        The sphere is <m>\rho = 2</m>, and the plane <m>z = 1</m> is
        <m>\rho\cos\phi = 1</m>, that is <m>\rho = \sec\phi</m>. They meet
        where <m>2\cos\phi = 1</m>, so <m>\phi = \pi/3</m>; that is the
        circle <m>x^2 + y^2 = 3</m>, <m>z = 1</m>. A ray from the origin at
        angle <m>\phi \le \pi/3</m> enters the region through the plane at
        <m>\rho = \sec\phi</m> and leaves it through the sphere at
        <m>\rho = 2</m> (<xref ref="fig-hw6o-cap-3d"/> and
        <xref ref="fig-hw6o-cap-section"/>), so the region is
      </p>
      <me>
        0 \le \theta \le 2\pi,\qquad 0 \le \phi \le \frac{\pi}{3},\qquad
        \sec\phi \le \rho \le 2 .
      </me>
      <p>
        At <m>\phi = \pi/4</m> the lower limit is
        <m>\sec(\pi/4) = \sqrt2 \approx 1.414</m>.
      </p>
      <figure xml:id="fig-hw6o-cap-3d">
        <caption>
          The cap of <xref ref="ex-hw6o-cap"/>: the part of the ball <m>\rho \le 2</m> above the plane <m>z = 1</m>. The plane meets the sphere along the circle <m>x^2 + y^2 = 3</m>, <m>z = 1</m>, where <m>\phi = \pi/3</m>.
        </caption>
        <image width="55%">
          <shortdescription>
          A spherical cap, in blue, sitting on an orange disk at height one; the rest of the sphere is a dashed outline, and a green ray from the origin to the rim marks the angle pi over three.
          </shortdescription>
          <description>
            <p>
            Coordinate axes x, y and z. A dashed circle in the xz-plane outlines the sphere of radius two. The cap of the sphere above height one is drawn as a translucent blue surface, resting on a translucent orange disk of radius root three in the plane z equals one. A green segment from the origin to a point on the rim of the cap makes an angle with the positive z axis marked by a green arc and labelled phi equals pi over three.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \definecolor{oigreen}{RGB}{0,158,115}
                      \begin{axis}[
                          view={40}{20},
                          width=10cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-2.4, xmax=2.4, ymin=-2.4, ymax=3.3, zmin=-2.2, zmax=2.5,
                          clip=false,
                          unit vector ratio=1 1 1,
                        ]
                        \addplot3[black!45, dashed, line width=0.9pt, samples=90, samples y=0, domain=0:360, forget plot]
                          ({2*sin(x)}, 0, {2*cos(x)});
                        \addplot3[surf, shader=flat, color=oiorange!25, opacity=0.55, fill opacity=0.55,
                                  domain=0:1.7321, samples=12, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({x*cos(y)}, {x*sin(y)}, 1);
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={capz}{color=(oiblue!15!white) color=(oiblue!55!white)},
                                  opacity=0.65, fill opacity=0.65,
                                  domain=0:60, samples=16, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({2*sin(x)*cos(y)}, {2*sin(x)*sin(y)}, {2*cos(x)});
                        \addplot3[oiblue, line width=1.4pt, samples=90, samples y=0, domain=0:360, forget plot]
                          ({1.7321*cos(x)}, {1.7321*sin(x)}, 1);
                        \draw[oigreen, line width=1.4pt] (axis cs:0,0,0) -- (axis cs:-1.7321,0,1);
                        \addplot3[oigreen, line width=1pt, samples=30, samples y=0, domain=0:60, forget plot]
                          ({-0.55*sin(x)}, 0, {0.55*cos(x)});
                        \node[oigreen!70!black, font=\small, anchor=east, fill=white, inner sep=1.5pt] at (axis cs:-1.2,0,0.55) {$\phi=\tfrac{\pi}{3}$};
                        \node[oiorange!80!black, font=\small, anchor=west] at (axis cs:1.8,0,1.0) {$z=1$};
                        \node[oiblue, font=\small, anchor=south west] at (axis cs:1.05,0,1.75) {$\rho=2$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
      <figure xml:id="fig-hw6o-cap-section">
        <caption>
          The cross-section of the cap of <xref ref="ex-hw6o-cap"/> by the <m>xz</m>-plane. The shaded region lies between the line <m>z = 1</m>, which is <m>\rho = \sec\phi</m>, and the circle <m>\rho = 2</m>; the two meet at <m>\phi = \pi/3</m>. Along a ray at angle <m>\phi</m>, <m>\rho</m> runs from <m>\sec\phi</m> to <m>2</m>.
        </caption>
        <image width="55%">
          <shortdescription>
          A circle of radius two centered at the origin, cut by the horizontal line z equals one; the segment of the disk above the line is shaded, with a ray at angle pi over three to its corner and a sample ray at a smaller angle.
          </shortdescription>
          <description>
            <p>
            Axes x and z. A blue circle of radius two is centered at the origin and a blue horizontal line crosses it at height one. The part of the disk above the line is shaded tan. A green ray from the origin to the right-hand corner of the shaded region, the point root three comma one, makes the angle pi over three with the positive z axis, marked by a green arc. A second green segment at a smaller angle phi starts on the line z equals one, where rho equals secant phi, and ends on the circle, where rho equals two.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw6o-cap-section">
            <diagram dimensions="(340,330)" margins="10">
              <definition>plane(x) = 1</definition>
              <definition>sphere(x) = sqrt(4 - x^2)</definition>
              <definition>circ(t) = (2*cos(t), 2*sin(t))</definition>
              <coordinates bbox="(-2.55,-2.45,2.55,2.5)">
              <area-between-curves at="cap-region" function1="plane" function2="sphere" domain="(-1.7320508,1.7320508)" fill="#fbe3d0" stroke="none"/>
              <axes at="cap-axes" xlabel="x" ylabel="z" decorations="no" arrows="1"/>
              <parametric-curve at="cap-circle" function="circ" domain="(0,2*pi)" stroke="#0072B2" thickness="3"/>
              <line at="cap-plane" endpoints="((-2.4,1),(2.4,1))" stroke="#0072B2" thickness="3"/>
              <line at="cap-ray" endpoints="((0,0),(1.7320508,1))" stroke="#009E73" thickness="2.5"/>
              <arc at="cap-angle" center="(0,0)" radius="0.5" range="(30,90)" stroke="#009E73" thickness="2"/>
              <line at="cap-sample" endpoints="((-0.7002,1),(-1.1472,1.6383))" stroke="#009E73" thickness="2.5"/>
              <line at="cap-sample-in" endpoints="((0,0),(-0.7002,1))" stroke="#009E73" thickness="1" dash="4 3"/>
              <arc at="cap-sample-angle" center="(0,0)" radius="0.3" range="(90,125)" stroke="#009E73" thickness="1.5"/>
              <point at="cap-corner" p="(1.7320508,1)" fill="black" size="3.5"/>
              <point at="cap-corner2" p="(-1.7320508,1)" fill="black" size="3.5"/>
              <point at="cap-s1" p="(-0.7002,1)" fill="#009E73" size="3"/>
              <point at="cap-s2" p="(-1.1472,1.6383)" fill="#009E73" size="3"/>
              <label at="cap-philab" anchor="(0.33,0.56)" alignment="ne" color="#009E73"><m>\tfrac{\pi}{3}</m></label>
              <label at="cap-cornerlab" anchor="(1.7320508,1)" alignment="se" offset="(4,-4)"><m>(\sqrt3,1)</m></label>
              <label at="cap-planelab" anchor="(-2.35,1)" alignment="ne" offset="(0,3)" color="#0072B2"><m>z=1</m></label>
              <label at="cap-rholab" anchor="(1.55,1.35)" alignment="ne" color="#0072B2"><m>\rho=2</m></label>
              <label at="cap-seclab" anchor="(-0.7002,1)" alignment="sw" offset="(-3,-4)" color="#009E73"><m>\rho=\sec\phi</m></label>
              <label at="cap-twolab" anchor="(-1.1472,1.6383)" alignment="nw" offset="(-3,3)" color="#009E73"><m>\rho=2</m></label>
              <label at="cap-samplephi" anchor="(-0.16,0.36)" alignment="nw" color="#009E73"><m>\phi</m></label>
              </coordinates>
              <annotations>
              <annotation ref="figure" text="The cross-section of the cap by the xz-plane: the part of the disk of radius two above the line z equals one.">
                <annotation ref="cap-region" text="The shaded cross-section of the cap."/>
                <annotation ref="cap-circle" text="The circle rho equals two." sonify="yes"/>
                <annotation ref="cap-plane" text="The line z equals one, which is rho equals secant phi."/>
                <annotation ref="cap-ray" text="The ray at angle pi over three from the z axis, through the corner of the region at root three comma one."/>
                <annotation ref="cap-sample" text="A sample ray at a smaller angle phi, inside the region from rho equals secant phi to rho equals two."/>
              </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
      <p>
        With <m>dV = \rho^2\sin\phi\,d\rho\,d\phi\,d\theta</m> by
        <xref ref="eq-dv-spherical"/>,
      </p>
      <md>
        <mrow>
          V \amp = \int_0^{2\pi}\!\!\int_0^{\pi/3}\!\!\int_{\sec\phi}^{2}
          \rho^2\sin\phi\,d\rho\,d\phi\,d\theta
          = 2\pi\int_0^{\pi/3} \frac{8 - \sec^3\phi}{3}\,\sin\phi\,d\phi
        </mrow>
        <mrow>
          \amp = \frac{2\pi}{3}\left[-8\cos\phi - \frac{1}{2\cos^2\phi}\right]_0^{\pi/3}
          = \frac{2\pi}{3}\left[(-4 - 2) - \left(-8 - \tfrac12\right)\right]
        </mrow>
        <mrow>
          \amp = \frac{2\pi}{3}\cdot\frac{5}{2} = \frac{5\pi}{3} \approx 5.236 ,
        </mrow>
      </md>
      <p>
        where <m>\int \sec^3\phi\,\sin\phi\,d\phi = \int \cos^{-3}\phi\,\sin\phi\,d\phi
        = \dfrac{1}{2\cos^2\phi}</m>. (Check: a cap of height <m>h</m> on a
        ball of radius <m>R</m> has volume <m>\pi h^2(3R - h)/3</m>; with
        <m>R = 2</m>, <m>h = 1</m> this is <m>5\pi/3</m>.)
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-cone-sphere">
    <title>An Integral Over an Ice-Cream Cone</title>
    <statement>
      <p>
        Let <m>R</m> be the region above the cone <m>z = \sqrt{x^2 + y^2}</m>
        and below the unit sphere <m>x^2 + y^2 + z^2 = 1</m>. Compute
      </p>
      <me>
        \iiint_R z^2\,dV .
      </me>
      <p>
        In spherical coordinates <m>R</m> is <m>0 \le \theta \le 2\pi</m>,
        <m>0 \le \phi \le </m><var width="6"/>,
        <m>0 \le \rho \le </m><var width="4"/>, and the integral equals
        <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.7854" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.2708" tolerance="0.002">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw6-solutions">
      <p>
        The cone <m>z = \sqrt{x^2+y^2}</m> is <m>\phi = \pi/4</m> and the
        sphere is <m>\rho = 1</m>, so <m>R</m> is the ice-cream cone
      </p>
      <me>
        0 \le \theta \le 2\pi,\qquad 0 \le \phi \le \frac{\pi}{4},\qquad
        0 \le \rho \le 1
      </me>
      <p>
        of <xref ref="fig-hw6o-cone-sphere-3d"/> and
        <xref ref="fig-hw6o-cone-sphere-section"/>.
      </p>
      <figure xml:id="fig-hw6o-cone-sphere-3d">
        <caption>
          The region <m>R</m> of <xref ref="ex-hw6o-cone-sphere"/>: inside the cone <m>\phi = \pi/4</m> and inside the unit sphere <m>\rho = 1</m>. The cone and the sphere meet along the circle at height <m>z = 1/\sqrt2</m>.
        </caption>
        <image width="55%">
          <shortdescription>
          An ice-cream cone shape: an orange cone with its vertex at the origin opening upward, capped by a blue piece of the unit sphere, with a green ray marking the angle pi over four.
          </shortdescription>
          <description>
            <p>
            Coordinate axes x, y and z. A translucent orange cone has its vertex at the origin and opens upward at forty-five degrees from the z axis. It is capped by a translucent blue piece of the unit sphere, and the two meet along a circle at height one over root two. A dashed circle in the xz-plane outlines the unit sphere. A green segment from the origin along the cone to the rim makes an angle with the z axis marked by a green arc and labelled phi equals pi over four.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \definecolor{oigreen}{RGB}{0,158,115}
                      \begin{axis}[
                          view={40}{20},
                          width=9.5cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-1.2, xmax=1.2, ymin=-1.2, ymax=1.7, zmin=-1.1, zmax=1.3,
                          clip=false,
                          unit vector ratio=1 1 1,
                        ]
                        \addplot3[black!45, dashed, line width=0.9pt, samples=90, samples y=0, domain=0:360, forget plot]
                          ({sin(x)}, 0, {cos(x)});
                        \addplot3[surf, shader=faceted, faceted color=oiorange!30,
                                  colormap={conez}{color=(oiorange!12!white) color=(oiorange!45!white)},
                                  opacity=0.6, fill opacity=0.6,
                                  domain=0:1, samples=10, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({0.7071*x*cos(y)}, {0.7071*x*sin(y)}, {0.7071*x});
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={capone}{color=(oiblue!15!white) color=(oiblue!55!white)},
                                  opacity=0.65, fill opacity=0.65,
                                  domain=0:45, samples=12, y domain=0:360, samples y=40,
                                  z buffer=sort, forget plot]
                          ({sin(x)*cos(y)}, {sin(x)*sin(y)}, {cos(x)});
                        \addplot3[oiblue, line width=1.4pt, samples=90, samples y=0, domain=0:360, forget plot]
                          ({0.7071*cos(x)}, {0.7071*sin(x)}, 0.7071);
                        \draw[oigreen, line width=1.4pt] (axis cs:0,0,0) -- (axis cs:-0.7071,0,0.7071);
                        \addplot3[oigreen, line width=1pt, samples=30, samples y=0, domain=0:45, forget plot]
                          ({-0.4*sin(x)}, 0, {0.4*cos(x)});
                        \node[oigreen!70!black, font=\small, anchor=east, fill=white, inner sep=1.5pt] at (axis cs:-0.55,0,0.2) {$\phi=\tfrac{\pi}{4}$};
                        \node[oiblue, font=\small, anchor=south west] at (axis cs:0.45,0,0.92) {$\rho=1$};
                        \node[oiorange!80!black, font=\small, anchor=north west, fill=white, inner sep=1.5pt] at (axis cs:0.45,0,-0.3) {$z=\sqrt{x^2+y^2}$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
      <figure xml:id="fig-hw6o-cone-sphere-section">
        <caption>
          The cross-section of <m>R</m> by the <m>xz</m>-plane: the sector of the unit disk between the rays <m>\phi = \pi/4</m> on either side of the <m>z</m>-axis. Along every ray from the origin, <m>\rho</m> runs from <m>0</m> to <m>1</m>.
        </caption>
        <image width="45%">
          <shortdescription>
          A shaded sector of the unit disk, opening upward from the origin at forty-five degrees on each side of the z axis and bounded above by the unit circle.
          </shortdescription>
          <description>
            <p>
            Axes x and z. Two blue rays from the origin, the lines z equals plus or minus x, open upward at forty-five degrees from the z axis, and the upper half of the blue unit circle arches over them. The sector between the rays and under the circle is shaded tan. A green arc near the origin marks the angle pi over four from the positive z axis to the right-hand ray.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw6o-cone-sphere-section">
            <diagram dimensions="(340,175)" margins="10">
              <definition>cone(x) = sqrt(x^2)</definition>
              <definition>sphere(x) = sqrt(1 - x^2)</definition>
              <definition>circ(t) = (cos(t), sin(t))</definition>
              <coordinates bbox="(-1.7,-0.4,1.7,1.35)">
              <area-between-curves at="cs-region" function1="cone" function2="sphere" domain="(-0.70710678,0.70710678)" fill="#fbe3d0" stroke="none"/>
              <axes at="cs-axes" xlabel="x" ylabel="z" decorations="no" arrows="1"/>
              <parametric-curve at="cs-circle" function="circ" domain="(0,pi)" stroke="#0072B2" thickness="3"/>
              <line at="cs-ray-right" endpoints="((0,0),(1.25,1.25))" stroke="#0072B2" thickness="3"/>
              <line at="cs-ray-left" endpoints="((0,0),(-1.25,1.25))" stroke="#0072B2" thickness="3"/>
              <arc at="cs-angle" center="(0,0)" radius="0.35" range="(45,90)" stroke="#009E73" thickness="2"/>
              <point at="cs-x1" p="(1,0)" fill="black" size="3"/>
              <point at="cs-x2" p="(-1,0)" fill="black" size="3"/>
              <label at="cs-x1lab" anchor="(1,0)" alignment="s" offset="(0,-4)"><m>1</m></label>
              <label at="cs-x2lab" anchor="(-1,0)" alignment="s" offset="(0,-4)"><m>-1</m></label>
              <point at="cs-c1" p="(0.70710678,0.70710678)" fill="black" size="3.5"/>
              <point at="cs-c2" p="(-0.70710678,0.70710678)" fill="black" size="3.5"/>
              <label at="cs-philab" anchor="(0.2,0.42)" alignment="ne" color="#009E73"><m>\tfrac{\pi}{4}</m></label>
              <label at="cs-raylab" anchor="(1.05,1.05)" alignment="se" offset="(4,-2)" color="#0072B2"><m>\phi=\tfrac{\pi}{4}</m></label>
              <label at="cs-rholab" anchor="(0.25,0.97)" alignment="ne" color="#0072B2"><m>\rho=1</m></label>
              <label at="cs-cornerlab" anchor="(0.70710678,0.70710678)" alignment="se" offset="(4,-4)"><m>\bigl(\tfrac{1}{\sqrt2},\tfrac{1}{\sqrt2}\bigr)</m></label>
              </coordinates>
              <annotations>
              <annotation ref="figure" text="The cross-section of the ice-cream cone by the xz-plane: a sector of the unit disk opening upward.">
                <annotation ref="cs-region" text="The shaded sector."/>
                <annotation ref="cs-circle" text="The unit circle rho equals one." sonify="yes"/>
                <annotation ref="cs-ray-right" text="The ray phi equals pi over four, the right edge of the cone."/>
                <annotation ref="cs-ray-left" text="The left edge of the cone, also at angle pi over four from the z axis."/>
              </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
      <p>
        With <m>z = \rho\cos\phi</m> and
        <m>dV = \rho^2\sin\phi\,d\rho\,d\phi\,d\theta</m>,
      </p>
      <md>
        <mrow>
          \iiint_R z^2\,dV
          \amp = \int_0^{2\pi}\!\!\int_0^{\pi/4}\!\!\int_0^{1}
          \rho^2\cos^2\phi\cdot\rho^2\sin\phi\,d\rho\,d\phi\,d\theta
        </mrow>
        <mrow>
          \amp = 2\pi\left(\int_0^1 \rho^4\,d\rho\right)
          \left(\int_0^{\pi/4}\cos^2\phi\,\sin\phi\,d\phi\right)
          = 2\pi\cdot\frac15\cdot\left[-\frac{\cos^3\phi}{3}\right]_0^{\pi/4}
        </mrow>
        <mrow>
          \amp = \frac{2\pi}{15}\left(1 - \frac{\sqrt2}{4}\right)
          = \frac{\pi\,(4 - \sqrt2)}{30} \approx 0.271 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw6o-wedge">
    <title>A Wedge Cut From a Cylinder</title>
    <setup>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="2" max="9" by="1"/>
      </de-object>
      <de-object name="R2" context="number">
        <de-expression reduce="yes">R^2</de-expression>
      </de-object>
      <de-object name="V" context="number">
        <de-expression>2*R^3/3</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        Find the volume of the wedge-shaped region <m>\mathcal{W}</m>
        contained in the cylinder <m>x^2 + y^2 = <eval obj="R2"/></m>,
        bounded above by the plane <m>z = x</m> and below by the
        <m>xy</m>-plane.
      </p>
      <p>
        <m>V = </m> <fillin mode="number" ansobj="V" width="10"/>
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <!-- The feedback here nudges, it does not solve: the dynamic runtime
             shows it to anyone who presses Check Me.  The worked solution is
             switched on and off through publication.ptx like the others. -->
        <test correct="yes">
          <numcmp use-answer="yes" min="V.value({})-Math.max(0.01,1e-4*Math.abs(V.value({})))" max="V.value({})+Math.max(0.01,1e-4*Math.abs(V.value({})))"/>
          <feedback>
          <p>Correct.</p>
        </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </test>
      </evaluate>
    </evaluation>
    <solution component="hw6-solutions">
      <p>
        Write <m>R</m> for the radius of the cylinder; the wedge is shown in
        <xref ref="fig-hw6o-wedge"/>.
      </p>
      <figure xml:id="fig-hw6o-wedge">
        <caption>
          The wedge of <xref ref="ex-hw6o-wedge"/>: inside the cylinder of radius
          <m>R</m>, above the <m>xy</m>-plane and below the plane <m>z = x</m>.
        </caption>
        <image xml:id="image-hw6o-wedge" width="60%">
          <shortdescription>
            A wedge standing on a half disk in the xy-plane: its curved side is part of
            a cylinder and its sloping top is the plane z equals x.
          </shortdescription>
          <description>
            <p>
              A solid wedge. Its base is the half of the disk of radius R centered at
              the origin that lies on the side x greater than or equal to zero, shaded
              orange and labelled D. Its curved side is the piece of the cylinder over the
              semicircle, drawn in translucent blue, and its top is the sloping plane z
              equals x, which meets the base along the diameter on the y axis and rises
              to height R at the point (R,0,R) on the x axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \begin{axis}[
                          view={40}{22},
                          width=11cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-0.4, xmax=1.55, ymin=-1.4, ymax=1.4, zmin=0, zmax=1.35,
                          clip=false,
                        ]
                        % ---- base: the half disk D in the xy-plane ----
                        \addplot3[surf, shader=flat, color=oiorange!25, opacity=0.5, fill opacity=0.5,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=2,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, 0);
                        % ---- curved cylinder wall x^2+y^2=R^2, from z=0 up to z=x ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!25,
                                  colormap={wallz}{color=(oiblue!10!white) color=(oiblue!45!white)},
                                  opacity=0.55, fill opacity=0.55,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({cos(x)}, {sin(x)}, {y*cos(x)});
                        % ---- top: the plane z = x over D ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={topz}{color=(oiblue!18!white) color=(oiblue!55!white)},
                                  opacity=0.7, fill opacity=0.7,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, {y*cos(x)});
                        % ---- edges ----
                        \addplot3[black!65, dashed, line width=1.1pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, 0);
                        \addplot3[oiblue, line width=1.6pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, {cos(x)});
                        \draw[oiblue, line width=1.2pt] (axis cs:0,-1,0) -- (axis cs:0,1,0);
                        \draw[oiblue, line width=1.2pt] (axis cs:1,0,0) -- (axis cs:1,0,1);
                        % ---- labels ----
                        \node[anchor=north, font=\small] at (axis cs:1,0,-0.05) {$R$};
                        \node[anchor=south west, font=\small] at (axis cs:1,0,1) {$(R,0,R)$};
                        \node[oiblue, font=\large, anchor=south west]
                          at (axis description cs:0.02,0.86) {$z = x$};
                        \node[oiorange!80!black, font=\small] at (axis cs:0.5,-0.45,0) {$\mathcal{D}$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
      <p>
        The wedge is bounded
        below by <m>z = 0</m> and above by <m>z = x</m>, so <m>0 \le z \le x</m>;
        in particular <m>x \ge 0</m>, and the wedge projects onto the half
        disk <m>\mathcal{D}</m> of radius <m>R</m> with <m>x \ge 0</m>
        (<xref ref="fig-hw6o-wedge-D"/>). In polar coordinates
      </p>
      <me>
        \mathcal{D}:\ -\frac{\pi}{2} \le \theta \le \frac{\pi}{2},\ 0 \le r \le R ,
      </me>
      <p>
        and the top surface is <m>z = x = r\cos\theta</m>. So in
        cylindrical coordinates
      </p>
      <me>
        \mathcal{W}:\ -\frac{\pi}{2} \le \theta \le \frac{\pi}{2},\
        0 \le r \le R,\ 0 \le z \le r\cos\theta .
      </me>
      <figure xml:id="fig-hw6o-wedge-D">
        <caption>
          The projection <m>\mathcal{D}</m> of the wedge of <xref ref="ex-hw6o-wedge"/> onto the <m>xy</m>-plane: the half of the disk of radius <m>R</m> with <m>x \ge 0</m>, described in polar coordinates by <m>-\pi/2 \le \theta \le \pi/2</m>, <m>0 \le r \le R</m>. Above a point of <m>\mathcal{D}</m> the wedge runs from <m>z = 0</m> up to <m>z = x = r\cos\theta</m>.
        </caption>
        <image width="45%">
          <shortdescription>
          A shaded half disk to the right of the y axis, with a ray from the origin at angle theta ending on the semicircle.
          </shortdescription>
          <description>
            <p>
            Coordinate axes with the right half of the disk of radius R shaded tan and labelled D. Its straight edge is the segment of the y axis from theta equals minus pi over two to theta equals pi over two, and its curved edge is the semicircle r equals R. A green ray from the origin at an angle theta marks a sample radius r.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw6o-wedge-D">
            <diagram dimensions="(260,320)" margins="10">
              <definition>semi(t) = (cos(t), sin(t))</definition>
              <coordinates bbox="(-0.6,-1.35,1.6,1.35)">
              <axes at="hw6o-wedge-D-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
              <polygon at="hw6o-wedge-D-region" fill="#fbe3d0" stroke="none" closed="yes" points="((6.123e-17,-1),(0.05234,-0.9986),(0.1045,-0.9945),(0.1564,-0.9877),(0.2079,-0.9781),(0.2588,-0.9659),(0.309,-0.9511),(0.3584,-0.9336),(0.4067,-0.9135),(0.454,-0.891),(0.5,-0.866),(0.5446,-0.8387),(0.5878,-0.809),(0.6293,-0.7771),(0.6691,-0.7431),(0.7071,-0.7071),(0.7431,-0.6691),(0.7771,-0.6293),(0.809,-0.5878),(0.8387,-0.5446),(0.866,-0.5),(0.891,-0.454),(0.9135,-0.4067),(0.9336,-0.3584),(0.9511,-0.309),(0.9659,-0.2588),(0.9781,-0.2079),(0.9877,-0.1564),(0.9945,-0.1045),(0.9986,-0.05234),(1,-2.22e-16),(0.9986,0.05234),(0.9945,0.1045),(0.9877,0.1564),(0.9781,0.2079),(0.9659,0.2588),(0.9511,0.309),(0.9336,0.3584),(0.9135,0.4067),(0.891,0.454),(0.866,0.5),(0.8387,0.5446),(0.809,0.5878),(0.7771,0.6293),(0.7431,0.6691),(0.7071,0.7071),(0.6691,0.7431),(0.6293,0.7771),(0.5878,0.809),(0.5446,0.8387),(0.5,0.866),(0.454,0.891),(0.4067,0.9135),(0.3584,0.9336),(0.309,0.9511),(0.2588,0.9659),(0.2079,0.9781),(0.1564,0.9877),(0.1045,0.9945),(0.05234,0.9986),(5.053e-16,1))"/>
              <parametric-curve at="hw6o-wedge-D-arc" function="semi" domain="(-pi/2,pi/2)" stroke="#0072B2" thickness="3"/>
              <line at="hw6o-wedge-D-diam" endpoints="((0,-1),(0,1))" stroke="#0072B2" thickness="3"/>
              <line at="hw6o-wedge-D-ray" endpoints="((0,0),(0.8776,0.4794))" stroke="#009E73" thickness="2"/>
              <arc at="hw6o-wedge-D-angle" center="(0,0)" radius="0.3" range="(0,28.6)" stroke="#009E73" thickness="2"/>
              <point at="hw6o-wedge-D-top" p="(0,1)" fill="black" size="3.5"/>
              <point at="hw6o-wedge-D-bot" p="(0,-1)" fill="black" size="3.5"/>
              <point at="hw6o-wedge-D-end" p="(0.8776,0.4794)" fill="#009E73" size="3.5"/>
              <label at="hw6o-wedge-D-toplab" anchor="(0,1)" alignment="nw" offset="(-3,4)"><m>\theta=\tfrac{\pi}{2}</m></label>
              <label at="hw6o-wedge-D-botlab" anchor="(0,-1)" alignment="sw" offset="(-3,-4)"><m>\theta=-\tfrac{\pi}{2}</m></label>
              <label at="hw6o-wedge-D-rlab" anchor="(0.55,0.08)" alignment="se" color="#009E73"><m>r</m></label>
              <label at="hw6o-wedge-D-tlab" anchor="(0.34,0.06)" alignment="ne" color="#009E73"><m>\theta</m></label>
              <label at="hw6o-wedge-D-Rlab" anchor="(1,0)" alignment="se" offset="(4,-4)" color="#0072B2"><m>r=R</m></label>
              <label at="hw6o-wedge-D-Dlab" anchor="(0.45,-0.5)" alignment="c"><m>\mathcal{D}</m></label>
              </coordinates>
              <annotations>
              <annotation ref="figure" text="The half disk D of radius R on the side x greater than or equal to zero, the shadow of the wedge.">
                <annotation ref="hw6o-wedge-D-region" text="The shaded half disk D."/>
                <annotation ref="hw6o-wedge-D-arc" text="The semicircle r equals R, from theta equals minus pi over two to pi over two." sonify="yes"/>
                <annotation ref="hw6o-wedge-D-diam" text="The straight edge of D along the y axis, where the top plane z equals x meets the base."/>
                <annotation ref="hw6o-wedge-D-ray" text="A sample ray at angle theta, with r running from zero to R."/>
              </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
      <p>
        The volume is <m>\iiint_{\mathcal{W}} 1\,dV</m>, and with
        <m>dV = r\,dz\,dr\,d\theta</m> by <xref ref="eq-dv-cylindrical"/>,
      </p>
      <md>
        <mrow>
          V \amp = \int_{-\pi/2}^{\pi/2}\!\!\int_0^{R}\!\!\int_0^{r\cos\theta}
          r\,dz\,dr\,d\theta
          = \int_{-\pi/2}^{\pi/2}\!\!\int_0^{R} r^2\cos\theta\,dr\,d\theta
        </mrow>
        <mrow>
          \amp = \frac{R^3}{3}\int_{-\pi/2}^{\pi/2} \cos\theta\,d\theta
          = \frac{R^3}{3}\Big[\sin\theta\Big]_{-\pi/2}^{\pi/2}
          = \frac{2R^3}{3} .
        </mrow>
      </md>
      <p>
        For instance, a cylinder of radius <m>3</m> gives
        <m>V = 2\cdot 27/3 = 18</m>.
      </p>
    </solution>
  </exercise>
  </exercises>
</section>
