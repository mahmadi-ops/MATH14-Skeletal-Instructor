<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - Review Problems #3, the version WITH solutions.               -->
<!--                                                                        -->
<!-- Each problem is a <problem> (an EXAMPLE-LIKE block) whose <solution>    -->
<!-- is printed immediately below it: no answer boxes, no "Check me" and no  -->
<!-- "Randomize".  The randomised parameters of the practice version have    -->
<!-- been fixed at values chosen to keep every answer clean.  The auto-      -->
<!-- graded version of the same eighteen problems is review3-practice.ptx.    -->
<!--                                                                        -->
<!-- HIDING THE SOLUTIONS.  Every <solution> here carries                    -->
<!--   component="review3-solutions"                                        -->
<!-- so the whole set can be switched off from publication/publication.ptx   -->
<!-- without touching this file; see the comment in <source> there.          -->
<section xml:id="sec-exercises-review3-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Review Problems #3</title>

  <p>
    Sections: <xref ref="section-mass-center-of-mass" text="title"/>, <xref ref="section-jacobian-substitution" text="title"/>,
    <xref ref="section-surface-integrals" text="title"/>, and
    <xref ref="section-greens-theorem" text="title"/>.
  </p>

  <p>
    Work each problem yourself first; the full solution follows immediately
    below it. The same eighteen problems, with the numbers randomised and
    every answer checked automatically, are in
    <xref ref="sec-exercises-review3-practice" text="title"/>.
  </p>

  <problem xml:id="ex-r3o-area-change-of-variables">
    <title>Area by a Non-Linear Change of Variables</title>
    <statement>
      <p>
      Compute the area of the region <m>D</m> in the first quadrant of the
      <m>xy</m>-plane bounded by
      </p>
      <me>
      xy = 1, \qquad xy = 9, \qquad xy^2 = 1, \qquad xy^2 = 36 .
      </me>
      <p>
      Sketch <m>D</m>, then use the non-linear change of variables
      <m>u = xy</m>, <m>v = xy^2</m>: find <m>x</m> and <m>y</m> as functions
      of <m>u</m> and <m>v</m>, compute the Jacobian determinant, set up the
      double integral for the area, and evaluate it.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Dividing <m>v = xy^2</m> by <m>u = xy</m> gives <m>y = v/u</m>, and
        then <m>x = u/y = u^2/v</m>. The Jacobian matrix has entries
        <m>x_u = 2u/v</m>, <m>x_v = -u^2/v^2</m>, <m>y_u = -v/u^2</m>,
        <m>y_v = 1/u</m>, so
      </p>
      <me>
        \frac{\partial(x,y)}{\partial(u,v)}
        = \frac{2u}{v}\cdot\frac{1}{u}
        - \left(-\frac{u^2}{v^2}\right)\left(-\frac{v}{u^2}\right)
        = \frac{2}{v} - \frac{1}{v} = \frac{1}{v}.
      </me>
      <p>
        The four bounding curves are exactly <m>u = 1</m>,
        <m>u = 9</m>, <m>v = 1</m>, <m>v = 36</m>,
        so <m>D</m> becomes a rectangle and
      </p>
      <me>
        \text{Area}
        = \int_1^{36}\!\!\int_1^{9}
          \frac{1}{v}\,du\,dv
        = \left(9 - 1\right)
          \ln\!\left(36\right).
      </me>
      <p>
        Here the four curves are <m>u = 1</m>, <m>u = 9</m>, <m>v = 1</m> and
<m>v = 36</m>, so the area is
<m>(9-1)\ln 36 = 8\ln 36 \approx 28.67</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-shear-ellipse-area">
    <title>Area of a Tilted Ellipse by a Shear</title>
    <statement>
      <p>
      Use the change of variables <m>s = x + 3y</m>, <m>t = y</m> to find the
      area of the region bounded by
      </p>
      <me>
      x^2 + 6xy + 10y^2 = 1 .
      </me>
      <p>
      Invert the change of variables, find the Jacobian determinant, and then
      the area.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Inverting the shear gives <m>x = s - 3t</m>,
        <m>y = t</m>, so the Jacobian matrix is
        <m>\begin{pmatrix} 1 &amp; -3 \\ 0 &amp; 1
        \end{pmatrix}</m> with determinant <m>1</m>, and
        <m>dx\,dy = ds\,dt</m>. Completing the substitution,
      </p>
      <me>
        x^2 + 6xy + 10y^2
        = \left(s - 3t\right)^2
        + 6\left(s - 3t\right)t
        + 10t^2
        = s^2 + t^2 ,
      </me>
      <p>
        so the region is the unit disc <m>T</m> and
        <m>\iint_R dx\,dy = \iint_T ds\,dt = \text{Area}(T) = \pi</m>.
      </p>
      <p>
        Here <m>a = 3</m>, and the area is <m>\pi</m> whatever the value of
<m>a</m>: the shear does not change area.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-parabolic-strip">
    <title>A Double Integral Under a Parabolic Change of Variables</title>
    <statement>
      <p>
      Use the change of variables <m>s = y</m>, <m>t = y - x^2</m> to evaluate
      </p>
      <me>
      \iint_R x\,dx\,dy
      </me>
      <p>
      over the region <m>R</m> in the first quadrant bounded by <m>y = 0</m>,
      <m>y = 9</m>, <m>y = x^2</m>, and <m>y = x^2 - 4</m>. (Take the positive
      square root when inverting, since <m>R</m> lies in the first quadrant.)
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Inverting gives <m>x = \sqrt{s-t}</m> and <m>y = s</m>, so
      </p>
      <me>
        \frac{\partial(x,y)}{\partial(s,t)}
        = \begin{vmatrix}
          \frac{1}{2\sqrt{s-t}} &amp; -\frac{1}{2\sqrt{s-t}} \\
          1 &amp; 0
          \end{vmatrix}
        = \frac{1}{2\sqrt{s-t}} .
      </me>
      <p>
        The boundaries <m>y = x^2</m> and <m>y = x^2 - 4</m>
        become <m>t = 0</m> and <m>t = -4</m>, while
        <m>y = 0</m> and <m>y = 9</m> become <m>s = 0</m>
        and <m>s = 9</m>. The integrand times the Jacobian
        collapses to <m>\sqrt{s-t}\cdot\frac{1}{2\sqrt{s-t}}
        = \frac{1}{2}</m>, so
      </p>
      <me>
        \iint_R x\,dx\,dy
        = \iint_T \frac{1}{2}\,ds\,dt
        = \frac{1}{2}\,\text{Area}(T)
        = \frac{\left(4\right)\left(9\right)}{2}
        = 18 .
      </me>
      <p>
        Here <m>a = 4</m> and <m>b^2 = 9</m>, so the rectangle <m>T</m> is
<m>4 \times 9</m> and the integral equals
<m>\dfrac{(4)(9)}{2} = 18</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-ellipsoid-integral">
    <title>A Triple Integral Over an Ellipsoid</title>
    <statement>
      <p>
      Calculate the triple integral
      </p>
      <me>
      \iiint_{E} \left(\frac{x^2}{2^2} + \frac{y^2}{3^2}
      + \frac{z^2}{4^2}\right) dx\,dy\,dz ,
      </me>
      <p>
      where <m>E</m> is the region bounded by the ellipsoid
      <m>\dfrac{x^2}{2^2} + \dfrac{y^2}{3^2} + \dfrac{z^2}{4^2} = 1</m>. Use
      the change of variables <m>x = 2u</m>, <m>y = 3v</m>, <m>z = 4w</m>,
      which carries <m>E</m> to the unit ball.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Setting <m>x = 2u</m>, <m>y = 3v</m>,
        <m>z = 4w</m> carries <m>E</m> to the unit ball and
        has Jacobian <m>24</m>, while the integrand becomes
        <m>u^2+v^2+w^2 = \rho^2</m>. Hence
      </p>
      <me>
        \iiint_E \left(\frac{x^2}{2^2}
        + \frac{y^2}{3^2}
        + \frac{z^2}{4^2}\right) dV
        = 24\int_0^{2\pi}\!\!\int_0^{\pi}\!\!\int_0^{1}
          \rho^4 \sin\phi \,d\rho\,d\phi\,d\theta
        = \frac{4\,\pi\,24}{5} .
      </me>
      <p>
        Here the Jacobian is <m>(2)(3)(4) = 24</m>, so the integral is
<m>\dfrac{4\pi(24)}{5} = \dfrac{96\pi}{5} \approx 60.32</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-tetrahedron-com">
    <title>Centre of Mass of a Tetrahedron</title>
    <statement>
      <p>
      Find the mass and the centre of mass of the solid <m>W</m> bounded by the
      planes <m>x + y + z = 1</m>, <m>x = 0</m>, <m>y = 0</m>, and
      <m>z = 0</m>, assuming a mass density of
      <m>\rho(x,y,z) = 6\sqrt{z}</m>.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Describe <m>W</m> by <m>0 \le x \le 1</m>, <m>0 \le y \le 1-x</m>,
        <m>0 \le z \le 1-x-y</m>. Then
      </p>
      <me>
        \iiint_W 6\sqrt{z}\,dV
        = \frac{8\left(6\right)}{105}, \qquad
        \iiint_W 6x\sqrt{z}\,dV
        = \frac{16\left(6\right)}{945}, \qquad
        \iiint_W 6z\sqrt{z}\,dV
        = \frac{8\left(6\right)}{315},
      </me>
      <p>
        and the <m>y</m>-numerator equals the <m>x</m>-numerator by the
        symmetry of <m>W</m> and of <m>\rho</m> in <m>x</m> and <m>y</m>.
        Dividing,
      </p>
      <me>
        \left(x_{\mathrm{CM}}, y_{\mathrm{CM}}, z_{\mathrm{CM}}\right)
        = \left(\frac29, \frac29, \frac13\right),
      </me>
      <p>
        independently of the constant <m>6</m>, which cancels
        from every ratio.
      </p>
      <p>
        Here <m>k = 6</m>, so the mass is <m>\dfrac{8(6)}{105} = \dfrac{16}{35}
\approx 0.457</m>, and the centre of mass is
<m>\left(\tfrac29, \tfrac29, \tfrac13\right)</m>, independent of
<m>k</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-lamina-rectangle">
    <title>Mass and Centre of Mass of a Rectangular Lamina</title>
    <statement>
      <p>
      A lamina occupies the part of the rectangle <m>0 \le x \le 2</m>,
      <m>0 \le y \le 3</m>, and the density at each point is given by the
      function <m>\rho(x,y) = 4x + 5y + 6</m>. What is the total mass, and
      where is the centre of mass?
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Over the rectangle <m>R</m>,
      </p>
      <me>
        m = \int_0^{2}\!\!\int_0^{3}
        \left(4x + 5y + 6\right)
        dy\,dx = 105 ,
      </me>
      <p>
        and the two moments are
        <m>\iint_R x\rho\,dA = 113</m> and
        <m>\iint_R y\rho\,dA = 180</m>. Dividing each by the
        mass gives <m>\bar{x} \approx 1.076</m> and
        <m>\bar{y} \approx 1.714</m>.
      </p>
      <p>
        Here <m>A = 2</m>, <m>B = 3</m>, <m>C = 4</m>, <m>D = 5</m> and
<m>E = 6</m>, so <m>m = 105</m>, the moments are <m>113</m> and
<m>180</m>, and
<m>\left(\bar x, \bar y\right)
= \left(\tfrac{113}{105}, \tfrac{12}{7}\right)
\approx (1.076, 1.714)</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-linear-jacobian">
    <title>The Jacobian of a Linear Transformation</title>
    <statement>
      <p>
      Consider the transformation <m>T</m> from <m>uv</m>-coordinates to
      <m>xy</m>-coordinates given by
      </p>
      <me>
      T(u,v) = \left\langle 7u + 2v, \; 3u + 8v \right\rangle .
      </me>
      <p>
      Find the four partial derivatives of the transformation, and then its
      Jacobian.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        For a linear transformation the partial derivatives are just the
        coefficients, so
      </p>
      <me>
        \mathrm{Jac}(T) = \frac{\partial(x,y)}{\partial(u,v)}
        = \begin{vmatrix}
          7 &amp; 2 \\
          3 &amp; 8
          \end{vmatrix}
        = \left(7\right)\left(8\right)
        - \left(2\right)\left(3\right)
        = 50 ,
      </me>
      <p>
        a constant: a linear map scales every area by the same factor.
      </p>
      <p>
        Here the partial derivatives are <m>7</m>, <m>2</m>, <m>3</m> and
<m>8</m>, so the Jacobian is <m>(7)(8) - (2)(3) = 50</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-quadratic-map">
    <title>A Quadratic Map and the Integral It Simplifies</title>
    <statement>
      <p>
      The map <m>T(u,v) = \left(u^2-v^2,\; 2uv\right)</m> carries the triangle
      <m>D_0 = \left\{(u,v) : 0 \le v \le u \le 2\right\}</m> onto the domain
      <m>D</m> in the first quadrant bounded by <m>x = 0</m>, <m>y = 0</m>, and
      the parabola through the image of the edge <m>u = 2</m>. Use <m>T</m> to
      evaluate
      </p>
      <me>
      \iint_{D} \sqrt{x^2+y^2}\,dx\,dy .
      </me>
    </statement>
    <solution component="review3-solutions">
      <p>
        Since <m>x = u^2-v^2</m> and <m>y = 2uv</m>,
      </p>
      <me>
        \sqrt{x^2+y^2}
        = \sqrt{\left(u^2+v^2\right)^2} = u^2+v^2, \qquad
        \frac{\partial(x,y)}{\partial(u,v)}
        = \begin{vmatrix} 2u &amp; -2v \\ 2v &amp; 2u \end{vmatrix}
        = 4\left(u^2+v^2\right).
      </me>
      <p>
        Therefore
      </p>
      <me>
        \iint_D \sqrt{x^2+y^2}\,dx\,dy
        = 4\int_0^{2}\!\!\int_0^{u}
          \left(u^4 + 2u^2v^2 + v^4\right) dv\,du
        = 4\int_0^{2} \frac{28}{15}u^5\,du
        = \frac{56\left(2\right)^6}{45} .
      </me>
      <p>
        Here <m>a = 2</m>, so the integral equals
<m>\dfrac{56\left(2^6\right)}{45} = \dfrac{3584}{45} \approx 79.64</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-centre-of-gravity">
    <title>Centre of Gravity of a Region Between Two Curves</title>
    <statement>
      <p>
      The region <m>R</m> is bounded by the curves <m>y = 2x</m>,
      <m>y = 8 - x^2</m>, and the <m>y</m>-axis, and its mass density is
      <m>\delta(x,y) = xy</m>. Find the limits of the iterated integral
      <m>\displaystyle\int_c^d\!\!\int_{p(x)}^{q(x)}</m> describing <m>R</m>,
      evaluate the three integrals of <m>\delta</m>, <m>x\delta</m> and
      <m>y\delta</m> over <m>R</m>, and use them to locate the centre of
      gravity of <m>R</m>.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        The line and the parabola meet where
        <m>x^2 + 2x - 8 = 0</m>, that is at
        <m>x = 2</m>, so <m>c = 0</m> and
        <m>d = 2</m>, with
        <m>p(x) = 2x</m> and
        <m>q(x) = 8 - x^2</m>. Carrying out the three
        integrals of <m>xy</m>, <m>x^2y</m>, and <m>xy^2</m> over that
        region gives <m>\tfrac{88}{3}</m>, <m>30.476</m>,
        and <m>142.933</m> respectively, so
      </p>
      <me>
        \overline{x} = \frac{30.476}{\tfrac{88}{3}}
        \approx 1.039, \qquad
        \overline{y} = \frac{142.933}{\tfrac{88}{3}}
        \approx 4.873 .
      </me>
      <p>
        Here <m>m = 2</m> and <m>b = 8</m>, so <m>x^{*} = 2</m> exactly, giving
<m>c = 0</m>, <m>d = 2</m>, <m>p(x) = 2x</m>, <m>q(x) = 8 - x^2</m>, the
three integrals <m>\tfrac{88}{3} \approx 29.33</m>, <m>30.48</m> and
<m>142.93</m>, and
<m>\left(\overline{x}, \overline{y}\right) \approx (1.039, 4.873)</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-quarter-disc-com">
    <title>Centre of Mass of a Quarter Disc</title>
    <statement>
      <p>
      Find the centre of mass <m>P = \left(\overline{x},\overline{y}\right)</m>
      of the quarter disc of radius <m>3</m> lying under
      <m>y = \sqrt{3^2 - x^2}</m> for <m>0 \le x \le 3</m>, with constant
      density. (Use symmetry.)
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        By symmetry about the line <m>y = x</m>, the centre of mass lies on
        that line, so <m>\overline{x} = \overline{y}</m>. Computing
        <m>\overline{x}</m>,
      </p>
      <me>
        \overline{x}
        = \frac{\displaystyle\int_0^{3}
          x\sqrt{\left(3\right)^2-x^2}\,dx}
          {\displaystyle\frac{\pi\left(3\right)^2}{4}}
        = \frac{\left(3\right)^3/3}
          {\pi\left(3\right)^2/4}
        = \frac{4\left(3\right)}{3\pi}
        \approx \tfrac{4}{\pi} \approx 1.273 ,
      </me>
      <p>
        and <m>\overline{y}</m> has the same value.
      </p>
      <p>
        Here <m>r = 3</m>, so
<m>\overline{x} = \overline{y} = \dfrac{4(3)}{3\pi} = \dfrac{4}{\pi}
\approx 1.273</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-paraboloid-cap">
    <title>Flux Through a Paraboloid Cap</title>
    <statement>
      <p>
      Let
      <m>\mathbf{F}(x,y,z) = z\tan\!\left(y^2\right)\mathbf{i}
      + z^3\ln\!\left(x^2+1\right)\mathbf{j} + 3z\,\mathbf{k}</m>. Use the
      Divergence Theorem to find the flux of <m>\mathbf{F}</m> across the part
      of the paraboloid <m>x^2 + y^2 + z = 5</m> that lies above the plane
      <m>z = 1</m> and is oriented upward.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Write <m>b</m> for the coefficient of <m>z\,\mathbf{k}</m> and
        <m>a^2 = h - 1</m>, so the paraboloid meets the plane <m>z=1</m>
        in the circle of radius <m>a</m>. Then
        <m>\nabla \cdot \mathbf{F} = b</m>. Close the surface with the
        disk <m>S_1</m> of radius <m>a</m> at <m>z = 1</m>, oriented
        downward; there <m>\mathbf{F}\cdot(-\mathbf{k}) = -b</m>, so
        <m>\iint_{S_1} = -b\pi a^2</m>. The enclosed volume is
        <m>\int_0^{2\pi}\!\!\int_0^{a}\left(a^2 - r^2\right)r\,dr\,d\theta
        = \tfrac{\pi a^4}{2}</m>, so the closed-surface flux is
        <m>b\,\tfrac{\pi a^4}{2}</m>, and
      </p>
      <me>
        \iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma
        = b\,\frac{\pi a^4}{2} - \left(-b\pi a^2\right)
        = b\left(\frac{a^4}{2} + a^2\right)\pi.
      </me>
      <p>
        Here <m>b = 3</m> and <m>a^2 = 5 - 1 = 4</m>, so the flux is
<m>3\left(\tfrac{2^4}{2} + 2^2\right)\pi = 36\pi \approx 113.10</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-helicoid">
    <title>Flux Through a Helicoid</title>
    <statement>
      <p>
      Evaluate
      <m>\displaystyle\iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma</m>,
      where the vector field is
      <m>\mathbf{F} = \mathbf{i} + \mathbf{j} + \mathbf{k}</m> and the
      parametrized surface <m>S</m> is the helicoid
      </p>
      <me>
      \mathbf{r}(u,v) = \left(v\cos u,\ v\sin u,\ u\right),
      \qquad 0 \le u \le \pi, \quad 0 \le v \le 1,
      </me>
      <p>
      oriented upward.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        With <m>\mathbf{r}_u = \left(-v\sin u, v\cos u, 1\right)</m> and
        <m>\mathbf{r}_v = \left(\cos u, \sin u, 0\right)</m>, the upward
        normal is
        <m>\mathbf{r}_v\times\mathbf{r}_u
        = \sin u\,\mathbf{i} - \cos u\,\mathbf{j} + v\,\mathbf{k}</m>.
        Writing <m>c</m> for the common component of <m>\mathbf{F}</m>,
      </p>
      <me>
        \iint_S \mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma
        = c\int_0^1\!\!\int_0^{\pi}\left(\sin u - \cos u + v\right)
        du\,dv = c\left(2 + \frac{\pi}{2}\right).
      </me>
      <p>
        Here <m>c = 1</m>, so the flux is
<m>2 + \dfrac{\pi}{2} \approx 3.57</m>.
      </p>
    </solution>
  </problem>
  <problem xml:id="ex-r3o-paraboloid-updisk">
    <title>Flux Through a Paraboloid, Directly</title>
    <statement>
      <p>
      Compute the flux of the vector field
      <m>\mathbf{F} = 2x\,\mathbf{i} + 2y\,\mathbf{j}</m> through the surface
      <m>S</m>, which is the part of the surface
      <m>z = 9 - \left(x^2 + y^2\right)</m> above the disk of radius <m>3</m>
      centered at the origin, oriented <alert>upward</alert>.
      </p>
    </statement>
    <solution component="review3-solutions">
      <p>
        Writing the surface as <m>z = f(x,y) = R^2 - x^2 - y^2</m> over
        the disk <m>D</m> of radius <m>R</m>,
        <m>\hat{\mathbf{n}}\,d\sigma = \left(2x\,\mathbf{i} + 2y\,\mathbf{j} +
        \mathbf{k}\right)dx\,dy</m> and
        <m>\mathbf{F}\cdot\hat{\mathbf{n}}\,d\sigma = 2a\left(x^2+y^2\right)dx\,dy</m>,
        where <m>a</m> is the coefficient in <m>\mathbf{F}</m>. In polar
        coordinates,
      </p>
      <me>
        \text{Flux} = \int_0^{2\pi}\!\!\int_0^{R} 2a\,r^3\,dr\,d\theta
        = \pi a R^4.
      </me>
      <p>
        Here <m>a = 2</m> and <m>R = 3</m>, so the flux is
<m>\pi(2)\left(3^4\right) = 162\pi \approx 508.94</m>.
      </p>
    </solution>
  </problem>
  <figure xml:id="fig-r3o-parallelogram">
    <caption>
      The parallelogram of <xref ref="ex-r3o-parallelogram"/>, with its
      orientation. Note the direction of the arrows.
    </caption>
    <image width="55%">
      <shortdescription>
      A parallelogram anchored at the origin with arrows showing its boundary orientation.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-r3o-parallelogram">
        <diagram dimensions="(360,240)" margins="10">
          <coordinates bbox="(-0.8,-0.55,4.9,2.3)">
            <axes at="pg-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <polygon at="pg-par" closed="yes" stroke="#CC0079" thickness="3"
                fill="#CC0079" fill-opacity="0.15"
                points="((0,0),(2,1.4),(4,1.4),(2,0))"/>
            <vector at="pg-e1" v="(0.7,0.49)" tail="(0.75,0.525)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e2" v="(0.8,0)" tail="(2.7,1.4)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e3" v="(-0.7,-0.49)" tail="(3.35,0.945)"
                stroke="#CC0079" thickness="3"/>
            <vector at="pg-e4" v="(-0.8,0)" tail="(1.3,0)"
                stroke="#CC0079" thickness="3"/>
            <point at="pg-O" p="(0,0)" fill="black" alignment="sw">
              <m>(0,0)</m>
            </point>
            <point at="pg-B" p="(2,0)" fill="black" alignment="se">
              <m>(x_0,0)</m>
            </point>
