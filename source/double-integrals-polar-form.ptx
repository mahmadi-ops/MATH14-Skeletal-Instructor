<subsection xml:id="sec-polar-rose-example">
<title>Area Enclosed by One Loop of a Rose</title>

<example xml:id="example-polar-rose">
<title>Example II</title>
<statement>
<p>
Use a double integral to find the area enclosed by one loop of the
four-leaved rose <m>r = \cos(2\theta)</m>, graphed in
<xref ref="fig-rose-prefigure"/>.
</p>
<p>
<em>Solution.</em>
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,11);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,10.75) {workspace};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank workspace for Example II.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-rose-prefigure">
<caption>
The four-leaved rose <m>r = \cos(2\theta)</m>, with one loop <m>D</m>
shaded. Which angles sweep it out?
</caption>
<image width="55%">
<shortdescription>
A four-leaved rose with one petal outlined and shaded.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-rose">
<diagram dimensions="(340,340)" margins="10">
<definition>rose(t) = (cos(2*t)*cos(t), cos(2*t)*sin(t))</definition>
<definition>loop(t) = (cos(2*t)*cos(t), cos(2*t)*sin(t))</definition>
<coordinates bbox="(-1.35,-1.35,1.35,1.35)">
<axes at="ro-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<polygon at="ro-D" fill="#fbe3d0" stroke="none" closed="yes"
    points="((4.33e-17,-4.33e-17),(0.07768,-0.06994),(0.1616,-0.1308),(0.25,-0.1816),(0.3411,-0.2215),(0.433,-0.25),(0.5237,-0.2668),(0.6113,-0.2722),(0.6938,-0.2663),(0.7694,-0.25),(0.8365,-0.2241),(0.8936,-0.1899),(0.9393,-0.1488),(0.9728,-0.1022),(0.9932,-0.05205),(1,0),(0.9932,0.05205),(0.9728,0.1022),(0.9393,0.1488),(0.8936,0.1899),(0.8365,0.2241),(0.7694,0.25),(0.6938,0.2663),(0.6113,0.2722),(0.5237,0.2668),(0.433,0.25),(0.3411,0.2215),(0.25,0.1816),(0.1616,0.1308),(0.07768,0.06994),(4.33e-17,4.33e-17))"/>
<parametric-curve at="ro-curve" function="rose" domain="(0,2*pi)"
    stroke="#56B4E9" thickness="2"/>
<parametric-curve at="ro-loop" function="loop" domain="(-pi/4,pi/4)"
    stroke="#D55E00" thickness="3"/>
<label at="ro-D-label" anchor="(0.42,0)" alignment="c">
<m>D</m>
</label>
</coordinates>
<annotations>
<annotation ref="figure" text="A four leaved rose curve centered at the origin, drawn in light blue. The right hand loop, along the positive x axis, is outlined in vermillion and shaded tan, and is labeled D.">
  <annotation ref="ro-curve" text="The four leaved rose r equals cosine of two theta."/>
  <annotation ref="ro-D" text="The region D: the loop of the rose along the positive x axis."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>

</subsection>

