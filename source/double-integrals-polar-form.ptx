<subsection xml:id="sec-polar-annulus-example">
<title>Integrating Over a Half Annulus</title>

<example xml:id="example-polar-annulus">
<title>Example I</title>
<statement>
<p>
Evaluate <m>\displaystyle\iint_R (3x + 4y^2)\,dA</m>, where <m>R</m>
is the region in the upper half plane bounded by the circles
<m>x^2 + y^2 = 1</m> and <m>x^2 + y^2 = 4</m>.
</p>
<p>
<em>Solution.</em>
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,13);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,12.75) {workspace};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank workspace for Example I.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-half-annulus-prefigure">
<caption>
The region of <xref ref="example-polar-annulus"/>: the upper half of
the annulus between the circles <m>x^2+y^2 = 1</m> and
<m>x^2+y^2 = 4</m>.
</caption>
<image width="60%">
