<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW2: line integrals of scalar functions -->
<section xml:id="sec-exercises-hw2" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 2</title>

  <introduction>
    <p>
      Section: <xref ref="sec-line-integrals" text="title"/>.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw2">

  <exercise xml:id="ex-hw2-quarter-circle">
    <statement>
      <p>
        Consider a wire whose shape is a quarter circle of radius one,
        centered at <m>(a,0)</m>, where <m>a \gt 0</m>. The density of the
        wire is
      </p>
      <me>
        \rho(x,y) = \frac{18(x-a)y}{(x-a)^2 + y^2}
      </me>
      <p>
        measured in kilograms per meter. Find the total mass of the wire.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-segment">
    <statement>
      <p>
        Evaluate the line integral
        <m>\displaystyle\int_C (x - y + z - 2)\,ds</m>, where <m>C</m> is
        the straight-line segment parametrized by <m>x = t</m>,
        <m>y = 1-t</m>, and <m>z = 1</m>, from <m>(0,1,1)</m> to
        <m>(1,0,1)</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-square-path">
    <statement>
      <p>
        Evaluate the line integral
        <m>\displaystyle\int_C \frac{1}{x^2 + y^2 + 1}\,ds</m> over the
        curve <m>C</m> of <xref ref="fig-hw2-square"/>.
      </p>
      <figure xml:id="fig-hw2-square">
        <caption>
          The curve <m>C</m> of <xref ref="ex-hw2-square-path"/>: the boundary
          of the unit square, traversed once as shown.
        </caption>
        <image width="55%">
          <shortdescription>
          The unit square traversed counterclockwise, arrowheads on all four sides.
          </shortdescription>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw2-square">
            <diagram dimensions="(300,280)" margins="12">
              <coordinates bbox="(-0.55,-0.55,1.6,1.5)">
                <axes at="hs-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
                <polygon at="hs-square" closed="yes" stroke="#0072B2" thickness="3"
                    fill="none" points="((0,0),(1,0),(1,1),(0,1))"/>
                <vector at="hs-a1" v="(0.16,0)" tail="(0.42,0)" stroke="#0072B2"
                    thickness="3"/>
                <vector at="hs-a2" v="(0,0.16)" tail="(1,0.42)" stroke="#0072B2"
                    thickness="3"/>
                <vector at="hs-a3" v="(-0.16,0)" tail="(0.58,1)" stroke="#0072B2"
                    thickness="3"/>
                <vector at="hs-a4" v="(0,-0.16)" tail="(0,0.58)" stroke="#0072B2"
                    thickness="3"/>
                <point at="hs-p00" p="(0,0)" fill="#0072B2" alignment="sw">
                  <m>(0,0)</m>
                </point>
                <point at="hs-p10" p="(1,0)" fill="#0072B2" alignment="se">
                  <m>(1,0)</m>
                </point>
                <point at="hs-p11" p="(1,1)" fill="#0072B2" alignment="ne">
                  <m>(1,1)</m>
                </point>
                <point at="hs-p01" p="(0,1)" fill="#0072B2" alignment="nw">
                  <m>(0,1)</m>
                </point>
              </coordinates>
              <annotations>
                <annotation ref="figure" text="The unit square in the x y plane, with corners at the origin, one comma zero, one comma one, and zero comma one. Its sides are drawn in blue, and arrowheads on the four sides show the curve traversed counterclockwise starting along the bottom side.">
                  <annotation ref="hs-square" text="The square path C, the boundary of the unit square."/>
                  <annotation ref="hs-a1" text="An arrow on the bottom side pointing in the direction of increasing x."/>
                  <annotation ref="hs-a2" text="An arrow on the right side pointing upward."/>
                  <annotation ref="hs-a3" text="An arrow on the top side pointing in the direction of decreasing x."/>
                  <annotation ref="hs-a4" text="An arrow on the left side pointing downward."/>
                </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-wall">
    <statement>
      <p>
        Find the surface area of the wall whose height is given by
        <m>f(x,y) = x^2 - y^2 + 3</m> and whose base is the unit circle in
        the <m>xy</m>-plane. See <xref ref="fig-hw2-wall"/>.
      </p>
      <figure xml:id="fig-hw2-wall">
        <caption>
          The wall of <xref ref="ex-hw2-wall"/>: its base is the unit circle in
          the <m>xy</m>-plane and its height above a point of that circle is
          <m>f(x,y) = x^2 - y^2 + 3</m>.
        </caption>
        <image xml:id="image-hw2-wall" width="60%">
          <shortdescription>
            A curved wall standing on the unit circle, whose top edge rises and
            falls twice around the circle.
          </shortdescription>
          <description>
            <p>
              A translucent blue wall stands vertically on the unit circle in
              the horizontal plane. Its top edge is a closed curve that reaches
              height four above the points where the circle meets the x axis
              and dips to height two above the points where it meets the y
              axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \begin{axis}[
      view={120}{18},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=-1.5, xmax=1.5, ymin=-1.5, ymax=1.5, zmin=0, zmax=4.6,
      clip=false,
    ]
    % ---- the wall: height x^2 - y^2 + 3 over the unit circle ----
    \addplot3[surf, shader=faceted, faceted color=oiblue!30,
              colormap={wallz}{color=(oiblue!14!white) color=(oiblue!42!white)},
              opacity=0.65, fill opacity=0.65,
              domain=0:360, samples=48, y domain=0:1, samples y=14,
              z buffer=sort, forget plot]
      ({cos(x)}, {sin(x)}, {y*(cos(x)^2 - sin(x)^2 + 3)});
    % ---- the base circle ----
    \addplot3[black!65, dashed, line width=1.1pt, samples=100, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, 0);
    % ---- the top edge ----
    \addplot3[oiblue, line width=1.6pt, samples=140, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, {cos(x)^2 - sin(x)^2 + 3});
    % ---- height marks ----
    \draw[black!55, line width=0.6pt] (axis cs:0,0,4) -- (axis cs:0.09,0,4);
    \node[anchor=east, font=\small] at (axis cs:0,0,4) {$4$};
    \node[anchor=north, font=\small] at (axis cs:1,0,-0.12) {$1$};
    \node[anchor=north, font=\small] at (axis cs:0,1,-0.12) {$1$};
    \node[oiblue, font=\large, anchor=south west]
      at (axis description cs:0.02,0.86) {$z = x^2 - y^2 + 3$};
  \end{axis}
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-exp-curve">
    <statement>
      <p>
        Compute the line integral of the scalar function
        <m>f(x,y,z) = 2x^2 + 8z</m> over the curve
        <m>\mathbf{c}(t) = \left\langle e^t,\ t^2,\ t \right\rangle</m>,
        <m>0 \le t \le 8</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-ellipse-wall">
    <statement>
      <p>
        Find the surface area of the wall of <xref ref="fig-hw2-ellipse-wall"/>. Its base
        is the curve <m>C</m>, the quarter of the ellipse
        <m>\frac{x^2}{5^2} + \frac{y^2}{7^2} = 1</m> that begins at
        <m>(5,0)</m> and ends at <m>(0,7)</m>, and its height above a point
        of <m>C</m> is <m>f(x,y) = xy</m>.
      </p>
      <figure xml:id="fig-hw2-ellipse-wall">
        <caption>
          The wall of <xref ref="ex-hw2-ellipse-wall"/>: its base is the quarter of the
          ellipse <m>\frac{x^2}{5^2} + \frac{y^2}{7^2} = 1</m> from
          <m>(5,0)</m> to <m>(0,7)</m>, and its height above a point of that
          curve is <m>f(x,y) = xy</m>.
        </caption>
        <image xml:id="image-hw2-ellipse-wall" width="60%">
          <shortdescription>
            A curved wall standing on a quarter ellipse in the first quadrant,
            zero high at both ends and tallest in the middle.
          </shortdescription>
          <description>
            <p>
              A translucent blue wall stands vertically on the quarter of an
              ellipse in the first quadrant of the horizontal plane, running from
              the point five comma zero on the x axis to the point zero comma
              seven on the y axis. The top edge of the wall is the graph of
              z equals x y over that curve: it starts at height zero on the x
              axis, rises to a single hump in the middle, and falls back to
              height zero on the y axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oired}{RGB}{213,94,0}
  \begin{axis}[
      view={130}{22},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=0, xmax=6.5, ymin=0, ymax=8.5, zmin=0, zmax=21,
      clip=false,
    ]
    % ---- the wall: height xy over the quarter ellipse ----
    \addplot3[surf, shader=faceted, faceted color=oiblue!30,
              colormap={wallxy}{color=(oiblue!14!white) color=(oiblue!42!white)},
              opacity=0.65, fill opacity=0.65,
              domain=0:90, samples=36, y domain=0:1, samples y=12,
              z buffer=sort, forget plot]
      ({5*cos(x)}, {7*sin(x)}, {y*35*cos(x)*sin(x)});
    % ---- the base curve C ----
    \addplot3[oired, line width=1.6pt, samples=80, samples y=0,
              domain=0:90, forget plot]
      ({5*cos(x)}, {7*sin(x)}, 0);
    % ---- the top edge ----
    \addplot3[oiblue, line width=1.6pt, samples=80, samples y=0,
              domain=0:90, forget plot]
      ({5*cos(x)}, {7*sin(x)}, {35*cos(x)*sin(x)});
    % ---- labels ----
    \node[anchor=north, font=\small] at (axis cs:5,0,-0.6) {$(5,0)$};
    \node[anchor=north, font=\small] at (axis cs:0,7,-0.6) {$(0,7)$};
    \node[oired, font=\large, anchor=north east]
      at (axis cs:3.54,4.95,-0.3) {$C$};
    \node[oiblue, font=\large, anchor=south west]
      at (axis description cs:0.02,0.86) {$z = f(x,y) = xy$};
  \end{axis}
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw2-power-curve">
    <statement>
      <p>
        Calculate <m>\displaystyle\int_C f\,ds</m>, where
        <m>f(x,y) = 64\,x^{-7}y^3</m> and the curve <m>C</m> is
        <m>y = \frac14 x^4</m> for <m>-1 \le x \le 0</m>.
      </p>
    </statement>
  </exercise>
</exercises>
</section>
