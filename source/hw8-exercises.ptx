<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW8: surface integrals computed directly from a               -->
<!-- parametrization, with no appeal to Stokes' or the divergence theorem.    -->
<!-- The auto-graded version of the same problems, with randomized            -->
<!-- constants, is hw8-online.ptx.                                            -->
<!-- Renumbered as Assignment 8; existing xml:ids keep exercise links and saved answers stable. -->
<section xml:id="sec-exercises-hw9" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 8</title>

  <introduction>
    <p>
      Section: <xref ref="section-surface-integrals" text="title"/>.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw9">

  <exercise xml:id="ex-hw9-cylinder-flux">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m>, where
        <m>\mathbf{F} = \left\langle x^2,\ 2z,\ -3y \right\rangle</m>
        and <m>S</m> is the portion of the cylinder <m>y^2 + z^2 = 4</m>
        lying between <m>x = 0</m> and <m>x = 3 - z</m>, with
        <m>\hat{\mathbf{n}}</m> pointing away from the <m>x</m>-axis.
      </p>
    </statement>
  </exercise>
  <exercise xml:id="ex-hw9-cone-flux">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m>, where
        <m>\mathbf{F} = \left\langle 4x,\ 4y,\ 6z \right\rangle</m>
        and <m>S</m> is the portion of the cone
        <m>z = \sqrt{x^2+y^2}</m> lying between the planes
        <m>z = 1</m> and <m>z = 3</m>, with <m>\hat{\mathbf{n}}</m>
        pointing upward.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw9-disk-yz">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m> of
        <m>\mathbf{F}(x,y,z) = \left\langle 3x + 5,\ 0,\ 0
        \right\rangle</m> through the disk <m>S</m> of radius <m>4</m>
        centred at the origin in the <m>yz</m>-plane, oriented in the
        negative <m>x</m>-direction.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw9-square-plane">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m>, where
        <m>\mathbf{F} = \left\langle 7,\ 6x^2,\ -2 \right\rangle</m>
        and <m>S</m> is the square of side <m>4</m> in the plane
        <m>y = 3</m>, centred on the <m>y</m>-axis, with sides parallel to
        the <m>x</m>- and <m>z</m>-axes, oriented in the positive
        <m>y</m>-direction.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw9-exponential-graph">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m>, where
        <m>\mathbf{F} = \left\langle 3xy,\ 8x^2,\ 3yz
        \right\rangle</m> and <m>S</m> is the surface
        <m>z = xe^y</m> over <m>0 \le x \le 1</m>,
        <m>0 \le y \le 1</m>, with <m>\hat{\mathbf{n}}</m> pointing
        upward.
      </p>
    </statement>
  </exercise>

  </exercises>
</section>
