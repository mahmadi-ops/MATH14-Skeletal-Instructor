<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW6: triple integrals in rectangular, cylindrical, and spherical coordinates -->
<section xml:id="sec-exercises-hw6" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 6</title>

  <introduction>
    <p>
      Sections: <xref ref="section-triple-integrals-rectangular" text="title"/>,
      <xref ref="section-triple-integrals-cylindrical" text="title"/>, and <xref ref="section-triple-integrals-spherical" text="title"/>.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw6">

  <exercise xml:id="ex-hw6-cone-mass">
    <statement>
      <p>
        Consider an object bounded by <m>x = \sqrt{y^2+z^2}</m> and
        <m>x = 1</m>. Suppose that the object's mass density function is
        <m>\rho(x,y,z) = x</m>. Find the mass of the object.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw6-convert">
    <statement>
      <p>
        Convert (do not evaluate) the following integral to rectangular
        coordinates:
      </p>
      <me>
        \int_{-\pi/4}^{\pi/4}\!\!\int_{0}^{\sec\theta}\!\!
        \int_{0}^{r^2\cos(2\theta)} r\,dz\,dr\,d\theta .
      </me>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw6-signs">
    <introduction>
      <p>
        <term>Without calculating the integrals</term>, decide whether each
        of the integrals below is positive, negative, or zero. Let <m>R</m>
        be the solid bounded by <m>z = 1-x^2-y^2</m> and
        <m>z = x^2+y^2</m>. Remember to justify your answers.
      </p>
    </introduction>
    <task xml:id="task-hw6-sign-a">
      <statement>
        <p>
          <m>\displaystyle\iiint_R \left(z + x^2 + y^2 - 1\right) dV</m>
        </p>
      </statement>
    </task>
    <task xml:id="task-hw6-sign-b">
      <statement>
        <p>
          <m>\displaystyle\iiint_R \left(z - x^2 - y^2\right) dV</m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-hw6-volume">
    <statement>
      <p>
        Calculate the volume of the region bounded by
        <m>x^2 + y^2 - z^2 + 5 = 0</m> and
        <m>x^2 + y^2 + z - 1 = 0</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw6-hemisphere">
    <statement>
      <p>
        Evaluate the following integral:
      </p>
      <md>
        <mrow>
          \int_{0}^{6}\!\!\int_{-\sqrt{36-x^2}}^{\sqrt{36-x^2}}\!\!
          \int_{-\sqrt{36-x^2-z^2}}^{\sqrt{36-x^2-z^2}}
          \frac{1}{\left(x^2+y^2+z^2\right)^{1/2}}\;dy\,dz\,dx .
        </mrow>
      </md>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw6-convert-spherical">
    <statement>
      <p>
        Convert (do not evaluate) the following integral to
        <term>spherical</term> and <term>cylindrical</term> coordinates.
        Which set of coordinates is the most efficient for evaluating this
        integral?
      </p>
      <me>
        \int_{0}^{1}\!\!\int_{0}^{\sqrt{1-x^2}}\!\!
        \int_{-\sqrt{2-x^2-y^2}}^{-\sqrt{x^2+y^2}} dz\,dy\,dx
      </me>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw6-wedge">
    <statement>
      <p>
        Find the volume of the wedge-shaped region <m>\mathcal{W}</m> of
        <xref ref="fig-hw6-wedge"/>, contained in the cylinder
        <m>x^2 + y^2 = 9</m>, bounded above by the plane <m>z = x</m> and
        below by the <m>xy</m>-plane.
      </p>
      <figure xml:id="fig-hw6-wedge">
        <caption>
          The wedge of <xref ref="ex-hw6-wedge"/>: inside the cylinder
          <m>x^2 + y^2 = 9</m>, above the <m>xy</m>-plane and below the plane
          <m>z = x</m>.
        </caption>
        <image xml:id="image-hw6-wedge" width="60%">
          <shortdescription>
            A wedge standing on a half disk in the xy-plane: its curved side is part of
            a cylinder and its sloping top is the plane z equals x.
          </shortdescription>
          <description>
            <p>
              A solid wedge. Its base is the half of the disk of radius 3 centered at
              the origin that lies on the side x greater than or equal to zero, shaded
              orange and labelled D. Its curved side is the piece of the cylinder over the
              semicircle, drawn in translucent blue, and its top is the sloping plane z
              equals x, which meets the base along the diameter on the y axis and rises
              to height 3 at the point (3,0,3) on the x axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \begin{axis}[
                          view={40}{22},
                          width=11cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-0.4, xmax=1.55, ymin=-1.4, ymax=1.4, zmin=0, zmax=1.35,
                          clip=false,
                        ]
                        % ---- base: the half disk D in the xy-plane ----
                        \addplot3[surf, shader=flat, color=oiorange!25, opacity=0.5, fill opacity=0.5,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=2,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, 0);
                        % ---- curved cylinder wall x^2+y^2=R^2, from z=0 up to z=x ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!25,
                                  colormap={wallz}{color=(oiblue!10!white) color=(oiblue!45!white)},
                                  opacity=0.55, fill opacity=0.55,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({cos(x)}, {sin(x)}, {y*cos(x)});
                        % ---- top: the plane z = x over D ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={topz}{color=(oiblue!18!white) color=(oiblue!55!white)},
                                  opacity=0.7, fill opacity=0.7,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, {y*cos(x)});
                        % ---- edges ----
                        \addplot3[black!65, dashed, line width=1.1pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, 0);
                        \addplot3[oiblue, line width=1.6pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, {cos(x)});
                        \draw[oiblue, line width=1.2pt] (axis cs:0,-1,0) -- (axis cs:0,1,0);
                        \draw[oiblue, line width=1.2pt] (axis cs:1,0,0) -- (axis cs:1,0,1);
                        % ---- labels ----
                        \node[anchor=north, font=\small] at (axis cs:1,0,-0.05) {$3$};
                        \node[anchor=south west, font=\small] at (axis cs:1,0,1) {$(3,0,3)$};
                        \node[oiblue, font=\large, anchor=south west]
                          at (axis description cs:0.02,0.86) {$z = x$};
                        \node[oiorange!80!black, font=\small] at (axis cs:0.5,-0.45,0) {$\mathcal{D}$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
  </exercise>
  </exercises>
</section>
