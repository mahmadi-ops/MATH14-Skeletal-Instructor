      \edef\tmp{\noexpand\draw[-latex, black!35, line width=0.9pt]
        (axis cs:\zz,0.6,{\xx+0.55}) -- (axis cs:\zz,1.9,{\xx+1.0});}\tmp}
    % the plate: a parallelogram with normal in the y-z plane, tilted
    % plate spanned by u=(1,0,0) and w=(0,0.5,0.9)(scaled)
    \fill[oiblue!35, draw=oiblue, line width=1.2pt, fill opacity=0.75]
      (axis cs:-1.1,-0.7,0.6) -- (axis cs:1.1,-0.7,0.6)
      -- (axis cs:1.1,0.7,-0.6) -- (axis cs:-1.1,0.7,-0.6) -- cycle;
