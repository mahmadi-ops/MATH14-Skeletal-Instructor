<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW7, online version: the same problems as the written       -->
<!-- Assignment 7, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw7-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 7</title>

  <introduction>
    <p>
      Sections: <xref ref="section-jacobian-substitution" text="title"/> and <xref ref="section-mass-center-of-mass" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw7-online">

  <exercise xml:id="ex-hw7o-ellipse">
    <title>The Area of a Slanted Ellipse</title>
    <statement>
      <p>
        With <m>s = x+4y</m>, <m>t = y</m>, the Jacobian
        <m>\left|\dfrac{\partial(x,y)}{\partial(s,t)}\right|</m>
        equals <var width="6"/>, the ellipse becomes the unit disk in the
        <m>st</m>-plane, and its area is <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="3.142" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw7-solutions">
      <p>
        Inverting gives <m>x = s-4t</m>, <m>y = t</m>, so the Jacobian
        determinant is <m>1</m> and <m>dx\,dy = ds\,dt</m>. Substituting,
        <m>x^2+8xy+17y^2 = (s-4t)^2 + 8(s-4t)t + 17t^2 = s^2+t^2</m>, so
        the region is the unit disk and
      </p>
      <me>
        \text{Area} = \iint_R dx\,dy = \iint_T ds\,dt = \pi .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw7o-scaling">
    <title>Scaling a Double Integral</title>
    <statement>
      <p>
        Suppose <m>\iint_D f\,dA = 3</m>, where <m>D</m> is the disk
        <m>x^2+y^2 \le 16</m>. Let <m>E</m> be the disk
        <m>x^2+y^2 \le 64</m> and
        <m>g(x,y) = 3f\left(\frac{x}{2},\frac{y}{2}\right)</m>.
      </p>
      <p>
        The change of variables carrying <m>E</m> onto <m>D</m> multiplies
        areas by <var width="6"/>, and
        <m>\iint_E g\,dA = </m> <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="4" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="36" tolerance="0.05">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="9" tolerance="0.05">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw7-solutions">
      <p>
        With <m>x = 2u</m>, <m>y = 2v</m> the Jacobian is <m>4</m>, and
        <m>E</m> becomes <m>u^2+v^2 \le 16</m>, which is <m>D</m>. Hence
      </p>
      <me>
        \iint_E g\,dA = 3\iint_D f(u,v)\,(4)\,du\,dv
        = 12 \iint_D f\,dA = 12(3) = 36 .
      </me>
    </solution>
  </exercise>

  <figure xml:id="fig-hw7o-solid">
    <caption>
      The solid of <xref ref="ex-hw7o-centroid"/>: the cone
      <m>z = 1 + \sqrt{x^2+y^2}</m> capped by the plane <m>z = 2</m>,
      sitting on the horizontal cylinder <m>x^2 + z^2 = 1</m> cut off by the
      planes <m>y = \pm 1</m>.
    </caption>
    <image xml:id="image-hw7o-solid" width="65%">
      <shortdescription>
        A cone standing point-down on a horizontal cylinder lying along the
        y axis.
      </shortdescription>
      <description>
        <p>
          A red cylinder of radius one lies on its side along the y axis,
          cut off by the planes y equals plus and minus one. Above it, a red
          cone opens upward from the point at height one on the z axis to a
          disk of radius one in the plane z equals two.
        </p>
      </description>
      <latex-image>
        <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oired}{RGB}{213,40,60}
  \begin{axis}[
      view={118}{16},
      width=11.5cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=-2.2, xmax=2.2, ymin=-2.2, ymax=2.2, zmin=-1.4, zmax=3.2,
      clip=false,
    ]
    % ---- the horizontal plane, for reference ----
    \addplot3[surf, shader=flat, draw=black!12, fill=black!10,
              opacity=0.45, fill opacity=0.45,
              domain=-2:2, samples=2, y domain=-2:2, samples y=2,
              forget plot]
      (x, y, 0);
    % ---- the cylinder x^2 + z^2 = 1, lying along y, cut at y = pm 1 ----
    \addplot3[surf, shader=faceted, faceted color=oired!35,
              colormap={cylr}{color=(oired!45!white) color=(oired!85!black)},
              opacity=0.9, fill opacity=0.9,
              domain=0:360, samples=44, y domain=-1:1, samples y=6,
              z buffer=sort, forget plot]
      ({cos(x)}, y, {sin(x)});
    % ---- the cone z = 1 + sqrt(x^2+y^2), capped at z = 2 ----
    \addplot3[surf, shader=faceted, faceted color=oired!30,
              colormap={coner}{color=(oired!40!white) color=(oired!80!black)},
              opacity=0.92, fill opacity=0.92,
              domain=0:1, samples=16, y domain=0:360, samples y=44,
              z buffer=sort, forget plot]
      ({x*cos(y)}, {x*sin(y)}, {1 + x});
    % ---- the cap of the cone ----
    \addplot3[surf, shader=flat, draw=oired!55, fill=oired!45,
              opacity=0.85, fill opacity=0.85,
              domain=0:1, samples=12, y domain=0:360, samples y=44,
              forget plot]
      ({x*cos(y)}, {x*sin(y)}, 2);
    % ---- labels ----
    \node[oired, font=\large, anchor=west]
      at (axis cs:0.55,1.15,2.55) {$z = 1+\sqrt{x^2+y^2}$};
    \node[oired, font=\large, anchor=west]
      at (axis cs:0.55,1.15,-1.15) {$x^2+z^2=1$};
    \draw[black!55, line width=0.6pt] (axis cs:0,0,2) -- (axis cs:0.12,0,2);
    \node[anchor=east, font=\small] at (axis cs:0,0,2) {$2$};
    \draw[black!55, line width=0.6pt] (axis cs:0,0,3) -- (axis cs:0.12,0,3);
    \node[anchor=east, font=\small] at (axis cs:0,0,3) {$3$};
  \end{axis}
\end{tikzpicture}]]>
      </latex-image>
    </image>
  </figure>

  <exercise xml:id="ex-hw7o-centroid">
    <title>The Centroid of Cone Plus Cylinder</title>
    <statement>
      <p>
        For the solid of <xref ref="fig-hw7o-solid"/> with constant density
        <m>\delta</m>: the mass of the cylinder is <m>m_1 = </m>
        <var width="8"/> times <m>\delta</m>, and the mass of the cone is
        <m>m_2 = </m> <var width="8"/> times <m>\delta</m>.
      </p>
      <p>
        The centroid lies on the <m>z</m>-axis at <m>z = </m>
        <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="6.283" tolerance="0.01">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var>
        <condition number="1.047" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.25" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw7-solutions">
      <p>
        By symmetry the cylinder's own centroid is the origin, so only the
        cone moves the answer. The cylinder has volume
        <m>\pi(1)^2(2) = 2\pi</m> and the cone
      </p>
      <me>
        m_2 = \delta\iint_R\left(1-\sqrt{x^2+y^2}\right) dA
        = \delta\left(\tfrac12 - \tfrac13\right)(2\pi)
        = \frac{\pi\delta}{3} .
      </me>
      <p>
        The cone's own centroid sits at <m>z = 1 + \frac34 =
        \frac74</m>, so with <m>M = 2\pi\delta + \frac{\pi\delta}{3}
        = \frac{7\pi\delta}{3}</m>,
      </p>
      <me>
        \overline{z} = \frac{m_2}{M}\cdot\frac74
        = \frac{\pi\delta/3}{7\pi\delta/3}\cdot\frac74
        = \frac14 ,
      </me>
      <p>
        so the centroid is
        <m>\left\langle 0, 0, \frac14 \right\rangle</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw7o-center-of-mass">
    <title>Center of Mass of the Cone</title>
    <statement>
      <p>
        For the solid bounded by <m>x = \sqrt{y^2+z^2}</m> and
        <m>x = 1</m> with <m>\rho(x) = x</m>: the mass is
        <var width="8"/>, the moment <m>M_{yz}</m> is <var width="8"/>, and
        the center of mass is at <m>x = </m> <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
                <condition string=".*">
            <feedback>
                  <p>Incorrect.</p>
                </feedback>
          </condition>
        </var>
      <var>
        <condition number="0.628" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.8" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw7-solutions">
      <p>
        By symmetry the center of mass lies on the <m>x</m>-axis. From
        <xref ref="ex-hw6o-cone-mass"/>, <m>M = \pi/4</m>, and
      </p>
      <me>
        M_{yz} = \int_0^1\!\!\int_0^{2\pi}\!\!\int_r^1
        x^2\,r\,dx\,d\theta\,dr
        = \frac{2\pi}{3}\int_0^1 r\left(1-r^3\right) dr
        = \frac{\pi}{5} .
      </me>
      <p>
        Hence <m>\overline{x} = \dfrac{\pi/5}{\pi/4} = \dfrac45</m>,
        and the center of mass is
        <m>\left\langle \frac45, 0, 0 \right\rangle</m>.
      </p>
    </solution>
  </exercise>
  </exercises>
</section>
