<polygon closed="yes" at="rr-square" points="((0,0),(1,0),(1,1),(0,1))"
         fill="#9ecfff" stroke="#2b6cb0" thickness="2"/>
<label at="rr-R" anchor="(0.5,0.5)" alignment="c">
<m>R</m>
</label>
