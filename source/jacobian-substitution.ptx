<annotations>
<annotation ref="figure" text="The unit square R, shaded blue, with corners at the origin and 1 comma 1 in the x y plane.">
  <annotation ref="rr-square" text="The unit square R, the image of the rectangle S under the transformation."/>
</annotation>
</annotations>
</diagram>
