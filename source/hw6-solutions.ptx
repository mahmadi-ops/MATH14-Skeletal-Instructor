<!-- MATH 14 - Assignment 6, the version WITH solutions.                        -->
<!--                                                                        -->
<!-- Statements come from the written assignment, solutions from the auto-   -->
<!-- graded version; each problem is a <problem> whose <solution> is printed -->
<!-- directly beneath it.  The auto-graded version is hw6-online.ptx.        -->
<!--                                                                        -->
<!-- HIDING THE SOLUTIONS.  Every <solution> here carries                    -->
<!--   component="hw6-solutions"                                            -->
<!-- so this assignment's solutions can be switched off from                 -->
<!-- publication/publication.ptx; see the comment in <source> there.         -->
<section xml:id="sec-solutions-hw6" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 6</title>

    <p>
    Sections: <xref ref="section-triple-integrals-rectangular" text="title"/>,
    <xref ref="section-triple-integrals-cylindrical" text="title"/>, and <xref ref="section-triple-integrals-spherical" text="title"/>.
    </p>

  <p>
    Work each problem yourself first; the full solution follows immediately
    below it. The auto-graded version of the same problems is
    <xref ref="sec-exercises-hw6-online" text="title"/>.
  </p>

  <problem xml:id="ex-hw6-cone-mass">
    <statement>
      <p>
      Consider an object bounded by <m>x = \sqrt{y^2+z^2}</m> and
      <m>x = 1</m>. Suppose that the object's mass density function is
      <m>\rho(x,y,z) = x</m>. Find the mass of the object.
      </p>
    </statement>
    <solution component="hw6-solutions">
      <p>
      With <m>dV = r\,dr\,d\theta\,dx</m> (the cylindrical volume element
      <xref ref="eq-dv-cylindrical"/> about the <m>x</m>-axis) and
      <m>r \le x \le 1</m>,
      </p>

      <md>
      <mrow>
      M \amp = \int_0^1\!\!\int_0^{2\pi}\!\!\int_r^1
      x\,r\,dx\,d\theta\,dr
      = (2\pi)\left(\tfrac12\right)\int_0^1 r\left(1-r^2\right) dr
      </mrow>
      <mrow>
      \amp = \pi\left[\frac{r^2}{2} - \frac{r^4}{4}\right]_0^1
      = \frac{\pi}{4} \approx 0.785 .
      </mrow>
      </md>
    </solution>
  </problem>

  <problem xml:id="ex-hw6-convert">
    <statement>
      <p>
      Convert (do not evaluate) the following integral to rectangular
      coordinates:
      </p>

      <me>
      \int_{-\pi/4}^{\pi/4}\!\!\int_{0}^{\sec\theta}\!\!
      \int_{0}^{r^2\cos(2\theta)} r\,dz\,dr\,d\theta .
      </me>
    </statement>
    <solution component="hw6-solutions">
      <p>
      Since <m>r^2\cos(2\theta) = r^2\left(\cos^2\theta -
      \sin^2\theta\right) = x^2 - y^2</m> and
      <m>r = \sec\theta</m> is <m>r\cos\theta = 1</m>, that is
      <m>x = 1</m>, the region in the plane is the triangle bounded by
      <m>y = x</m>, <m>y = -x</m>, and <m>x = 1</m>. Hence
      </p>

      <me>
      \int_0^1\!\!\int_{-x}^{x}\!\!\int_0^{x^2-y^2} dz\,dy\,dx .
      </me>
    </solution>
  </problem>

  <problem xml:id="ex-hw6-signs">
    <statement>
      <p>
      <term>Without calculating the integrals</term>, decide whether each
      of the integrals below is positive, negative, or zero. Let <m>R</m>
      be the solid bounded by <m>z = 1-x^2-y^2</m> and
      <m>z = x^2+y^2</m>. Remember to justify your answers.
      </p>
      <p>
      (a) <m>\displaystyle\iiint_R \left(z + x^2 + y^2 - 1\right) dV</m>
      </p>
      <p>
      (b) <m>\displaystyle\iiint_R \left(z - x^2 - y^2\right) dV</m>
      </p>
    </statement>
    <solution component="hw6-solutions">
      <p>
      On <m>R</m>, <m>x^2+y^2 \le z \le 1-x^2-y^2</m>. The right
      inequality gives <m>z + x^2 + y^2 - 1 \le 0</m>, so the first
      integral is <term>negative</term>; the left gives
      <m>z - x^2 - y^2 \ge 0</m>, so the second is <term>positive</term>.
      Each integrand vanishes only on one of the two bounding surfaces.
      </p>
    </solution>
  </problem>

  <problem xml:id="ex-hw6-volume">
    <statement>
      <p>
      Calculate the volume of the region bounded by
      <m>x^2 + y^2 - z^2 + 5 = 0</m> and
      <m>x^2 + y^2 + z - 1 = 0</m>.
      </p>
    </statement>
    <solution component="hw6-solutions">
      <p>
      The surfaces are <m>z = \pm\sqrt{r^2+5}</m> and
      <m>z = 1-r^2</m>. Setting <m>r^2 = z^2-5</m> equal to
      <m>r^2 = 1-z</m> gives <m>z^2+z-6 = 0</m>, so <m>z = 2</m> or
      <m>z = -3</m>; only <m>z = -3</m> is possible, and then
      <m>r^2 = 4</m>. Therefore
      </p>

      <me>
      V = \int_0^{2\pi}\!\!\int_0^2\!\!\int_{-\sqrt{r^2+5}}^{1-r^2}
      r\,dz\,dr\,d\theta \approx 20.566 .
      </me>
    </solution>
  </problem>
  <problem xml:id="ex-hw6-hemisphere">
    <statement>
      <p>
      Evaluate the following integral:
      </p>

      <md>
      <mrow>
      \int_{0}^{6}\!\!\int_{-\sqrt{36-x^2}}^{\sqrt{36-x^2}}\!\!
      \int_{-\sqrt{36-x^2-z^2}}^{\sqrt{36-x^2-z^2}}
      \frac{1}{\left(x^2+y^2+z^2\right)^{1/2}}\;dy\,dz\,dx .
      </mrow>
      </md>
    </statement>
    <solution component="hw6-solutions">
      <p>
      The bounds describe the hemisphere <m>\rho \le 6</m>,
      <m>x \ge 0</m>. Since <m>dV = \rho^2\sin\phi\,
      d\rho\,d\phi\,d\theta</m> by <xref ref="eq-dv-spherical"/> and
      the integrand is
      <m>1/\rho</m>,
      </p>

      <md>
      <mrow>
      \int_{-\pi/2}^{\pi/2}\!\!\int_0^{\pi}\!\!\int_0^6
      \rho \sin\phi \,d\rho\,d\phi\,d\theta
      \amp = \pi \cdot \frac{6^2}{2}\cdot 2
      </mrow>
      <mrow>
      \amp = 36\pi \approx 113.097 .
      </mrow>
      </md>
    </solution>
  </problem>

  <problem xml:id="ex-hw6-convert-spherical">
    <statement>
      <p>
      Convert (do not evaluate) the following integral to
      <term>spherical</term> and <term>cylindrical</term> coordinates.
      Which set of coordinates is the most efficient for evaluating this
      integral?
      </p>

      <me>
      \int_{0}^{1}\!\!\int_{0}^{\sqrt{1-x^2}}\!\!
      \int_{-\sqrt{2-x^2-y^2}}^{-\sqrt{x^2+y^2}} dz\,dy\,dx
      </me>
    </statement>
    <solution component="hw6-solutions">
      <p>
        First read the region off the limits. The outer two say
        <m>0 \le x \le 1</m> and <m>0 \le y \le \sqrt{1-x^2}</m>, the
        quarter of the unit disk in the first quadrant, so
        <m>0 \le \theta \le \frac{\pi}{2}</m> and <m>0 \le r \le 1</m>. The
        inner limits run from the lower half of the sphere
        <m>x^2+y^2+z^2 = 2</m> up to the lower half of the cone
        <m>z = -\sqrt{x^2+y^2}</m>.
      </p>
      <p>
        <term>Cylindrical.</term> The two surfaces are
        <m>z = -\sqrt{2-r^2}</m> and <m>z = -r</m>, and
        <m>dV = r\,dz\,dr\,d\theta</m>, so
      </p>
      <me>
        \int_{0}^{\pi/2}\!\!\int_{0}^{1}\!\!
        \int_{-\sqrt{2-r^2}}^{-r} r\,dz\,dr\,d\theta .
      </me>
      <p>
        <term>Spherical.</term> The sphere is <m>\rho = \sqrt2</m>. The
        cone <m>z = -\sqrt{x^2+y^2}</m> makes a <m>45^\circ</m> angle with
        the negative <m>z</m>-axis, so it is <m>\phi = \frac{3\pi}{4}</m>,
        and the region is everything between that cone and the negative
        <m>z</m>-axis, out to the sphere:
      </p>
      <me>
        \int_{0}^{\pi/2}\!\!\int_{3\pi/4}^{\pi}\!\!
        \int_{0}^{\sqrt2} \rho^2\sin\phi\,d\rho\,d\phi\,d\theta .
      </me>
      <p>
        Note that the condition <m>r \le 1</m> needs no separate limit in
        spherical coordinates: the sphere meets the cone at
        <m>r = \sqrt2\,\sin\frac{3\pi}{4} = 1</m>, exactly the edge of the
        quarter disk.
      </p>
      <p>
        <term>Which is more efficient?</term> Spherical, because all six
        limits are constants<mdash/>the region is a solid cone of radius
        <m>\sqrt2</m>, and the integrand <m>\rho^2\sin\phi</m> separates
        into a product of one-variable factors. In cylindrical coordinates
        the <m>z</m>-limits still depend on <m>r</m>, and the resulting
        <m>r</m>-integral needs a substitution.
      </p>
    </solution>
  </problem>


  <problem xml:id="ex-hw6-wedge">
    <statement>
      <p>
      Find the volume of the wedge-shaped region <m>\mathcal{W}</m>
      contained in the cylinder <m>x^2 + y^2 = 9</m>, bounded above by the
      plane <m>z = x</m> and below by the <m>xy</m>-plane.
      </p>
    </statement>
    <solution component="hw6-solutions">
      <p>
      The wedge is shown in <xref ref="fig-hw6-wedge"/>.
      </p>
      <figure xml:id="fig-hw6-wedge">
        <caption>
          The wedge of <xref ref="ex-hw6-wedge"/>: inside the cylinder
          <m>x^2 + y^2 = 9</m>, above the <m>xy</m>-plane and below the plane
          <m>z = x</m>.
        </caption>
        <image xml:id="image-hw6-wedge" width="60%">
          <shortdescription>
            A wedge standing on a half disk in the xy-plane: its curved side is part of
            a cylinder and its sloping top is the plane z equals x.
          </shortdescription>
          <description>
            <p>
              A solid wedge. Its base is the half of the disk of radius 3 centered at
              the origin that lies on the side x greater than or equal to zero, shaded
              orange and labelled D. Its curved side is the piece of the cylinder over the
              semicircle, drawn in translucent blue, and its top is the sloping plane z
              equals x, which meets the base along the diameter on the y axis and rises
              to height 3 at the point (3,0,3) on the x axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
                      \definecolor{oiblue}{RGB}{0,114,178}
                      \definecolor{oiorange}{RGB}{213,94,0}
                      \begin{axis}[
                          view={40}{22},
                          width=11cm,
                          axis lines=center,
                          axis line style={-latex, black!70, line width=0.7pt},
                          xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
                          label style={font=\large},
                          ticks=none,
                          xmin=-0.4, xmax=1.55, ymin=-1.4, ymax=1.4, zmin=0, zmax=1.35,
                          clip=false,
                        ]
                        % ---- base: the half disk D in the xy-plane ----
                        \addplot3[surf, shader=flat, color=oiorange!25, opacity=0.5, fill opacity=0.5,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=2,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, 0);
                        % ---- curved cylinder wall x^2+y^2=R^2, from z=0 up to z=x ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!25,
                                  colormap={wallz}{color=(oiblue!10!white) color=(oiblue!45!white)},
                                  opacity=0.55, fill opacity=0.55,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({cos(x)}, {sin(x)}, {y*cos(x)});
                        % ---- top: the plane z = x over D ----
                        \addplot3[surf, shader=faceted, faceted color=oiblue!30,
                                  colormap={topz}{color=(oiblue!18!white) color=(oiblue!55!white)},
                                  opacity=0.7, fill opacity=0.7,
                                  domain=-90:90, samples=40, y domain=0:1, samples y=8,
                                  z buffer=sort, forget plot]
                          ({y*cos(x)}, {y*sin(x)}, {y*cos(x)});
                        % ---- edges ----
                        \addplot3[black!65, dashed, line width=1.1pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, 0);
                        \addplot3[oiblue, line width=1.6pt, samples=80, samples y=0,
                                  domain=-90:90, forget plot] ({cos(x)}, {sin(x)}, {cos(x)});
                        \draw[oiblue, line width=1.2pt] (axis cs:0,-1,0) -- (axis cs:0,1,0);
                        \draw[oiblue, line width=1.2pt] (axis cs:1,0,0) -- (axis cs:1,0,1);
                        % ---- labels ----
                        \node[anchor=north, font=\small] at (axis cs:1,0,-0.05) {$3$};
                        \node[anchor=south west, font=\small] at (axis cs:1,0,1) {$(3,0,3)$};
                        \node[oiblue, font=\large, anchor=south west]
                          at (axis description cs:0.02,0.86) {$z = x$};
                        \node[oiorange!80!black, font=\small] at (axis cs:0.5,-0.45,0) {$\mathcal{D}$};
                      \end{axis}
                    \end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
      <p>
      The wedge is bounded below by <m>z = 0</m> and above by <m>z = x</m>,
      so <m>0 \le z \le x</m>; in particular <m>x \ge 0</m>, and the wedge
      projects onto the half disk <m>\mathcal{D}</m> of radius <m>3</m>
      with <m>x \ge 0</m> (<xref ref="fig-hw6-wedge-D"/>). In polar
      coordinates
      </p>
      <me>
      \mathcal{D}:\ -\frac{\pi}{2} \le \theta \le \frac{\pi}{2},\ 0 \le r \le 3 ,
      </me>
      <p>
      and the top surface is <m>z = x = r\cos\theta</m>. So in cylindrical
      coordinates
      </p>
      <me>
      \mathcal{W}:\ -\frac{\pi}{2} \le \theta \le \frac{\pi}{2},\
      0 \le r \le 3,\ 0 \le z \le r\cos\theta .
      </me>
      <figure xml:id="fig-hw6-wedge-D">
        <caption>
          The projection <m>\mathcal{D}</m> of the wedge of <xref ref="ex-hw6-wedge"/> onto the <m>xy</m>-plane: the half of the disk of radius <m>3</m> with <m>x \ge 0</m>, described in polar coordinates by <m>-\pi/2 \le \theta \le \pi/2</m>, <m>0 \le r \le 3</m>. Above a point of <m>\mathcal{D}</m> the wedge runs from <m>z = 0</m> up to <m>z = x = r\cos\theta</m>.
        </caption>
        <image width="45%">
          <shortdescription>
          A shaded half disk to the right of the y axis, with a ray from the origin at angle theta ending on the semicircle.
          </shortdescription>
          <description>
            <p>
            Coordinate axes with the right half of the disk of radius 3 shaded tan and labelled D. Its straight edge is the segment of the y axis from theta equals minus pi over two to theta equals pi over two, and its curved edge is the semicircle r equals 3. A green ray from the origin at an angle theta marks a sample radius r.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw6-wedge-D">
            <diagram dimensions="(260,320)" margins="10">
              <definition>semi(t) = (cos(t), sin(t))</definition>
              <coordinates bbox="(-0.6,-1.35,1.6,1.35)">
              <axes at="hw6-wedge-D-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
              <polygon at="hw6-wedge-D-region" fill="#fbe3d0" stroke="none" closed="yes" points="((6.123e-17,-1),(0.05234,-0.9986),(0.1045,-0.9945),(0.1564,-0.9877),(0.2079,-0.9781),(0.2588,-0.9659),(0.309,-0.9511),(0.3584,-0.9336),(0.4067,-0.9135),(0.454,-0.891),(0.5,-0.866),(0.5446,-0.8387),(0.5878,-0.809),(0.6293,-0.7771),(0.6691,-0.7431),(0.7071,-0.7071),(0.7431,-0.6691),(0.7771,-0.6293),(0.809,-0.5878),(0.8387,-0.5446),(0.866,-0.5),(0.891,-0.454),(0.9135,-0.4067),(0.9336,-0.3584),(0.9511,-0.309),(0.9659,-0.2588),(0.9781,-0.2079),(0.9877,-0.1564),(0.9945,-0.1045),(0.9986,-0.05234),(1,-2.22e-16),(0.9986,0.05234),(0.9945,0.1045),(0.9877,0.1564),(0.9781,0.2079),(0.9659,0.2588),(0.9511,0.309),(0.9336,0.3584),(0.9135,0.4067),(0.891,0.454),(0.866,0.5),(0.8387,0.5446),(0.809,0.5878),(0.7771,0.6293),(0.7431,0.6691),(0.7071,0.7071),(0.6691,0.7431),(0.6293,0.7771),(0.5878,0.809),(0.5446,0.8387),(0.5,0.866),(0.454,0.891),(0.4067,0.9135),(0.3584,0.9336),(0.309,0.9511),(0.2588,0.9659),(0.2079,0.9781),(0.1564,0.9877),(0.1045,0.9945),(0.05234,0.9986),(5.053e-16,1))"/>
              <parametric-curve at="hw6-wedge-D-arc" function="semi" domain="(-pi/2,pi/2)" stroke="#0072B2" thickness="3"/>
              <line at="hw6-wedge-D-diam" endpoints="((0,-1),(0,1))" stroke="#0072B2" thickness="3"/>
              <line at="hw6-wedge-D-ray" endpoints="((0,0),(0.8776,0.4794))" stroke="#009E73" thickness="2"/>
              <arc at="hw6-wedge-D-angle" center="(0,0)" radius="0.3" range="(0,28.6)" stroke="#009E73" thickness="2"/>
              <point at="hw6-wedge-D-top" p="(0,1)" fill="black" size="3.5"/>
              <point at="hw6-wedge-D-bot" p="(0,-1)" fill="black" size="3.5"/>
              <point at="hw6-wedge-D-end" p="(0.8776,0.4794)" fill="#009E73" size="3.5"/>
              <label at="hw6-wedge-D-toplab" anchor="(0,1)" alignment="nw" offset="(-3,4)"><m>\theta=\tfrac{\pi}{2}</m></label>
              <label at="hw6-wedge-D-botlab" anchor="(0,-1)" alignment="sw" offset="(-3,-4)"><m>\theta=-\tfrac{\pi}{2}</m></label>
              <label at="hw6-wedge-D-rlab" anchor="(0.55,0.08)" alignment="se" color="#009E73"><m>r</m></label>
              <label at="hw6-wedge-D-tlab" anchor="(0.34,0.06)" alignment="ne" color="#009E73"><m>\theta</m></label>
              <label at="hw6-wedge-D-Rlab" anchor="(1,0)" alignment="se" offset="(4,-4)" color="#0072B2"><m>r=3</m></label>
              <label at="hw6-wedge-D-Dlab" anchor="(0.45,-0.5)" alignment="c"><m>\mathcal{D}</m></label>
              </coordinates>
              <annotations>
              <annotation ref="figure" text="The half disk D of radius 3 on the side x greater than or equal to zero, the shadow of the wedge.">
                <annotation ref="hw6-wedge-D-region" text="The shaded half disk D."/>
                <annotation ref="hw6-wedge-D-arc" text="The semicircle r equals 3, from theta equals minus pi over two to pi over two." sonify="yes"/>
                <annotation ref="hw6-wedge-D-diam" text="The straight edge of D along the y axis, where the top plane z equals x meets the base."/>
                <annotation ref="hw6-wedge-D-ray" text="A sample ray at angle theta, with r running from zero to 3."/>
              </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>
      <p>
      The volume is <m>\iiint_{\mathcal{W}} 1\,dV</m>, and with
      <m>dV = r\,dz\,dr\,d\theta</m> by <xref ref="eq-dv-cylindrical"/>,
      </p>
      <md>
      <mrow>
      V \amp = \int_{-\pi/2}^{\pi/2}\!\!\int_0^{3}\!\!\int_0^{r\cos\theta}
      r\,dz\,dr\,d\theta
      = \int_{-\pi/2}^{\pi/2}\!\!\int_0^{3} r^2\cos\theta\,dr\,d\theta
      </mrow>
      <mrow>
      \amp = \frac{27}{3}\int_{-\pi/2}^{\pi/2} \cos\theta\,d\theta
      = 9\Big[\sin\theta\Big]_{-\pi/2}^{\pi/2}
      = 18 .
      </mrow>
      </md>
      <p>
      In general, a cylinder of radius <m>R</m> gives <m>V = 2R^3/3</m>.
      </p>
    </solution>
  </problem>
</section>
