<!-- MATH 14 - HW10: the divergence theorem.  Its three Stokes' theorem      -->
<!-- problems moved to Assignment 9.  The auto-graded version, with           -->
<!-- randomized constants, is hw10-online.ptx (which also carries "One Field, -->
<!-- Three Theorems").                                                        -->
<section xml:id="sec-exercises-hw10" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 10</title>

  <introduction>
    <p>
      Section: <xref ref="section-divergence-theorem" text="title"/>.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw10">

  <exercise xml:id="ex-hw10-divergence-box">
    <statement>
      <p>
        Compute the flux
        <m>\displaystyle\iint_S \mathbf{F} \cdot \hat{\mathbf{n}}\,
        d\sigma</m>, where
        <m>\mathbf{F} = \left\langle \sin(\pi x),\ zy^3,\ z^2 + 4x
        \right\rangle</m> and <m>S</m> is the surface of the box
        <m>-1 \le x \le 2</m>, <m>0 \le y \le 1</m>,
        <m>1 \le z \le 4</m>, with <m>\hat{\mathbf{n}}</m> pointing
        outward.
      </p>
    </statement>
  </exercise>

  </exercises>
</section>
