<!-- MATH 14 - Assignment 5, the version WITH solutions.                        -->
<!--                                                                        -->
<!-- Statements come from the written assignment, solutions from the auto-   -->
<!-- graded version; each problem is a <problem> whose <solution> is printed -->
<!-- directly beneath it.  The auto-graded version is hw5-online.ptx.        -->
<!--                                                                        -->
<!-- HIDING THE SOLUTIONS.  Every <solution> here carries                    -->
<!--   component="hw5-solutions"                                            -->
<!-- so this assignment's solutions can be switched off from                 -->
<!-- publication/publication.ptx; see the comment in <source> there.         -->
<section xml:id="sec-solutions-hw5" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 5</title>

    <p>
    Sections: <xref ref="section-polar-coordinates" text="title"/> and
    <xref ref="section-double-integrals-polar-form" text="title"/>.
    </p>

  <p>
    Work each problem yourself first; the full solution follows immediately
    below it. The auto-graded version of the same problems is
    <xref ref="sec-exercises-hw5-online" text="title"/>.
  </p>

  <problem xml:id="ex-hw5-rose">
    <statement>
      <p>
      Consider the polar equation <m>r(\theta) = 1 + \sin(3\theta)</m>,
      <m>\frac{\pi}{6} \le \theta \le \frac{5\pi}{6}</m>.
      </p>
      <p>
      (a) Determine the type of symmetry that its graph possesses.
      </p>
      <p>
      (b) Sketch its graph. Use the polar chart of
      <xref ref="fig-hw5-polar-chart"/>.
      </p>
      <p>
      (c) Set up (do not evaluate) the integral necessary for computing the
      area bounded by <m>r = 1 + \sin(3\theta)</m>,
      <m>\frac{\pi}{6} \le \theta \le \frac{5\pi}{6}</m>.
      </p>
    </statement>
    <solution component="hw5-solutions">
      <p>
      Replacing <m>\theta</m> by <m>\pi - \theta</m> gives
      <m>1+\sin(3\pi-3\theta) = 1+\sin(\pi-3\theta)
      = 1+\sin(3\theta)</m>, so <m>r</m> is unchanged: the graph is
      symmetric about the <m>y</m>-axis. The area is
      </p>

      <me>
      A = \int_{\pi/6}^{5\pi/6}\!\!\int_{0}^{1+\sin(3\theta)}
      r\,dr\,d\theta ,
      </me>

      <p>
      which by the symmetry is also
      <m>2\int_{\pi/6}^{\pi/2}\int_0^{1+\sin(3\theta)}
      r\,dr\,d\theta</m>.
      </p>
    </solution>
  </problem>

  <figure xml:id="fig-hw5-polar-chart">
      <caption>
        A blank polar chart for part (b) of <xref ref="ex-hw5-rose"/>. The circles are
        <m>r = 0.5</m>, <m>1</m>, <m>1.5</m>, and <m>2</m>, and the spokes are
        spaced <m>\pi/6</m> apart.
      </caption>
      <image width="70%">
        <shortdescription>
        A blank polar grid of four circles and twelve labeled spokes.
        </shortdescription>
        <prefigure xmlns="https://prefigure.org" label="prefigure-hw5-chart">
          <diagram dimensions="(340,340)" margins="10">
            <definition>c1(t) = (0.5*cos(t), 0.5*sin(t))</definition>
            <definition>c2(t) = (cos(t), sin(t))</definition>
            <definition>c3(t) = (1.5*cos(t), 1.5*sin(t))</definition>
            <definition>c4(t) = (2*cos(t), 2*sin(t))</definition>
            <coordinates bbox="(-2.55,-2.55,2.55,2.55)">
              <parametric-curve at="pc-c1" function="c1" domain="(0,2*pi)" stroke="#bbbbbb" thickness="1"/>
              <parametric-curve at="pc-c2" function="c2" domain="(0,2*pi)" stroke="#bbbbbb" thickness="1"/>
              <parametric-curve at="pc-c3" function="c3" domain="(0,2*pi)" stroke="#bbbbbb" thickness="1"/>
              <parametric-curve at="pc-c4" function="c4" domain="(0,2*pi)" stroke="#888888" thickness="1"/>
              <repeat at="pc-spokes" parameter="k=0..5">
                <line at="pc-spoke-((k))" endpoints="((2*cos(pi*k/6), 2*sin(pi*k/6)),(-2*cos(pi*k/6), -2*sin(pi*k/6)))" stroke="#cccccc" thickness="1"/>
              </repeat>
              <label at="pc-t0" anchor="(2.12,0)" alignment="e"><m>0</m></label>
              <label at="pc-t1" anchor="(1.84,1.06)" alignment="e">
                <m>\pi/6</m>
              </label>
              <label at="pc-t2" anchor="(1.06,1.84)" alignment="ne">
                <m>\pi/3</m>
              </label>
              <label at="pc-t3" anchor="(0,2.12)" alignment="n">
                <m>\pi/2</m>
              </label>
              <label at="pc-t4" anchor="(-1.06,1.84)" alignment="nw">
                <m>2\pi/3</m>
              </label>
              <label at="pc-t5" anchor="(-1.84,1.06)" alignment="w">
                <m>5\pi/6</m>
              </label>
              <label at="pc-t6" anchor="(-2.12,0)" alignment="w"><m>\pi</m></label>
              <label at="pc-t7" anchor="(-1.84,-1.06)" alignment="w">
                <m>7\pi/6</m>
              </label>
              <label at="pc-t8" anchor="(-1.06,-1.84)" alignment="sw">
                <m>4\pi/3</m>
              </label>
              <label at="pc-t9" anchor="(0,-2.12)" alignment="s">
                <m>3\pi/2</m>
              </label>
              <label at="pc-t10" anchor="(1.06,-1.84)" alignment="se">
                <m>5\pi/3</m>
              </label>
              <label at="pc-t11" anchor="(1.84,-1.06)" alignment="e">
                <m>11\pi/6</m>
              </label>
              <label at="pc-r1" anchor="(0.08,0.5)" alignment="ne" color="#666666"><m>0.5</m></label>
              <label at="pc-r2" anchor="(0.08,1)" alignment="ne" color="#666666"><m>1</m></label>
              <label at="pc-r3" anchor="(0.08,1.5)" alignment="ne" color="#666666"><m>1.5</m></label>
