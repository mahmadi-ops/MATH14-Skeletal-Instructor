          <diagram dimensions="(460,340)" margins="8">
            <definition>arc3(t) = (2.6 + 1.3*cos(t), 4.6 + 1.3*sin(t))</definition>
            <definition>arc4(t) = (7.4 + 1.3*cos(t), 4.6 + 1.3*sin(t))</definition>
            <coordinates bbox="(0.2,-0.9,9.9,7.6)">
              <!-- shape 1: above y = x, cut by y = r -->
              <polygon at="hs1" closed="yes" fill="#c9c9c9" stroke="#555555" thickness="2" points="((1.3,1.0),(2.6,2.3),(1.3,2.3))"/>
              <line at="hs1-x" endpoints="((0.5,1.0),(3.4,1.0))" stroke="black" thickness="1"/>
              <line at="hs1-y" endpoints="((1.3,0.2),(1.3,2.9))" stroke="black" thickness="1"/>
              <line at="hs1-diag" endpoints="((1.3,1.0),(3.0,2.7))" stroke="#777777" thickness="1" dash="4 3"/>
              <line at="hs1-cut" endpoints="((0.9,2.3),(2.9,2.3))" stroke="#777777" thickness="1" dash="4 3"/>
              <label at="hs1-lab" anchor="(1.75,1.75)" alignment="center">
                <m>1</m>
              </label>
              <label at="hs1-yr" anchor="(2.95,2.3)" alignment="e" color="#555555"><m>y=r</m></label>
              <label at="hs1-diaglab" anchor="(3.05,2.72)" alignment="ne" color="#555555"><m>y=x</m></label>
              <!-- shape 2: below y = x, cut by x = r -->
              <polygon at="hs2" closed="yes" fill="#c9c9c9" stroke="#555555" thickness="2" points="((6.1,1.0),(7.4,1.0),(7.4,2.3))"/>
              <line at="hs2-x" endpoints="((5.3,1.0),(8.2,1.0))" stroke="black" thickness="1"/>
              <line at="hs2-y" endpoints="((6.1,0.2),(6.1,2.9))" stroke="black" thickness="1"/>
              <line at="hs2-diag" endpoints="((6.1,1.0),(7.8,2.7))" stroke="#777777" thickness="1" dash="4 3"/>
              <line at="hs2-cut" endpoints="((7.4,0.5),(7.4,2.6))" stroke="#777777" thickness="1" dash="4 3"/>
              <label at="hs2-lab" anchor="(7.0,1.45)" alignment="center">
                <m>2</m>
              </label>
              <label at="hs2-xr" anchor="(7.45,0.45)" alignment="se" color="#555555"><m>x=r</m></label>
              <label at="hs2-diaglab" anchor="(7.85,2.72)" alignment="ne" color="#555555"><m>y=x</m></label>
              <!-- shape 3: the sector between y = x and the y-axis -->
              <polygon at="hs3" closed="yes" fill="#c9c9c9" stroke="none" points="((2.6,4.6),(3.52,5.52),(3.32,5.85),(3.06,6.09),(2.75,6.24),(2.6,5.9))"/>
              <parametric-curve at="hs3-arc" function="arc3" domain="(pi/4,pi/2)" stroke="#555555" thickness="2"/>
              <line at="hs3-x" endpoints="((1.8,4.6),(4.7,4.6))" stroke="black" thickness="1"/>
              <line at="hs3-y" endpoints="((2.6,3.8),(2.6,6.7))" stroke="black" thickness="1"/>
              <line at="hs3-diag" endpoints="((2.6,4.6),(4.3,6.3))" stroke="#777777" thickness="1" dash="4 3"/>
              <label at="hs3-lab" anchor="(2.98,5.42)" alignment="center">
