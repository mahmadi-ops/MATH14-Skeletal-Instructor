<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW4, online version: the same problems as the written       -->
<!-- Assignment 4, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw4-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 4</title>

  <introduction>
    <p>
      Sections: <xref ref="section-conservative-fields" text="title"/>, <xref ref="section-double-integrals-rectangles" text="title"/>, and <xref ref="section-double-integrals-general-regions" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw4-online">

  <figure xml:id="fig-hw4o-paths">
    <caption>
      The vector field <m>\mathbf{F}</m> and the two paths <m>ADC</m> and
      <m>ABC</m> of <xref ref="ex-hw4o-two-paths"/>. Every field vector
      points in the same direction; only their lengths change.
    </caption>
    <image width="70%">
      <shortdescription>
      A uniform slanted field with a square path from corner A to corner B.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw4o-paths">
        <diagram dimensions="(360,320)" margins="10">
          <definition>G(x,y) = (0.16*(1+x), 0.16*(1+x))</definition>
          <coordinates bbox="(-0.3,-0.3,3.3,3.0)">
            <axes at="hp-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <repeat at="hp-cols" parameter="i=0..6">
              <repeat parameter="j=0..5">
                <vector at="hp-v-((i))-((j))" v="G(0.45*i+0.12, 0.5*j+0.12)"
                    tail="(0.45*i+0.12, 0.5*j+0.12)" stroke="#56B4E9"
                    thickness="2"/>
              </repeat>
            </repeat>
            <polygon at="hp-square" closed="yes" stroke="#CC0079" thickness="3"
                fill="none" points="((0.8,0.7),(2.4,0.7),(2.4,2.3),(0.8,2.3))"/>
            <point at="hp-A" p="(0.8,0.7)" fill="black" alignment="sw">
              <m>A</m>
            </point>
            <point at="hp-D" p="(2.4,0.7)" fill="black" alignment="se">
              <m>D</m>
            </point>
            <point at="hp-C" p="(2.4,2.3)" fill="black" alignment="ne">
              <m>C</m>
            </point>
            <point at="hp-B" p="(0.8,2.3)" fill="black" alignment="nw">
              <m>B</m>
            </point>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A grid of light blue field vectors, all pointing up and to the right at the same angle, with lengths that grow as x increases. A magenta square is drawn with corners A at the lower left, D at the lower right, C at the upper right and B at the upper left, so the path A D C runs along the bottom and up the right side, while A B C runs up the left side and along the top.">
              <annotation ref="hp-cols" text="The field vectors, all parallel and pointing up and to the right, growing longer toward the right of the picture."/>
              <annotation ref="hp-square" text="The square whose corners are A, B, C and D; the two paths of the problem run along its sides."/>
              <annotation ref="hp-A" text="The corner A, at the lower left."/>
              <annotation ref="hp-D" text="The corner D, at the lower right; the path A D C passes through it."/>
              <annotation ref="hp-C" text="The corner C, at the upper right."/>
              <annotation ref="hp-B" text="The corner B, at the upper left; the path A B C passes through it."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw4o-two-paths">
    <title>Which Path Takes Less Work?</title>
    <statement>
      <p>
        For the field of <xref ref="fig-hw4o-paths"/>: over which path does
        <m>\mathbf{F}</m> perform less work? Type <c>ADC</c> or
        <c>ABC</c>.
      </p>
      <p>Answer: <var width="8"/></p>
      <p>Is <m>\mathbf{F}</m> conservative? Type <c>yes</c> or <c>no</c>.</p>
      <p>Answer: <var width="8"/></p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="abc">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="adc">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="no">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string="yes">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw4-solutions">
      <p>
        Both paths run along two sides of the square. The horizontal sides
        <m>AD</m> and <m>BC</m> contribute the same, but the vertical side
        <m>DC</m> sits where the field is longer than it is along
        <m>AB</m>, and the angle between <m>\mathbf{F}</m> and
        <m>\hat{\mathbf{T}}</m> is the same on both. Hence
        <m>\int_{ADC} \gt \int_{ABC}</m>, so <m>ABC</m> is the path of
        less work.
      </p>
      <p>
        Because the two paths share their endpoints and give different
        work, <m>\mathbf{F}</m> is <term>not</term> conservative: a
        conservative field is path-independent.
      </p>
    </solution>
  </exercise>

