            \addplot3[only marks, mark=*, red, mark size=1.5pt] coordinates {(0,0,0)};
          \end{axis}
          \end{tikzpicture}
        </latex-image>
      </image>
    </figure>
  </subsection>

  <!-- ================================================================= -->
  <subsection xml:id="subsec-work-reminder">
    <title>Work (Reminder)</title>

    <p>
      Our goal is to study the line integral of a vector field over a curve
      <m>C</m>, and we will do so using an example from physics: calculating
      the amount of work done by a force <m>\mathbf{F}</m>, which in general
      can be a function of <m>x</m>, <m>y</m>, and <m>z</m>. Before we
      present the example, let us remind ourselves of the definition of
      work. Consider a box being pulled by a constant force
      <m>\mathbf{F}</m>, as shown in <xref ref="fig-work-reminder"/>.
    </p>

    <figure xml:id="fig-work-reminder">
      <caption>
        A box pulled by a constant force <m>\mathbf{F}</m> applied at an
        angle <m>\alpha</m>. The displacement <m>\delta x</m> is measured
        below the ground line, from the centre of mass of the box in its
        initial position to its centre of mass in the final position (the
        faint box). Only the component
        <m>\left\lVert\mathbf{F}\right\rVert\cos(\alpha)\,\mathbf{i}</m>
        along the motion does work.
      </caption>
      <image xml:id="image-work-reminder" width="80%">
        <shortdescription>
          A box on a horizontal line pulled by a tilted force arrow, with
          the horizontal component of the force and the displacement marked.
        </shortdescription>
        <description>
          <p>
            A horizontal line represents the ground, with a small box
            sitting on it at the left. A red arrow labelled F points up and
            to the right from the top of the box, making an angle alpha with
            the horizontal; a small arc marks the angle. A shorter blue
            horizontal arrow labelled the magnitude of F times cosine alpha,
            times i, shows the horizontal component of the force. A faint
            second box to the right marks the final position. The centre of
            each box is marked with a dot, and a dashed vertical line drops
            from each centre to a dashed double-headed arrow drawn below the
            ground line and labelled delta x, so the displacement is
            measured from one centre of mass to the other.
          </p>
        </description>
        <prefigure xmlns="https://prefigure.org" label="work-reminder">
          <diagram dimensions="(560,300)" margins="5">
            <coordinates bbox="(-0.8,-1.7,6.7,3.0)" aspect-ratio="1">
              <group at="ground">
                <line endpoints="((-0.5,0), (6.3,0))" stroke="black"
                      thickness="2" arrows="1"/>
              </group>

              <group at="boxes">
                <rectangle lower-left="(0.3,0)" dimensions="(0.5,0.6)"
                           stroke="black" fill="#d9d9d9" thickness="2"/>
                <rectangle lower-left="(4.9,0)" dimensions="(0.5,0.6)"
                           stroke="#b3b3b3" fill="#f2f2f2" thickness="2"/>
              </group>

              <group at="force">
                <vector v="(1.157,1.379)" tail="(0.55,0.6)" stroke="red"
                        thickness="3" arrow-width="6"/>
                <label anchor="(1.78,2.02)" alignment="e" color="red">
                  <m>\mathbf{F}</m>
                </label>
                <arc center="(0.55,0.6)" radius="0.62" range="(0,50)"
                     stroke="black" thickness="1"/>
                <label anchor="(1.58,1.02)" alignment="c">
                  <m>\alpha</m>
                </label>
              </group>

              <group at="component">
                <vector v="(1.157,0)" tail="(0.55,0.6)" stroke="blue"
                        thickness="3" arrow-width="6"/>
                <label anchor="(1.80,0.30)" alignment="e" color="blue">
                  <m>\left\lVert\mathbf{F}\right\rVert\cos(\alpha)\,\mathbf{i}</m>
                </label>
              </group>

              <group at="displacement">
                <point p="(0.55,0.3)" size="3.5" stroke="black" fill="black"/>
                <point p="(5.15,0.3)" size="3.5" stroke="#8c8c8c"
                       fill="#8c8c8c"/>
                <line endpoints="((0.55,0.3), (0.55,-0.85))" stroke="#8c8c8c"
                      thickness="1" dash="4 3"/>
                <line endpoints="((5.15,0.3), (5.15,-0.85))" stroke="#8c8c8c"
                      thickness="1" dash="4 3"/>
                <line endpoints="((0.55,-0.68), (5.15,-0.68))"
                      stroke="#009E73" thickness="3" dash="7 4" arrows="2"/>
                <label anchor="(2.85,-1.2)" alignment="c" color="#009E73">
                  <m>\delta x</m>
                </label>
              </group>
            </coordinates>

            <annotations>
              <annotation ref="figure"
                          text="A box on the ground pulled by a force applied
                                at an angle alpha, with the displacement
                                measured from one centre of mass to the
                                other">
                <annotation ref="ground" text="The ground the box slides on"/>
                <annotation ref="boxes"
                            text="The box in its initial position and, faintly,
                                  in its final position"/>
                <annotation ref="force"
                            text="The force F, applied at an angle alpha to
                                  the direction of motion"/>
                <annotation ref="component"
                            text="The component of the force along the
                                  motion, the magnitude of F times cosine
                                  alpha"/>
                <annotation ref="displacement"
                            text="The displacement delta x, measured below the
                                  ground line from the centre of mass of the
                                  box in its initial position to its centre of
                                  mass in the final position"/>
              </annotation>
            </annotations>
          </diagram>
        </prefigure>
      </image>
    </figure>

    <p>
      The amount of work done by the force is equal to the magnitude of the
      force in the direction of motion,
      <m>\left\lVert\mathbf{F}\right\rVert\cos(\alpha)</m>, multiplied by the amount
      of displacement <m>\delta x</m>:
      <md>
        <mrow xml:id="eq-work-constant" number="yes">
          \text{Work}
            =\left\lVert\mathbf{F}\right\rVert\cos(\alpha)\times\delta x
            =\mathbf{F}\cdot\left(\delta x\,\mathbf{i}\right).
        </mrow>
      </md>
      The last equality holds because the motion is in the
      <m>+x</m>-direction, which lets us rewrite
      <m>\left\lVert\mathbf{F}\right\rVert\cos(\alpha)\times\delta x</m> as the dot
      product <m>\mathbf{F}\cdot(\delta x\,\mathbf{i})</m>. This dot-product
      form is the one that generalizes: <em>work is the dot product of the
      force with the displacement</em>.
    </p>
  </subsection>

  <!-- ================================================================= -->
  <subsection xml:id="subsec-work-force-field">
    <title>Work of a Force Field</title>

    <p>
      Let us now consider the situation where a force <m>\mathbf{F}(x,y)</m>
      is acting on an object and causing it to move along a curved
      trajectory from an initial point to a final point. Neither the force
      nor the direction of motion is constant anymore, so we cannot apply
      <xref ref="eq-work-constant"/> directly. Instead, we reuse the strategy of
      <xref ref="sec-line-integrals"/>: calculate the work on small subarcs
      of the trajectory, where force and direction are nearly constant, and
      then sum up. <xref ref="fig-work-subarc"/> shows one such subarc.
    </p>

    <figure xml:id="fig-work-subarc">
      <caption>
        On the <m>k</m>th subarc, of length <m>\Delta s_k</m>, the direction
        of motion is the unit tangent vector <m>\mathbf{T}_k</m> (green) and
        the force is approximately <m>\mathbf{F}(x_k,y_k)</m> (red). Only
        the tangential component of the force does work.
      </caption>
      <image xml:id="image-work-subarc" width="55%">
        <shortdescription>
          A curved trajectory with one short subarc highlighted, showing the
          force vector and the unit tangent vector at a point.
        </shortdescription>
        <description>
          <p>
            A black curve rises from a red point near the origin, bending
            upward to a red endpoint at the upper right. A short piece of
            the curve, labelled Delta s sub k, is drawn thicker in blue.
            At a black point on this piece, a red arrow labelled F of (x sub
            k, y sub k) points steeply up and to the right, and a shorter
            green arrow labelled T sub k points along the curve in the
            direction of motion.
          </p>
        </description>
        <prefigure xmlns="https://prefigure.org" label="work-subarc">
          <diagram dimensions="(400,420)" margins="5">
            <definition>q(t) = (t, 0.5+0.5*t^2)</definition>
            <definition>tk = 0.52</definition>
            <coordinates bbox="(-0.35,-0.35,3.1,3.2)" aspect-ratio="1">
              <axes at="ax" xlabel="x" ylabel="y" decorations="no"
                    arrows="1"/>

              <group at="curve">
                <parametric-curve function="q" domain="(0,2)" stroke="black"
                                  thickness="3"/>
              </group>

              <group at="ends">
                <point p="q(0)" size="4" stroke="red" fill="red"/>
                <point p="q(2)" size="4" stroke="red" fill="red"/>
              </group>

              <group at="subarc">
                <parametric-curve function="q" domain="(0.34,0.74)"
                                  stroke="blue" thickness="8"/>
                <label anchor="(0.55,0.30)" alignment="center" color="blue">
                  <m>\Delta s_k</m>
                </label>
                <line endpoints="((0.55,0.40), (0.55,0.58))"
                      stroke="blue" thickness="1"/>
              </group>

              <group at="vectors">
                <point p="q(tk)" size="4" stroke="black" fill="black"/>
                <vector v="(0.42,1.19)" tail="q(tk)" stroke="red"
                        thickness="3" arrow-width="6"/>
                <label anchor="(0.94,1.86)" alignment="nw" color="red">
                  <m>\mathbf{F}(x_k,y_k)</m>
                </label>
                <vector v="(0.78,0.41)" tail="q(tk)" stroke="#009E73"
                        thickness="3" arrow-width="6"/>
                <label anchor="(1.32,1.03)" alignment="e" offset="(6,-4)"
                       color="#009E73">
                  <m>\mathbf{T}_k</m>
                </label>
              </group>
            </coordinates>

            <annotations>
              <annotation ref="figure"
                          text="A curved trajectory with one short subarc
                                highlighted, carrying the force vector and the
                                unit tangent vector at a sample point">
                <annotation ref="ax" text="The coordinate axes"/>
                <annotation ref="curve"
                            text="The trajectory of the object"
                            sonify="yes"/>
                <annotation ref="ends"
                            text="The initial and final points of the
                                  trajectory"/>
                <annotation ref="subarc"
                            text="The kth subarc, of length delta s sub k,
                                  drawn in blue"/>
                <annotation ref="vectors"
                            text="At a sample point of that subarc, the force
                                  F of x sub k, y sub k and the unit tangent
                                  vector T sub k, which gives the direction of
                                  motion"/>
              </annotation>
            </annotations>
          </diagram>
        </prefigure>
      </image>
    </figure>

    <p>
      Build the work integral from the subarcs. (On the <m>k</m>th subarc
      the displacement has length <m>\Delta s_k</m> and direction
      <m>\mathbf{T}_k</m>, so the dot-product form of
      <xref ref="eq-work-constant"/> gives the work done along it. Sum
      over the subarcs and let <m>n \to \infty</m>. Then use
      <m>\mathbf{T} = \mathbf{v}/\lVert\mathbf{v}\rVert
      = \frac{d\mathbf{r}/dt}{ds/dt}</m> to rewrite <m>\mathbf{T}\,ds</m>,
      which gives the compact form of the integral, and finally write
      everything in terms of a parametrization <m>\mathbf{r}(t)</m>,
      <m>a \le t \le b</m>.)
    </p>

    <sidebyside width="97%">
      <image>
        <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,15);
\draw[gray!35] (0,12) -- (15,12);
\draw[gray!35] (0,9) -- (15,9);
\draw[gray!35] (0,6) -- (15,6);
\draw[gray!35] (0,3) -- (15,3);
\node[anchor=north west, font=\small\itshape] at (0.35,14.7) {work along the $k$th subarc $\approx$};
\node[anchor=north west, font=\small\itshape] at (0.35,11.7) {$W \approx \displaystyle\sum_{k=1}^{n}$};
\node[anchor=north west, font=\small\itshape] at (0.35,8.7) {$W = \displaystyle\lim_{n\to\infty} \cdots = \int_C$};
\node[anchor=north west, font=\small\itshape] at (0.35,5.7) {$\mathbf{T}\,ds =$};
\node[anchor=north west, font=\small\itshape] at (0.35,2.7) {with $\mathbf{r}(t)$, $a \le t \le b$: \quad $\displaystyle\int_C \mathbf{F}\cdot d\mathbf{r} = \int_a^b$};
\end{tikzpicture}
        </latex-image>
        <shortdescription>Blank box in five rows, for the work along one subarc, for the sum over subarcs, for the limit as a line integral, for rewriting T ds, and for the parametrized form of the integral.</shortdescription>
      </image>
    </sidebyside>

    <assemblage xml:id="assemblage-work-integral">
      <title>The Line Integral of a Vector Field</title>
      <p>
        The work done by <m>\mathbf{F}</m> along <m>C</m> is approximated
        by
        <md>
          <mrow xml:id="eq-work-sum" number="yes">
            W\approx\sum_{k=1}^{n}
              \mathbf{F}(x_k,y_k)\cdot\mathbf{T}_k\,\Delta s_k,
          </mrow>
        </md>
        and exactly by
        <md>
          <mrow xml:id="eq-work-Tds" number="yes">
            W = \int_C \mathbf{F}\cdot\mathbf{T}\,ds,
          </mrow>
        </md>
        where <m>\mathbf{T}</m> is the unit tangent vector of the curve.
        Since
        <md>
          <mrow xml:id="eq-unit-tangent" number="yes">
            \mathbf{T}=\frac{\mathbf{v}}{\left\lVert\mathbf{v}\right\rVert}
              =\frac{\frac{d\mathbf{r}}{dt}}{\frac{ds}{dt}}
              =\frac{d\mathbf{r}}{ds},
          </mrow>
        </md>
        the combination <m>\mathbf{T}\,ds</m> is simply <m>d\mathbf{r}</m>,
        and
        <md>
          <mrow xml:id="eq-work-dr" number="yes">
            W=\int_C \mathbf{F}\cdot\mathbf{T}\,ds
              =\int_C \mathbf{F}\cdot d\mathbf{r}.
          </mrow>
        </md>
        In practice, once the curve is parametrized by
        <m>\mathbf{r}(t)</m> for <m>a\le t\le b</m>,
        <md>
          <mrow xml:id="eq-work-parametrized" number="yes">
            \int_C \mathbf{F}\cdot d\mathbf{r}
              =\int_a^b \mathbf{F}\bigl(\mathbf{r}(t)\bigr)
                \cdot\mathbf{v}(t)\,dt :
          </mrow>
        </md>
        evaluate the field along the curve, dot it with the velocity, and
        integrate over time.
      </p>
    </assemblage>

    <p>
      The applet below carries every ingredient of
      <xref ref="eq-work-parametrized"/> at once: a curve <m>C</m>
      parametrized by <m>\mathbf{r}(t)</m>, the velocity
      <m>\mathbf{v}(t)=d\mathbf{r}/dt</m> tangent to it, and a force field
      <m>\mathbf{F}</m> evaluated at the moving point. Work out what the
      integrand <m>\mathbf{F}\cdot\mathbf{v}</m> is doing before you
      compute anything.
    </p>

    <figure xml:id="fig-work-geogebra">
      <caption>
        A point climbs the curve <m>C</m> while the force field
        <m>\mathbf{F}</m> and the velocity <m>\mathbf{v}</m> are drawn at
        its current position. The work is the accumulated
        <m>\mathbf{F}\cdot\mathbf{v}</m>, so the angle between the two
        arrows is what decides its sign.
      </caption>
      <!-- shift-drag-zoom lets the reader pan and zoom, and rotate the
           3-D view by dragging; reset-icon puts back the original view -->
      <interactive geogebra="e2m6kghr"
                   width="100%" aspect="599:488"
                   material-width="599" material-height="488"
                   shift-drag-zoom="yes" reset-icon="yes">
        <instructions>
          <p>
            The slider <m>n</m> cuts the curve into <m>n</m> pieces and
            joins the division points by straight chords<mdash/>the
            partition behind <xref ref="eq-work-sum"/>. Increase <m>n</m>
            and watch the chain of chords settle onto <m>C</m>.
          </p>
          <p>
            Drag the slider <m>t</m> to move the point along the curve
            <m>C</m>, and watch the two arrows attached to it:
            <m>\mathbf{F}</m>, the force the field exerts there, and
            <m>\mathbf{v}</m>, the velocity, which is tangent to <m>C</m>
            and points in the direction of travel. Rotate the picture by
            dragging the background if you want to see the configuration
            from another angle.
          </p>
          <p>
            At each position, ask yourself whether the angle between
            <m>\mathbf{F}</m> and <m>\mathbf{v}</m> is acute, obtuse, or
            right<mdash/>that is, whether <m>\mathbf{F}\cdot\mathbf{v}</m>
            is positive, negative, or zero<mdash/>and whether the answer
            changes as the point climbs.
          </p>
        </instructions>
      </interactive>
    </figure>

    <p>
      Work was our motivation, but any vector field <m>\mathbf{F}</m> can be
      integrated over a curve <m>C</m> in this fashion; the number it
      produces is also called the <term>circulation</term> of
      <m>\mathbf{F}</m> along <m>C</m>, a name that becomes the usual one
      when <m>C</m> is a closed curve.
      <xref ref="fig-work-video"/> shows the accumulation of
      <m>\mathbf{F}\cdot\mathbf{T}\,ds</m> along a trajectory.
    </p>

    <figure xml:id="fig-work-video">
      <caption>
        As the object moves through the field
        <m>\mathbf{F}=\left\langle x,\ y\right\rangle</m> along the trajectory,
        the work <m>W=\int_C\mathbf{F}\cdot d\mathbf{r}</m> accumulates
        moment by moment from the tangential component of the force.
      </caption>
      <video preview="play-button.png" xml:id="video-work-line-integral" width="80%"
             source="videos/work_line_integral_1080p.mp4"/>
    </figure>

    <p>
      There is a third, frequently used way to write the same integral.
      Assume the vector field has components
      <m>\mathbf{F}(x,y,z)=\left\langle M(x,y,z),\ N(x,y,z),\
         P(x,y,z)\right\rangle</m>. Since
      <m>d\mathbf{r}=\left\langle dx,\ dy,\ dz\right\rangle</m>,
      expanding the dot product gives the <term>differential form</term> of
      the line integral:
      <md>
        <mrow xml:id="eq-work-differential" number="yes">
          \int_C \mathbf{F}\cdot d\mathbf{r}
            =\int_C M\,dx+N\,dy+P\,dz.
        </mrow>
      </md>
      All three notations<mdash/><xref ref="eq-work-Tds"/>,
      <m>\int_C\mathbf{F}\cdot d\mathbf{r}</m>, and
      <m>\int_C M\,dx+N\,dy+P\,dz</m><mdash/>mean exactly the same thing.
    </p>
  </subsection>

  <!-- ================================================================= -->
  <!-- EXAMPLE 1: work along the twisted cubic.                           -->
  <example xml:id="ex-twisted-cubic-work">
    <title>Work along a twisted cubic</title>
    <statement>
      <p>
        Calculate the work done by the force
        <md>
          \mathbf{F}(x,y,z)=\left\langle y-x^2,\ z-y^2,\ x-z^2\right\rangle
        </md>
        over the curve <m>C</m>:
        <md>
          \mathbf{r}(t)=\left\langle t,\ t^2,\ t^3\right\rangle
        </md>
        from <m>(0,0,0)</m> to <m>(1,1,1)</m>.
      </p>
      <p>
        <em>Solution.</em>
        (Use <xref ref="eq-work-parametrized"/>. Read the parameter interval
        off the two endpoints, write the force along the curve by
        substituting <m>x = t</m>, <m>y = t^2</m>, <m>z = t^3</m>
        <mdash/> one component vanishes identically <mdash/> and
        differentiate for <m>\mathbf{v}(t)</m>. Dot, expand, and integrate
        term by term. The curve is shown in
        <xref ref="fig-twisted-cubic"/>.)
      </p>

      <sidebyside width="97%">
        <image>
          <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,13);
\draw[gray!35] (0,10.5) -- (15,10.5);
\draw[gray!35] (0,7.5) -- (15,7.5);
\draw[gray!35] (0,5) -- (15,5);
\node[anchor=north west, font=\small\itshape] at (0.35,12.7) {parameter interval:};
\node[anchor=north west, font=\small\itshape] at (0.35,10.2) {$\mathbf{F}(\mathbf{r}(t)) =$};
\node[anchor=north west, font=\small\itshape] at (0.35,7.2) {$\mathbf{v}(t) =$};
\node[anchor=north west, font=\small\itshape] at (0.35,4.7) {$W = \displaystyle\int_C \mathbf{F}\cdot d\mathbf{r} =$};
\end{tikzpicture}
          </latex-image>
          <shortdescription>Blank box in four rows, for the parameter interval, for the force along the curve, for the velocity vector, and for the work integral.</shortdescription>
        </image>
      </sidebyside>
      <figure xml:id="fig-twisted-cubic">
        <caption>
          The twisted cubic
          <m>\mathbf{r}(t)=\left\langle t,\ t^2,\ t^3\right\rangle</m>,
          <m>0\le t\le 1</m>, from the origin to <m>(1,1,1)</m>. The dashed
          gray curve is its shadow on the plane <m>z=0</m>.
        </caption>
        <image xml:id="image-twisted-cubic" width="70%">
          <shortdescription>
            A curve in space rising from the origin to the point (1,1,1),
            with its shadow on the floor.
          </shortdescription>
          <description>
            <p>
              A three-dimensional box with x, y, and z from 0 to 1.1. A
              thick blue curve starts at a red point at the origin, labelled
              (0,0,0), hugs the floor at first, then sweeps upward ever more
              steeply to a red point labelled (1,1,1) at the far upper
              corner. A dashed gray parabola on the floor shows the curve's
              shadow.
            </p>
          </description>
          <latex-image>
            \begin{tikzpicture}
            \begin{axis}[width=10cm, view={115}{20},
                xlabel={\(x\)}, ylabel={\(y\)}, zlabel={\(z\)},
                xmin=0, xmax=1.1, ymin=0, ymax=1.1, zmin=0, zmax=1.1,
                grid=major, grid style={gray!20}, clip=false]
              \addplot3[gray!65, dashed, line width=1.3pt, domain=0:1,
                        samples=60, samples y=0]
                  ({x}, {x^2}, {0});
              \addplot3[blue, very thick, domain=0:1, samples=80, samples y=0]
                  ({x}, {x^2}, {x^3});
              \addplot3[only marks, mark=*, red, mark size=1.6pt] coordinates
                  {(0,0,0) (1,1,1)};
              \node[anchor=south east, xshift=-3pt] at (axis cs:0,0,0) {\((0,0,0)\)};
              \node[above=3pt] at (axis cs:1,1,1) {\((1,1,1)\)};
            \end{axis}
            \end{tikzpicture}
          </latex-image>
        </image>
      </figure>
    </statement>
  </example>

  <!-- ================================================================= -->
  <!-- EXAMPLE 2: the inverse-square field along a helix (from the        -->
  <!-- handwritten notes of 01.17/01.22).                                 -->
  <example xml:id="ex-helix-gravity">
    <title>Work done by an inverse-square field along a helix</title>
    <statement>
      <p>
        Calculate the line integral
        <md>
          <mrow>
            \int_C \amp \frac{-x}{\left(x^2+y^2+z^2\right)^{3/2}}\,dx
          </mrow>
          <mrow>
            \amp +\frac{-y}{\left(x^2+y^2+z^2\right)^{3/2}}\,dy
          </mrow>
          <mrow>
            \amp +\frac{-z}{\left(x^2+y^2+z^2\right)^{3/2}}\,dz
          </mrow>
        </md>
        over the curve
        <m>\mathbf{r}(t)=\langle\cos t,\ \sin t,\ t\rangle</m> from
        <m>(1,0,0)</m> to <m>(1,0,2\pi)</m>.
      </p>
      <p>
        <em>Solution.</em>
        (This integral is in the differential form
        <xref ref="eq-work-differential"/>: identify
        <m>\mathbf{F} = \langle M, N, P\rangle</m> and recognize it as the
        inverse-square field <xref ref="eq-gravity-field"/> of
        <xref ref="fig-gravity-field"/>. Read off the parameter interval
        from the endpoints. Along the helix, simplify <m>x^2+y^2+z^2</m>
        first, then write <m>\mathbf{F}(\mathbf{r}(t))</m> and
        <m>\mathbf{v}(t)</m>; the dot product collapses. Integrate with the
        substitution <m>u = 1 + t^2</m>. Say what the sign of the answer
        means physically, and check it against
        <xref ref="fig-helix-gravity"/> and
        <xref ref="fig-helix-gravity-video"/>.)
      </p>

      <sidebyside width="97%">
        <image>
          <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,17);
\draw[gray!35] (0,14) -- (15,14);
\draw[gray!35] (0,11) -- (15,11);
\draw[gray!35] (0,8) -- (15,8);
\draw[gray!35] (0,3) -- (15,3);
\node[anchor=north west, font=\small\itshape] at (0.35,16.7) {$\mathbf{F} =$ \qquad parameter interval:};
\node[anchor=north west, font=\small\itshape] at (0.35,13.7) {on the helix, $x^2+y^2+z^2 =$ \qquad so $\mathbf{F}(\mathbf{r}(t)) =$};
\node[anchor=north west, font=\small\itshape] at (0.35,10.7) {$\mathbf{v}(t) =$ \qquad and \qquad $\mathbf{F}\cdot\mathbf{v} =$};
\node[anchor=north west, font=\small\itshape] at (0.35,7.7) {$\displaystyle\int_C M\,dx+N\,dy+P\,dz = \int_0^{2\pi} \cdots$ \quad ($u = 1+t^2$)};
\node[anchor=north west, font=\small\itshape] at (0.35,2.7) {the sign, and why:};
\end{tikzpicture}
          </latex-image>
          <shortdescription>Blank box in five rows, for identifying the field and the parameter interval, for the field along the helix, for the velocity and the dot product, for the integral evaluated by substitution, and for the physical meaning of the sign.</shortdescription>
        </image>
      </sidebyside>
      <figure xml:id="fig-helix-gravity">
        <caption>
          The helix <m>\mathbf{r}(t)=\langle\cos t,\sin t,t\rangle</m>,
          <m>0\le t\le 2\pi</m>, climbing through the field
          <m>\mathbf{F}=-\mathbf{r}/\left\lVert\mathbf{r}\right\rVert^3</m>
          (orange arrows, direction only). At the same three points the
          velocity <m>\mathbf{v}</m> is drawn in green: at every one of
          them the field leans away from the direction of travel, which is
          why the work comes out negative.
        </caption>
        <image xml:id="image-helix-gravity" width="70%">
          <shortdescription>
            One full turn of a helix rising from (1,0,0) to (1,0,2 pi), with
            arrows along it pointing toward the origin.
          </shortdescription>
          <description>
            <p>
              A three-dimensional box with x and y from minus 1.4 to 1.4 and
              z from 0 to 7. A thick blue helix makes one full
              counterclockwise turn of radius one, starting at a red point
              labelled (1,0,0), t equals 0, on the floor and ending at a red
              point labelled (1,0,2 pi), t equals 2 pi, directly above it. A
              dashed gray unit circle on the floor is the helix's shadow.
              Three orange arrows attached to points of the helix, labelled
              F, point inward and downward, toward the origin. At the same
              three points three green arrows, labelled v, point along the
              helix in the direction of travel, upward and around; each
              green arrow makes an obtuse angle with the orange one beside
              it.
            </p>
          </description>
          <latex-image>
            \begin{tikzpicture}
            \begin{axis}[width=10cm, view={115}{15},
                xlabel={\(x\)}, ylabel={\(y\)}, zlabel={\(z\)},
                xmin=-1.4, xmax=1.4, ymin=-1.4, ymax=1.4, zmin=0, zmax=7,
                grid=major, grid style={gray!20}, clip=false]
              % shadow: unit circle on the ground
              \addplot3[gray!50, dashed, thin, domain=0:360, samples=90, samples y=0]
                  ({cos(x)}, {sin(x)}, {0});
              % the helix, one full turn
              \addplot3[blue, very thick, domain=0:360, samples=140, samples y=0]
                  ({cos(x)}, {sin(x)}, {pi*x/90/2});
              % a few field vectors F = -r/|r|^3 along the curve
              % (direction only), and the velocity at the same points
              \addplot3[orange, line width=1.5pt, -{Stealth[length=5pt]},
                  quiver={u=\thisrow{u}, v=\thisrow{v}, w=\thisrow{w}}]
                  table[row sep=\\] {%
x y z u v w\\
0 1 1.5708 0 -0.43 -0.68\\
-1 0 3.1416 0.24 0 -0.76\\
0 -1 4.7124 0 0.17 -0.78\\
};
              \addplot3[green!55!black, line width=1.5pt,
                  -{Stealth[length=5pt]},
                  quiver={u=\thisrow{u}, v=\thisrow{v}, w=\thisrow{w}}]
                  table[row sep=\\] {%
x y z u v w\\
0 1 1.5708 -0.55 0 0.55\\
-1 0 3.1416 0 -0.55 0.55\\
0 -1 4.7124 0.55 0 0.55\\
};
              \addplot3[only marks, mark=*, red, mark size=1.6pt] coordinates
                  {(1,0,0) (1,0,6.2832)};
              \node[anchor=west, xshift=10pt, yshift=4pt] at (axis cs:1,0,0) {\((1,0,0),\ t=0\)};
              \node[anchor=south west, xshift=4pt] at (axis cs:1,0,6.2832) {\((1,0,2\pi),\ t=2\pi\)};
              \node[orange, anchor=east] at (axis cs:-1.4,-0.3,2.55)
                  {\(\mathbf F\)};
              \node[green!55!black, anchor=west]
                  at (axis cs:0.15,-1.05,5.5) {\(\mathbf v\)};
            \end{axis}
            \end{tikzpicture}
          </latex-image>
        </image>
      </figure>

      <figure xml:id="fig-helix-gravity-video">
        <caption>
          A particle climbs the helix through the field while the work
          <m>W(t)</m> accumulates. Watch its sign, and check the value it
          reaches at the top against your answer.
        </caption>
        <video preview="play-button.png" xml:id="video-helix-gravity" width="85%"
               source="videos/helix_gravity_work_1080p.mp4"/>
      </figure>
    </statement>
  </example>

  <example xml:id="ex-work-path-dependence">
    <title>The same endpoints, two paths, two answers</title>
    <statement>
      <p>
        Calculate the work done by the force
        <md>
          \mathbf{F}(x,y)=\left\langle y,\ 2x\right\rangle
        </md>
        in moving a particle from <m>O(0,0)</m> to <m>P(1,1)</m> along each
        of the following two paths:
        <ul>
          <li>
            <p>
              <m>C_1</m>, the straight segment from <m>O</m> to <m>P</m>,
              parametrized by
              <m>\mathbf{r}_1(t)=\left\langle t,\ t\right\rangle</m>,
              <m>0\le t\le 1</m>;
            </p>
          </li>
          <li>
            <p>
              <m>C_2</m>, the arc of the parabola <m>y=x^2</m> from
              <m>O</m> to <m>P</m>, parametrized by
              <m>\mathbf{r}_2(t)=\left\langle t,\ t^2\right\rangle</m>,
              <m>0\le t\le 1</m>.
            </p>
          </li>
        </ul>
      </p>
      <figure xml:id="fig-path-dependence-paths">
        <caption>
          The two paths of <xref ref="ex-work-path-dependence"/> drawn in the
          field <m>\mathbf{F}=\left\langle y,\ 2x\right\rangle</m>: the
          segment <m>C_1</m> along <m>y=x</m> and the arc <m>C_2</m> along
          <m>y=x^2</m>, both running from <m>O(0,0)</m> to <m>P(1,1)</m>.
        </caption>
        <image xml:id="image-path-dependence-paths" width="60%">
          <shortdescription>
            A straight segment and a parabolic arc, both joining the origin to
            the point one comma one, drawn in a field of arrows.
          </shortdescription>
          <description>
            <p>
              The first quadrant, with x and y running from zero to a little
              past one, carrying a grid of blue field arrows. Along the x axis
              they point straight up and along the y axis they point straight
              right, turning and lengthening in between. Two curves join the
              origin O to the point P
              at one comma one: a green straight segment labelled C 1 along
              the line y equals x, and a vermillion arc labelled C 2 following
              the parabola y equals x squared, which bows below the segment.
              Each curve carries an arrowhead pointing from O toward P.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="path-dependence-paths">
            <diagram dimensions="(400,400)" margins="5">
              <definition>F(x,y) = (0.11*y, 0.22*x)</definition>
              <definition>c1(t) = (t, t)</definition>
              <definition>c2(t) = (t, t^2)</definition>
              <coordinates bbox="(-0.28,-0.28,1.35,1.35)" aspect-ratio="1">
                <grid-axes xlabel="x" ylabel="y"/>

                <group at="field">
                  <repeat parameter="i=0..5">
                    <repeat parameter="j=0..5">
                      <vector v="F(0.2*i,0.2*j)" tail="(0.2*i,0.2*j)"
                              stroke="blue" thickness="2"/>
                    </repeat>
                  </repeat>
                </group>

                <group at="c1">
                  <parametric-curve function="c1" domain="(0,1)"
                                    stroke="#009E73" thickness="3"
                                    arrows="1" arrow-location="0.55"/>
                  <label anchor="(0.45,0.55)" alignment="nw"
                         color="#009E73">
                    <m>C_1</m>
                  </label>
                </group>

                <group at="c2">
                  <parametric-curve function="c2" domain="(0,1)"
                                    stroke="#D55E00" thickness="3"
                                    arrows="1" arrow-location="0.65"/>
                  <label anchor="(0.78,0.5)" alignment="se"
                         color="#D55E00">
                    <m>C_2</m>
                  </label>
                </group>

                <group at="endpoints">
                  <point p="(0,0)" size="4.5" stroke="black" fill="black"/>
                  <label anchor="(0,0)" alignment="sw">
                    <m>O</m>
                  </label>
                  <point p="(1,1)" size="4.5" stroke="black" fill="black"/>
                  <label anchor="(1,1)" alignment="ne">
                    <m>P</m>
                  </label>
                </group>
              </coordinates>

              <annotations>
                <annotation ref="figure"
                            text="Two paths from the origin to the point one
                                  comma one, drawn in the field F of x and y
                                  equals the vector y, two x">
                  <annotation ref="grid" text="The coordinate grid"/>
                  <annotation ref="axes" text="The coordinate axes"/>
                  <annotation ref="field"
                              text="The grid of field vectors of the field F
                                    of x and y equals the vector y, two x"/>
                  <annotation ref="c1"
                              text="The path C 1, the straight segment along
                                    the line y equals x from O to P"
                              sonify="yes"/>
                  <annotation ref="c2"
                              text="The path C 2, the arc of the parabola y
                                    equals x squared from O to P, bowing below
                                    the segment"
                              sonify="yes"/>
                  <annotation ref="endpoints"
                              text="The common endpoints O at the origin and P
                                    at one comma one"/>
                </annotation>
              </annotations>
            </diagram>
          </prefigure>
        </image>
      </figure>

      <p>
        <em>Solution.</em>
        (Both curves start at <m>O</m> and end at <m>P</m>, as in
        <xref ref="fig-path-dependence-paths"/>, so any difference between
        the two answers can come only from the paths themselves. Apply
        <xref ref="eq-work-parametrized"/> to each: write
        <m>\mathbf{F}</m> along the path and the velocity, dot, and
        integrate. Compare <m>W_1</m> and <m>W_2</m>, and say what the
        comparison tells you about whether the endpoints alone determine
        the work. Which fields are the exception is the question taken up
        in <xref ref="section-conservative-fields"/>.)
      </p>

      <sidebyside width="97%">
        <image>
          <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,13);
\draw[gray!35] (0,8.5) -- (15,8.5);
\draw[gray!35] (0,4) -- (15,4);
\node[anchor=north west, font=\small\itshape] at (0.35,12.7) {along $C_1$: $\mathbf{F}(\mathbf{r}_1(t)) =$ \quad $\mathbf{r}_1'(t) =$ \quad $W_1 =$};
\node[anchor=north west, font=\small\itshape] at (0.35,8.2) {along $C_2$: $\mathbf{F}(\mathbf{r}_2(t)) =$ \quad $\mathbf{r}_2'(t) =$ \quad $W_2 =$};
\node[anchor=north west, font=\small\itshape] at (0.35,3.7) {conclusion:};
\end{tikzpicture}
          </latex-image>
          <shortdescription>Blank box in three rows, for the work along the segment, for the work along the parabola, and for the conclusion about path dependence.</shortdescription>
        </image>
      </sidebyside>
    </statement>
  </example>

  <!-- ================================================================= -->
  <!-- Interactive exploration: the GeoGebra applet "VF-Fig1"             -->
  <!-- (geogebra.org/m/e2m6kghr), 599 x 488.                              -->
  <subsection xml:id="subsec-work-exploration">
    <title>Concept Check</title>

    <exercise xml:id="q-work-sign-two-paths">
      <title>Positive, negative, or zero?</title>
      <statement>
        <p>
          In <xref ref="fig-two-paths-curves"/>, determine whether the work
          done by the force field along the two paths <m>C_1</m> and
          <m>C_2</m> is positive, negative, or zero.
        </p>

        <figure xml:id="fig-two-paths-curves">
          <caption>
            Two closed paths in the radial field
            <xref ref="eq-radial-field"/>: the ellipse <m>C_1</m> and the
            circle <m>C_2</m>. Notice the orientation of each curve.
          </caption>
          <image xml:id="image-two-paths-curves" width="65%">
            <shortdescription>
              An ellipse and a circle centred at the origin, drawn in a field
              of arrows that point away from the origin, each curve carrying
              an arrowhead that gives its direction of travel.
            </shortdescription>
            <description>
              <p>
                The plane with x and y from minus 5 to 5, filled with blue
                arrows that point straight away from the origin and grow
                longer with the distance from it. A green ellipse crosses the
                x axis at plus and minus three and the y axis at plus and
                minus one; its arrowhead, just above the origin, points in the
                negative x direction, so the ellipse is traversed
                counterclockwise. A black circle of radius two is centred at
                the origin; its arrowhead, in the upper right, points down and
                to the right, so the circle is traversed clockwise. A red dot
                marks the origin, where the field is the zero vector.
              </p>
            </description>
            <prefigure xmlns="https://prefigure.org" label="two-paths-curves">
              <diagram dimensions="(400,400)" margins="5">
                <definition>F(x,y) = (0.22*x, 0.22*y)</definition>
                <definition>c1(t) = (3*cos(t), sin(t))</definition>
                <definition>c2(t) = (2*cos(t), -2*sin(t))</definition>
                <coordinates bbox="(-5.4,-5.4,5.4,5.4)" aspect-ratio="1">
                  <grid-axes xlabel="x" ylabel="y"/>

                  <group at="field">
                    <repeat parameter="i=-4..4">
                      <repeat parameter="j=-4..4">
                        <vector v="F(i,j)" tail="(i,j)" stroke="blue"
                                thickness="2"/>
                      </repeat>
                    </repeat>
                  </group>

                  <group at="c2">
                    <parametric-curve function="c2" domain="(0,2*pi)"
                                      closed="yes" stroke="black"
                                      thickness="3" arrows="1"
                                      arrow-location="5.24"/>
                    <label anchor="(-1.45,-1.45)" alignment="sw"
                           clear-background="yes">
                      <m>C_2</m>
                    </label>
                  </group>

                  <group at="c1">
                    <parametric-curve function="c1" domain="(0,2*pi)"
                                      closed="yes" stroke="#009E73"
                                      thickness="3" arrows="1"
                                      arrow-location="1.35"/>
                    <label anchor="(-3.15,0.5)" alignment="nw"
                           color="#009E73" clear-background="yes">
                      <m>C_1</m>
                    </label>
                  </group>

                  <group at="origin">
                    <point p="(0,0)" size="4.5" stroke="red" fill="red"/>
                  </group>
                </coordinates>

                <annotations>
                  <annotation ref="figure"
                              text="Two closed paths drawn in the radial field
                                    F of x and y equals the vector x, y, whose
                                    arrows all point straight away from the
                                    origin and grow with the distance from it.
                                    Each path carries one arrowhead showing
                                    the direction in which it is traversed">
                    <annotation ref="grid" text="The coordinate grid"/>
                    <annotation ref="axes" text="The coordinate axes"/>
                    <annotation ref="field"
                                text="The grid of field vectors, each pointing
                                      radially outward with length
                                      proportional to the distance from the
                                      origin"/>
                    <annotation ref="c1"
                                text="The path C 1, an ellipse crossing the x
                                      axis at plus and minus three and the y
                                      axis at plus and minus one. Its
                                      arrowhead sits just above the origin and
                                      points in the negative x direction, so C
                                      1 is traversed counterclockwise"
                                sonify="yes"/>
                    <annotation ref="c2"
                                text="The path C 2, a circle of radius two
                                      centred at the origin. Its arrowhead
                                      sits in the upper right and points down
                                      and to the right, so C 2 is traversed
                                      clockwise"
                                sonify="yes"/>
                    <annotation ref="origin"
                                text="The origin, where the field is the zero
                                      vector"/>
                  </annotation>
                </annotations>
              </diagram>
            </prefigure>
          </image>
        </figure>
        <p>
          (The field is the radial field <xref ref="eq-radial-field"/>,
          which aims straight away from the origin at every point. For the
          circle, ask what angle <m>\mathbf{F}</m> makes with the direction
          of travel <m>\mathbf{T}</m> at every point, and what that does to
          the integrand of <xref ref="eq-work-Tds"/>. For the ellipse the
          integrand does not vanish: mark the stretches where the curve
          moves away from the origin and those where it moves back, decide
          the sign of <m>\mathbf{F}\cdot\mathbf{T}</m> on each, and think
          about what a full circuit adds up to. Does reversing the
          orientation change either answer?)
        </p>

        <sidebyside width="97%">
          <image>
            <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,10);
\draw[gray!35] (0,6.5) -- (15,6.5);
\draw[gray!35] (0,3) -- (15,3);
\node[anchor=north west, font=\small\itshape] at (0.35,9.7) {the circle $C_2$: $\mathbf{F}\cdot\mathbf{T}$ is \qquad so the work is};
\node[anchor=north west, font=\small\itshape] at (0.35,6.2) {the ellipse $C_1$: outward stretches \quad / \quad inward stretches \quad / \quad full circuit};
\node[anchor=north west, font=\small\itshape] at (0.35,2.7) {reversing the orientation:};
\end{tikzpicture}
            </latex-image>
            <shortdescription>Blank box in three rows, for the sign of the work around the circle, for the sign on the outward and inward stretches of the ellipse and over a full circuit, and for the effect of reversing the orientation.</shortdescription>
          </image>
        </sidebyside>
      </statement>
    </exercise>

    <!-- ............................................................... -->
    <!-- Concept Checks 2 and 3: statements and figures as in the        -->
    <!-- completed notes; the answers and solutions (with their two      -->
    <!-- figures) are replaced by blank workspace boxes, with no hints.  -->
    <exercise xml:id="q-work-half-circle">
      <title>A force at a fixed angle to the path</title>
      <statement>
        <p>
          An object moves along a circle of radius <m>R</m> centred at
          <m>O</m> and is acted upon by a force <m>\mathbf{F}</m> of
          constant magnitude <m>F=\left\lVert\mathbf{F}\right\rVert</m>. At
          every moment the force makes a <m>30^\circ</m> angle with the
          unit tangent vector <m>\mathbf{T}</m>, as shown in
          <xref ref="fig-half-circle-force"/>. Calculate the work done by
          <m>\mathbf{F}</m> as the object moves along the half circle
          <m>C</m> from <m>A</m> to <m>B</m>.
        </p>

        <figure xml:id="fig-half-circle-force">
          <caption>
            The object travels over the top of the circle from <m>A</m> to
            <m>B</m>. At every point the force <m>\mathbf{F}</m> (red) makes
            a <m>30^\circ</m> angle with the unit tangent vector
            <m>\mathbf{T}</m> (green), the direction of travel.
          </caption>
          <image xml:id="image-half-circle-force" width="55%">
            <shortdescription>
              A half circle traversed from A over the top to B, with a force
              arrow at thirty degrees to the tangent arrow at one point.
            </shortdescription>
            <description>
              <p>
                A circle of radius R centred at a point O. Its lower half is
                dashed; its upper half, the path C, is drawn thick with an
                arrowhead to the right of the top, so it is traversed
                clockwise from the point A at the left end of the horizontal
                diameter to the point B at the right end. A line segment from
                O to the upper right part of the circle is labelled R. At a
                point on the upper left of the path two arrows start: a green
                arrow labelled T, tangent to the circle and pointing up and to
                the right, and a longer red arrow labelled F that leans thirty
                degrees further up, away from the centre. A small arc between
                them is labelled thirty degrees.
              </p>
            </description>
            <prefigure xmlns="https://prefigure.org" label="half-circle-force">
              <diagram dimensions="(400,370)" margins="5">
                <definition>h(t) = (-2*cos(t), 2*sin(t))</definition>
                <definition>P = h(pi/4)</definition>
                <definition>tv = 1.25*(cos(pi/4), sin(pi/4))</definition>
                <definition>fv = 1.9*(cos(5*pi/12), sin(5*pi/12))</definition>
                <coordinates bbox="(-3.4,-2.35,3.4,3.9)" aspect-ratio="1">
                  <group at="circle">
                    <circle center="(0,0)" radius="2" stroke="gray" thickness="2"
                            dash="5 4"/>
                  </group>

                  <group at="path">
                    <parametric-curve function="h" domain="(0,pi)" stroke="black"
                                      thickness="3" arrows="1" arrow-location="2.05"/>
                    <label anchor="h(2.2)" alignment="ne" offset="(4,4)">
                      <m>C</m>
                    </label>
                  </group>

                  <group at="center">
                    <point p="(0,0)" size="3.5" stroke="black" fill="black"/>
                    <label anchor="(0,0)" alignment="s" offset="(0,-6)">
                      <m>O</m>
                    </label>
                    <line endpoints="((0,0), 2*(cos(pi/5), sin(pi/5)))" stroke="black"
                          thickness="2"/>
                    <label anchor="(cos(pi/5), sin(pi/5))" alignment="se" offset="(2,-2)">
                      <m>R</m>
                    </label>
                  </group>

                  <group at="endpoints">
                    <point p="(-2,0)" size="4" stroke="black" fill="black"/>
                    <label anchor="(-2,0)" alignment="w" offset="(-6,0)">
                      <m>A</m>
                    </label>
                    <point p="(2,0)" size="4" stroke="black" fill="black"/>
                    <label anchor="(2,0)" alignment="e" offset="(6,0)">
                      <m>B</m>
                    </label>
                  </group>

                  <group at="vectors">
                    <vector v="fv" tail="P" stroke="red" thickness="3"/>
                    <label anchor="P+fv" alignment="n" offset="(0,4)" color="red">
                      <m>\mathbf{F}</m>
                    </label>
                    <vector v="tv" tail="P" stroke="#009E73" thickness="3"/>
                    <label anchor="P+tv" alignment="e" offset="(4,0)" color="#009E73">
                      <m>\mathbf{T}</m>
                    </label>
                    <arc center="P" radius="0.8" range="(45,75)" stroke="black"
                         thickness="1"/>
                    <label anchor="P+1.1*(cos(pi/3), sin(pi/3))" alignment="c">
                      <m>30^\circ</m>
                    </label>
                    <point p="P" size="4" stroke="black" fill="black"/>
                  </group>
                </coordinates>

                <annotations>
                  <annotation ref="figure"
                              text="An object travels over the top of a circle of radius
                                    R from the point A to the point B, pushed by a force F
                                    that always makes a thirty degree angle with the
                                    direction of travel">
                    <annotation ref="circle"
                                text="The circle of radius R centred at O, drawn dashed"/>
                    <annotation ref="path"
                                text="The path C, the upper half of the circle, traversed
                                      clockwise from A over the top to B"
                                sonify="yes"/>
                    <annotation ref="center"
                                text="The centre O of the circle and a radius of length
                                      R"/>
                    <annotation ref="endpoints"
                                text="The starting point A at the left end of the
                                      horizontal diameter and the end point B at the
                                      right end"/>
                    <annotation ref="vectors"
                                text="At a point on the upper left of the path, the unit
                                      tangent vector T pointing up and to the right in
                                      the direction of travel, and the force F, which
                                      leans thirty degrees away from T toward the outside
                                      of the circle"/>
                  </annotation>
                </annotations>
              </diagram>
            </prefigure>
          </image>
        </figure>
        <sidebyside width="97%">
          <image>
            <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,12);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,11.75) {workspace};
\end{tikzpicture}
            </latex-image>
            <shortdescription>Blank workspace for the work done by the force along the half circle.</shortdescription>
          </image>
        </sidebyside>
      </statement>
    </exercise>

    <!-- ............................................................... -->
    <exercise xml:id="q-work-pendulum">
      <title>Pulling a pendulum aside</title>
      <introduction>
        <p>
          A simple pendulum consists of a small bob of mass <m>m</m>
          hanging from a cord of length <m>\ell</m> whose mass is
          negligible. A horizontal force
          <m>\mathbf{F}=F\,\mathbf{i}</m> moves the bob so slowly that its
          acceleration is essentially zero; its magnitude
          <m>F=\left\lVert\mathbf{F}\right\rVert</m> must therefore change
          with the angle <m>\theta</m> that the cord makes with the
          vertical. Two other forces act on the bob: gravity,
          <m>\mathbf{F}_{\mathrm{G}}=m\mathbf{g}</m>, and the force
          <m>\mathbf{F}_{\mathrm{T}}</m> that the cord exerts on it. See
          <xref ref="fig-pendulum-forces"/>.
        </p>

        <figure xml:id="fig-pendulum-forces">
          <caption>
            The bob moves along the arc <m>C</m> from its lowest point
            <m>A</m> to the point <m>B</m> where the cord makes the angle
            <m>\theta_0</m> with the vertical. Three forces act on it: the
            horizontal pull <m>\mathbf{F}</m>, gravity
            <m>\mathbf{F}_{\mathrm{G}}</m>, and the force
            <m>\mathbf{F}_{\mathrm{T}}</m> of the cord.
          </caption>
          <image xml:id="image-pendulum-forces" width="55%">
            <shortdescription>
              A pendulum hanging from the ceiling, pulled aside along an arc,
              with the three forces on the bob.
            </shortdescription>
            <description>
              <p>
                A cord of length ell hangs from a pivot on the ceiling and
                makes the angle theta with a dashed vertical line through the
                pivot. An x axis points right and a short y axis points up
                from the lowest position A of the bob, directly below the
                pivot. A dashed arc of the circle of radius ell about the
                pivot passes through A; the part of it from A up and to the
                right to a point B is drawn thick and labelled C, with an
                arrowhead showing that the bob moves from A toward B. The bob
                sits on C between A and B. Three red arrows start at the bob:
                F pointing horizontally to the right, F G pointing straight
                down, and F T pointing along the cord toward the pivot.
              </p>
            </description>
            <prefigure xmlns="https://prefigure.org" label="pendulum-forces">
              <diagram dimensions="(420,400)" margins="5">
                <definition>L = 4</definition>
                <definition>pivot = (0, L)</definition>
                <definition>bob(t) = (L*sin(t), L - L*cos(t))</definition>
                <definition>th = pi/6</definition>
                <definition>th0 = 5*pi/18</definition>
                <definition>P = bob(th)</definition>
                <coordinates bbox="(-1.5,-1.25,4.6,4.55)" aspect-ratio="1">
                  <group at="support">
                    <rectangle lower-left="(-1.2,L)" dimensions="(4.6,0.35)"
                               stroke="none" fill="#e6d3c3"/>
                    <line endpoints="((-1.2,L), (3.4,L))" stroke="black" thickness="2"/>
                    <line endpoints="(pivot, (0,1.1))" stroke="gray" thickness="1"
                          dash="5 4"/>
                    <point p="pivot" size="3.5" stroke="black" fill="black"/>
                  </group>

                  <group at="axes">
                    <line endpoints="((-1.2,0), (4.3,0))" stroke="gray" thickness="2"
                          arrows="1"/>
                    <line endpoints="((0,-0.5), (0,1.1))" stroke="gray" thickness="2"
                          arrows="1"/>
                    <label anchor="(4.3,0)" alignment="se" offset="(0,-2)">
                      <m>x</m>
                    </label>
                    <label anchor="(0,1.1)" alignment="w" offset="(-4,0)">
                      <m>y</m>
                    </label>
                  </group>

                  <group at="swing">
                    <arc center="pivot" radius="L" range="(-108,-30)" stroke="gray"
                         thickness="1" dash="5 4"/>
                  </group>

                  <group at="path">
                    <parametric-curve function="bob" domain="(0,th0)" stroke="black"
                                      thickness="3" arrows="1" arrow-location="0.3"/>
                    <label anchor="bob(0.22)" alignment="nw" offset="(-2,4)">
                      <m>C</m>
                    </label>
                    <point p="(0,0)" size="4" stroke="black" fill="black"/>
                    <label anchor="(0,0)" alignment="sw" offset="(-3,-3)">
                      <m>A</m>
                    </label>
                    <point p="bob(th0)" size="4" stroke="black" fill="black"/>
                    <label anchor="bob(th0)" alignment="e" offset="(6,0)">
                      <m>B</m>
                    </label>
                  </group>

                  <group at="cord">
                    <line endpoints="(pivot, P)" stroke="#7f6a55" thickness="3"/>
                    <label anchor="(pivot+P)/2" alignment="ne" offset="(4,2)">
                      <m>\ell</m>
                    </label>
                    <arc center="pivot" radius="0.9" range="(-90,-60)" stroke="black"
                         thickness="1"/>
                    <label anchor="pivot+1.2*(sin(th/2), -cos(th/2))" alignment="c">
                      <m>\theta</m>
                    </label>
                  </group>

                  <group at="forces">
                    <vector v="(1.4*tan(th), 0)" tail="P" stroke="red" thickness="3"/>
                    <label anchor="P+(1.4*tan(th), 0)" alignment="e" offset="(4,0)"
                           color="red">
                      <m>\mathbf{F}</m>
                    </label>
                    <vector v="(0, -1.4)" tail="P" stroke="red" thickness="3"/>
                    <label anchor="P+(0,-1.4)" alignment="s" offset="(0,-4)" color="red">
                      <m>\mathbf{F}_{\mathrm{G}}</m>
                    </label>
                    <vector v="(1.4/cos(th))*(-sin(th), cos(th))" tail="P" stroke="red"
                            thickness="3"/>
                    <label anchor="P+(1.4/cos(th))*(-sin(th), cos(th))" alignment="w"
                           offset="(-4,0)" color="red">
                      <m>\mathbf{F}_{\mathrm{T}}</m>
                    </label>
                  </group>

                  <group at="bob">
                    <point p="P" size="6" stroke="black" fill="#e69f00"/>
                  </group>
                </coordinates>

                <annotations>
                  <annotation ref="figure"
                              text="A pendulum bob of mass m on a cord of length ell,
                                    pulled aside by a horizontal force. The bob moves
                                    along a circular arc from its lowest point A to the
                                    point B where the cord makes the angle theta zero
                                    with the vertical">
                    <annotation ref="support"
                                text="The ceiling, with the pivot of the cord and a dashed
                                      vertical line hanging from it"/>
                    <annotation ref="axes"
                                text="The x axis pointing right and the y axis pointing
                                      up, with the origin at the lowest position A of the
                                      bob"/>
                    <annotation ref="swing"
                                text="A dashed arc of the circle of radius ell about the
                                      pivot, on which the bob must stay"/>
                    <annotation ref="path"
                                text="The path C, the part of that arc from A, where theta
                                      is zero, up to B, where theta is theta zero, with an
                                      arrowhead showing the direction of motion"
                                sonify="yes"/>
                    <annotation ref="cord"
                                text="The cord of length ell from the pivot to the bob,
                                      making the angle theta with the vertical"/>
                    <annotation ref="forces"
                                text="The three forces on the bob: the horizontal force F
                                      pointing right, the gravitational force F G pointing
                                      straight down, and the force F T of the cord,
                                      pointing along the cord toward the pivot"/>
                    <annotation ref="bob" text="The bob, partway along the path"/>
                  </annotation>
                </annotations>
              </diagram>
            </prefigure>
          </image>
        </figure>
      </introduction>

      <task xml:id="task-pendulum-force">
        <statement>
          <p>
            Calculate the work done by <m>\mathbf{F}</m> in moving the
            pendulum from <m>\theta=0</m> to <m>\theta=\theta_0</m>.
          </p>
          <sidebyside width="97%">
            <image>
              <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,13);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,12.75) {workspace};
\end{tikzpicture}
              </latex-image>
              <shortdescription>Blank workspace for the work done by the horizontal force on the pendulum.</shortdescription>
            </image>
          </sidebyside>
        </statement>
      </task>

      <task xml:id="task-pendulum-gravity-cord">
        <statement>
          <p>
            Calculate the work done by the gravitational force
            <m>\mathbf{F}_{\mathrm{G}}</m> and the work done by the force
            <m>\mathbf{F}_{\mathrm{T}}</m> of the cord over the same motion.
          </p>
          <sidebyside width="97%">
            <image>
              <latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,11);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,10.75) {workspace};
\end{tikzpicture}
              </latex-image>
              <shortdescription>Blank workspace for the work done by gravity and by the cord.</shortdescription>
            </image>
          </sidebyside>
        </statement>
      </task>
    </exercise>
  </subsection>

</section>
