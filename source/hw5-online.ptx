<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW5, online version: the same problems as the written       -->
<!-- Assignment 5, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw5-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 5</title>

  <introduction>
    <p>
      Sections: <xref ref="section-polar-coordinates" text="title"/> and <xref ref="section-double-integrals-polar-form" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw5-online">

  <figure xml:id="fig-hw5o-polar-chart">
    <caption>
      A blank polar chart for <xref ref="ex-hw5o-rose"/>. The circles are
      <m>r = 0.5</m>, <m>1</m>, <m>1.5</m>, and <m>2</m>, and the spokes are
      spaced <m>\pi/6</m> apart.
    </caption>
    <image width="70%">
      <shortdescription>
      A blank polar grid of four circles and twelve labeled spokes.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw5o-chart">
        <diagram dimensions="(340,340)" margins="10">
          <definition>c1(t) = (0.5*cos(t), 0.5*sin(t))</definition>
          <definition>c2(t) = (cos(t), sin(t))</definition>
          <definition>c3(t) = (1.5*cos(t), 1.5*sin(t))</definition>
          <definition>c4(t) = (2*cos(t), 2*sin(t))</definition>
          <coordinates bbox="(-2.55,-2.55,2.55,2.55)">
            <parametric-curve at="pc-c1" function="c1" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c2" function="c2" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c3" function="c3" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c4" function="c4" domain="(0,2*pi)"
                stroke="#888888" thickness="1"/>
            <repeat at="pc-spokes" parameter="k=0..5">
              <line at="pc-spoke-((k))"
                  endpoints="((2*cos(pi*k/6), 2*sin(pi*k/6)),(-2*cos(pi*k/6), -2*sin(pi*k/6)))"
                  stroke="#cccccc" thickness="1"/>
            </repeat>
            <label at="pc-t0" anchor="(2.12,0)" alignment="e"><m>0</m></label>
            <label at="pc-t1" anchor="(1.84,1.06)" alignment="e">
              <m>\pi/6</m>
            </label>
            <label at="pc-t2" anchor="(1.06,1.84)" alignment="ne">
              <m>\pi/3</m>
            </label>
            <label at="pc-t3" anchor="(0,2.12)" alignment="n">
              <m>\pi/2</m>
            </label>
            <label at="pc-t4" anchor="(-1.06,1.84)" alignment="nw">
              <m>2\pi/3</m>
            </label>
            <label at="pc-t5" anchor="(-1.84,1.06)" alignment="w">
              <m>5\pi/6</m>
            </label>
            <label at="pc-t6" anchor="(-2.12,0)" alignment="w"><m>\pi</m></label>
            <label at="pc-t7" anchor="(-1.84,-1.06)" alignment="w">
              <m>7\pi/6</m>
            </label>
            <label at="pc-t8" anchor="(-1.06,-1.84)" alignment="sw">
              <m>4\pi/3</m>
            </label>
            <label at="pc-t9" anchor="(0,-2.12)" alignment="s">
              <m>3\pi/2</m>
            </label>
            <label at="pc-t10" anchor="(1.06,-1.84)" alignment="se">
              <m>5\pi/3</m>
            </label>
            <label at="pc-t11" anchor="(1.84,-1.06)" alignment="e">
              <m>11\pi/6</m>
            </label>
            <label at="pc-r1" anchor="(0.08,0.5)" alignment="ne"
                color="#666666"><m>0.5</m></label>
            <label at="pc-r2" anchor="(0.08,1)" alignment="ne"
                color="#666666"><m>1</m></label>
            <label at="pc-r3" anchor="(0.08,1.5)" alignment="ne"
                color="#666666"><m>1.5</m></label>
            <label at="pc-r4" anchor="(0.08,2)" alignment="ne"
                color="#666666"><m>2</m></label>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A blank polar grid: four concentric circles of radii one half, one, one and a half and two, crossed by twelve spokes spaced pi over six apart. The spokes are labelled with their angles from zero around to eleven pi over six, and the circles are labelled with their radii along the positive y direction.">
              <annotation ref="pc-c4" text="The outermost circle, of radius two."/>
              <annotation ref="pc-spokes" text="The twelve spokes of the chart, spaced pi over six apart."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw5o-rose">
    <title>A Rose and Its Area</title>
    <statement>
      <p>
        For <m>r(\theta) = 1 + \sin(3\theta)</m>,
        <m>\frac{\pi}{6} \le \theta \le \frac{5\pi}{6}</m>: about
        which axis is the graph symmetric? Type <c>x</c> or <c>y</c>.
      </p>
      <p>Answer: <var width="6"/></p>
      <p>
        In the area integral
        <m>\displaystyle\int\!\!\int r\,dr\,d\theta</m>, the inner
        limits are <m>0</m> to <var width="16"/>, and <m>\theta</m> runs
        from <var width="8"/> to <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="y">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="x">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="1\s*\+\s*sin\s*\(\s*3\s*\*?\s*(theta|t)\s*\)">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.524" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.618" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        Replacing <m>\theta</m> by <m>\pi - \theta</m> gives
        <m>1+\sin(3\pi-3\theta) = 1+\sin(\pi-3\theta)
        = 1+\sin(3\theta)</m>, so <m>r</m> is unchanged: the graph is
        symmetric about the <m>y</m>-axis. The area is
      </p>
      <me>
        A = \int_{\pi/6}^{5\pi/6}\!\!\int_{0}^{1+\sin(3\theta)}
        r\,dr\,d\theta ,
      </me>
      <p>
        which by the symmetry is also
        <m>2\int_{\pi/6}^{\pi/2}\int_0^{1+\sin(3\theta)}
        r\,dr\,d\theta</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-combine">
    <title>Three Integrals Into One</title>
    <statement>
      <p>
        Combine the three integrals of
        <xref ref="ex-hw5o-combine"/> into a single polar integral. In
        <m>\displaystyle\int\!\!\int r^3\sin\theta\cos\theta\,
        dr\,d\theta</m>, the radius runs from <var width="6"/> to
        <var width="6"/> and <m>\theta</m> from <var width="6"/> to
        <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The three pieces together are the part of the annulus
        <m>1 \le r \le 2</m> lying between the <m>x</m>-axis and the line
        <m>y = x</m>. Since <m>xy = r^2\sin\theta\cos\theta</m> and
        <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/>,
      </p>
      <me>
        \int_0^{\pi/4}\!\!\int_1^2 r^3 \sin\theta\cos\theta
        \,dr\,d\theta .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-two-circles">
    <title>Mass Between Two Circles</title>
    <statement>
      <p>
        Find the mass of the region bounded by <m>x^2+y^2 = 2x</m> and
        <m>x^2+y^2 = 2y</m>, whose density is <m>\rho = 1/x</m>.
      </p>
      <p>
        Away from the origin the two circles cross at the polar angle
        <m>\theta = </m> <var width="8"/>, and the mass is
        <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="2.264" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The two circles are <m>r = 2\sin\theta</m> and
        <m>r = 2\cos\theta</m>, meeting where
        <m>\theta = \pi/4</m>. With
        <m>\rho = \frac{1}{r\cos\theta}</m> and
        <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/>,
      </p>
      <md>
        <mrow>
          M \amp = \int_0^{\pi/4}\!\!\int_0^{2\sin\theta}
          \frac{r\,dr\,d\theta}{r\cos\theta}
          + \int_{\pi/4}^{\pi/2}\!\!\int_0^{2\cos\theta}
          \frac{r\,dr\,d\theta}{r\cos\theta}
        </mrow>
        <mrow>
          \amp = 2\int_0^{\pi/4}\tan\theta\,d\theta
          + 2\int_{\pi/4}^{\pi/2} d\theta
          = \ln 2 + \frac{\pi}{2} \approx 2.264 .
        </mrow>
      </md>
    </solution>
  </exercise>
  </exercises>
</section>
