                <annotation ref="rs-region" text="The shaded area, bounded by the curve and the rays theta equals pi over six and five pi over six."/>
                <annotation ref="rs-curve" text="The curve r equals one plus sine three theta for theta from pi over six to five pi over six, symmetric about the y axis." sonify="yes"/>
                <annotation ref="rs-rest" text="The rest of the rose, dotted, which is not part of the problem."/>
