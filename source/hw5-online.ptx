            <annotation ref="figure" text="A blank polar grid: four concentric circles of radii one half, one, one and a half and two, crossed by twelve spokes spaced pi over six apart. The spokes are labelled with their angles from zero around to eleven pi over six, and the circles are labelled with their radii along the positive y direction.">
              <annotation ref="pc-c4" text="The outermost circle, of radius two."/>
              <annotation ref="pc-spokes" text="The twelve spokes of the chart, spaced pi over six apart."/>
            </annotation>
