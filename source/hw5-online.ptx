<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW5, online version: the same problems as the written       -->
<!-- Assignment 5, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw5-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 5</title>

  <introduction>
    <p>
      Sections: <xref ref="section-polar-coordinates" text="title"/> and <xref ref="section-double-integrals-polar-form" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case. Expressions: type only the expression,
      with <c>t</c> for <m>\theta</m>, products with <c>*</c>, powers with
      <c>^</c>, and functions with parentheses, as in <c>5cos(t)</c>,
      <c>sqrt(2)</c>, <c>3/cos(t)</c>. Spaces are ignored.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw5-online">

  <figure xml:id="fig-hw5o-polar-chart">
    <caption>
      A blank polar chart for <xref ref="ex-hw5o-rose"/>. The circles are
      <m>r = 0.5</m>, <m>1</m>, <m>1.5</m>, and <m>2</m>, and the spokes are
      spaced <m>\pi/6</m> apart.
    </caption>
    <image width="70%">
      <shortdescription>
      A blank polar grid of four circles and twelve labeled spokes.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw5o-chart">
        <diagram dimensions="(340,340)" margins="10">
          <definition>c1(t) = (0.5*cos(t), 0.5*sin(t))</definition>
          <definition>c2(t) = (cos(t), sin(t))</definition>
          <definition>c3(t) = (1.5*cos(t), 1.5*sin(t))</definition>
          <definition>c4(t) = (2*cos(t), 2*sin(t))</definition>
          <coordinates bbox="(-2.55,-2.55,2.55,2.55)">
            <parametric-curve at="pc-c1" function="c1" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c2" function="c2" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c3" function="c3" domain="(0,2*pi)"
                stroke="#bbbbbb" thickness="1"/>
            <parametric-curve at="pc-c4" function="c4" domain="(0,2*pi)"
                stroke="#888888" thickness="1"/>
            <repeat at="pc-spokes" parameter="k=0..5">
              <line at="pc-spoke-((k))"
                  endpoints="((2*cos(pi*k/6), 2*sin(pi*k/6)),(-2*cos(pi*k/6), -2*sin(pi*k/6)))"
                  stroke="#cccccc" thickness="1"/>
            </repeat>
            <label at="pc-t0" anchor="(2.12,0)" alignment="e"><m>0</m></label>
            <label at="pc-t1" anchor="(1.84,1.06)" alignment="e">
              <m>\pi/6</m>
            </label>
            <label at="pc-t2" anchor="(1.06,1.84)" alignment="ne">
              <m>\pi/3</m>
            </label>
            <label at="pc-t3" anchor="(0,2.12)" alignment="n">
              <m>\pi/2</m>
            </label>
            <label at="pc-t4" anchor="(-1.06,1.84)" alignment="nw">
              <m>2\pi/3</m>
            </label>
            <label at="pc-t5" anchor="(-1.84,1.06)" alignment="w">
              <m>5\pi/6</m>
            </label>
            <label at="pc-t6" anchor="(-2.12,0)" alignment="w"><m>\pi</m></label>
            <label at="pc-t7" anchor="(-1.84,-1.06)" alignment="w">
              <m>7\pi/6</m>
            </label>
            <label at="pc-t8" anchor="(-1.06,-1.84)" alignment="sw">
              <m>4\pi/3</m>
            </label>
            <label at="pc-t9" anchor="(0,-2.12)" alignment="s">
              <m>3\pi/2</m>
            </label>
            <label at="pc-t10" anchor="(1.06,-1.84)" alignment="se">
              <m>5\pi/3</m>
            </label>
            <label at="pc-t11" anchor="(1.84,-1.06)" alignment="e">
              <m>11\pi/6</m>
            </label>
            <label at="pc-r1" anchor="(0.08,0.5)" alignment="ne"
                color="#666666"><m>0.5</m></label>
            <label at="pc-r2" anchor="(0.08,1)" alignment="ne"
                color="#666666"><m>1</m></label>
            <label at="pc-r3" anchor="(0.08,1.5)" alignment="ne"
                color="#666666"><m>1.5</m></label>
            <label at="pc-r4" anchor="(0.08,2)" alignment="ne"
                color="#666666"><m>2</m></label>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A blank polar grid: four concentric circles of radii one half, one, one and a half and two, crossed by twelve spokes spaced pi over six apart. The spokes are labelled with their angles from zero around to eleven pi over six, and the circles are labelled with their radii along the positive y direction.">
              <annotation ref="pc-c4" text="The outermost circle, of radius two."/>
              <annotation ref="pc-spokes" text="The twelve spokes of the chart, spaced pi over six apart."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw5o-rose">
    <title>A Rose and Its Area</title>
    <statement>
      <p>
        For <m>r(\theta) = 1 + \sin(3\theta)</m>,
        <m>\frac{\pi}{6} \le \theta \le \frac{5\pi}{6}</m>: about
        which axis is the graph symmetric? Type <c>x</c> or <c>y</c>.
      </p>
      <p>Answer: <var width="6"/></p>
      <p>
        In the area integral
        <m>\displaystyle\int\!\!\int r\,dr\,d\theta</m>, the inner
        limits are <m>0</m> to <var width="16"/>, and <m>\theta</m> runs
        from <var width="8"/> to <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="y">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="x">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="1\s*\+\s*sin\s*\(\s*3\s*\*?\s*(theta|t)\s*\)">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.524" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.618" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        Replacing <m>\theta</m> by <m>\pi - \theta</m> gives
        <m>1+\sin(3\pi-3\theta) = 1+\sin(\pi-3\theta)
        = 1+\sin(3\theta)</m>, so <m>r</m> is unchanged: the graph is
        symmetric about the <m>y</m>-axis. The area is
      </p>
      <me>
        A = \int_{\pi/6}^{5\pi/6}\!\!\int_{0}^{1+\sin(3\theta)}
        r\,dr\,d\theta ,
      </me>
      <p>
        which by the symmetry is also
        <m>2\int_{\pi/6}^{\pi/2}\int_0^{1+\sin(3\theta)}
        r\,dr\,d\theta</m>.
      </p>
      <figure xml:id="fig-hw5o-rose-area">
        <caption>
          The curve <m>r = 1 + \sin 3\theta</m> for <m>\pi/6 \le \theta \le 5\pi/6</m> (solid) and the area it bounds, between the rays <m>\theta = \pi/6</m> and <m>\theta = 5\pi/6</m>. The rest of the rose is dotted. The picture is its own mirror image across the <m>y</m>-axis, and along a ray at angle <m>\theta</m> the radius runs from <m>0</m> to <m>1 + \sin 3\theta</m>.
        </caption>
        <image width="80%">
          <shortdescription>
          Two symmetric lobes meeting at the origin, bounded by the curve r equals one plus sine three theta between theta equals pi over six and five pi over six, with the region under them shaded.
          </shortdescription>
          <description>
            <p>
            Coordinate axes with a blue curve starting at the point at angle pi over six and distance two, sweeping up and in to the origin at theta equals pi over two, and back out to the point at angle five pi over six and distance two: two lobes that are mirror images across the y axis. The region between the curve and the two dashed green rays at angles pi over six and five pi over six is shaded tan. The remaining petals of the rose are drawn dotted in gray. An orange segment from the origin to the curve marks a sample radius r.
            </p>
          </description>
          <prefigure xmlns="https://prefigure.org" label="prefigure-hw5o-rose">
            <diagram dimensions="(400,203)" margins="10">
              <definition>rose(t) = ((1 + sin(3*t))*cos(t), (1 + sin(3*t))*sin(t))</definition>
              <coordinates bbox="(-2.95,-0.6,2.95,2.4)">
              <grid-axes at="rs-grid" xlabel="x" ylabel="y"/>
              <polygon at="rs-region" fill="#fbe3d0" stroke="none" closed="yes" points="((0,0),(1.732,1),(1.713,1.029),(1.691,1.057),(1.667,1.083),(1.64,1.106),(1.61,1.128),(1.578,1.147),(1.544,1.164),(1.508,1.178),(1.47,1.19),(1.429,1.199),(1.388,1.206),(1.344,1.21),(1.3,1.212),(1.254,1.211),(1.207,1.207),(1.159,1.201),(1.111,1.192),(1.062,1.18),(1.013,1.166),(0.9642,1.149),(0.915,1.13),(0.8661,1.109),(0.8175,1.085),(0.7694,1.059),(0.722,1.031),(0.6755,1.001),(0.6298,0.9699),(0.5853,0.9367),(0.542,0.902),(0.5,0.866),(0.4594,0.8288),(0.4204,0.7907),(0.383,0.7516),(0.3472,0.7119),(0.3132,0.6717),(0.281,0.6312),(0.2507,0.5906),(0.2222,0.5501),(0.1957,0.5097),(0.171,0.4698),(0.1483,0.4306),(0.1274,0.392),(0.1084,0.3545),(0.0912,0.3181),(0.07581,0.2829),(0.06214,0.2492),(0.05013,0.2171),(0.03971,0.1868),(0.03078,0.1584),(0.02326,0.1319),(0.01705,0.1077),(0.01203,0.08561),(0.008095,0.06592),(0.005116,0.04868),(0.00297,0.03394),(0.001524,0.0218),(0.0006443,0.01229),(0.0001912,0.005475),(2.392e-05,0.00137),(0,0),(-2.392e-05,0.00137),(-0.0001912,0.005475),(-0.0006443,0.01229),(-0.001524,0.0218),(-0.00297,0.03394),(-0.005116,0.04868),(-0.008095,0.06592),(-0.01203,0.08561),(-0.01705,0.1077),(-0.02326,0.1319),(-0.03078,0.1584),(-0.03971,0.1868),(-0.05013,0.2171),(-0.06214,0.2492),(-0.07581,0.2829),(-0.0912,0.3181),(-0.1084,0.3545),(-0.1274,0.392),(-0.1483,0.4306),(-0.171,0.4698),(-0.1957,0.5097),(-0.2222,0.5501),(-0.2507,0.5906),(-0.281,0.6312),(-0.3132,0.6717),(-0.3472,0.7119),(-0.383,0.7516),(-0.4204,0.7907),(-0.4594,0.8288),(-0.5,0.866),(-0.542,0.902),(-0.5853,0.9367),(-0.6298,0.9699),(-0.6755,1.001),(-0.722,1.031),(-0.7694,1.059),(-0.8175,1.085),(-0.8661,1.109),(-0.915,1.13),(-0.9642,1.149),(-1.013,1.166),(-1.062,1.18),(-1.111,1.192),(-1.159,1.201),(-1.207,1.207),(-1.254,1.211),(-1.3,1.212),(-1.344,1.21),(-1.388,1.206),(-1.429,1.199),(-1.47,1.19),(-1.508,1.178),(-1.544,1.164),(-1.578,1.147),(-1.61,1.128),(-1.64,1.106),(-1.667,1.083),(-1.691,1.057),(-1.713,1.029),(-1.732,1))"/>
              <parametric-curve at="rs-curve" function="rose" domain="(pi/6,5*pi/6)" stroke="#0072B2" thickness="3"/>
              <parametric-curve at="rs-rest" function="rose" domain="(5*pi/6,2*pi+pi/6)" stroke="#bbbbbb" thickness="1" dash="3 3"/>
              <line at="rs-ray1" endpoints="((0,0),(1.732,1))" stroke="#009E73" thickness="2" dash="6 4"/>
              <line at="rs-ray2" endpoints="((0,0),(-1.732,1))" stroke="#009E73" thickness="2" dash="6 4"/>
              <line at="rs-sample" endpoints="((0,0),(0.382,0.7506))" stroke="#D55E00" thickness="2"/>
              <point at="rs-out" p="(0.382,0.7506)" fill="#D55E00" size="3.5"/>
              <point at="rs-A" p="(1.732,1)" fill="black" size="3.5"/>
              <point at="rs-B" p="(-1.732,1)" fill="black" size="3.5"/>
              <label at="rs-t1" anchor="(1.732,1)" alignment="e" offset="(4,0)" color="#009E73"><m>\theta=\tfrac{\pi}{6}</m></label>
              <label at="rs-t2" anchor="(-1.732,1)" alignment="w" offset="(-4,0)" color="#009E73"><m>\theta=\tfrac{5\pi}{6}</m></label>
              <label at="rs-clab" anchor="(0.55,1.95)" alignment="ne" color="#0072B2"><m>r=1+\sin 3\theta</m></label>
