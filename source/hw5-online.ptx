8),(7.499e-33,1.225e-16))"/>
              <parametric-curve at="tc-a" function="a" domain="(-pi/2,pi/2)" stroke="#0072B2" thickness="3"/>
              <parametric-curve at="tc-b" function="b" domain="(0,pi)" stroke="#D55E00" thickness="3"/>
