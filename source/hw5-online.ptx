        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw5o-rose">
    <title>A Rose and Its Area</title>
    <statement>
      <p>
        For <m>r(\theta) = 1 + \sin(3\theta)</m>,
        <m>\frac{\pi}{6} \le \theta \le \frac{5\pi}{6}</m>: about
        which axis is the graph symmetric? Type <c>x</c> or <c>y</c>.
      </p>
      <p>Answer: <var width="6"/></p>
      <p>
        In the area integral
        <m>\displaystyle\int\!\!\int r\,dr\,d\theta</m>, the inner
        limits are <m>0</m> to <var width="16"/>, and <m>\theta</m> runs
        from <var width="8"/> to <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="y">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="x">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="1\s*\+\s*sin\s*\(\s*3\s*\*?\s*(theta|t)\s*\)">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.524" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.618" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        Replacing <m>\theta</m> by <m>\pi - \theta</m> gives
        <m>1+\sin(3\pi-3\theta) = 1+\sin(\pi-3\theta)
        = 1+\sin(3\theta)</m>, so <m>r</m> is unchanged: the graph is
        symmetric about the <m>y</m>-axis. The area is
      </p>
      <me>
        A = \int_{\pi/6}^{5\pi/6}\!\!\int_{0}^{1+\sin(3\theta)}
        r\,dr\,d\theta ,
      </me>
      <p>
        which by the symmetry is also
        <m>2\int_{\pi/6}^{\pi/2}\int_0^{1+\sin(3\theta)}
        r\,dr\,d\theta</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-combine">
    <title>Three Integrals Into One</title>
    <statement>
      <p>
        Combine the three integrals of
        <xref ref="ex-hw5o-combine"/> into a single polar integral. In
        <m>\displaystyle\int\!\!\int r^3\sin\theta\cos\theta\,
        dr\,d\theta</m>, the radius runs from <var width="6"/> to
        <var width="6"/> and <m>\theta</m> from <var width="6"/> to
        <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The three pieces together are the part of the annulus
        <m>1 \le r \le 2</m> lying between the <m>x</m>-axis and the line
        <m>y = x</m>. Since <m>xy = r^2\sin\theta\cos\theta</m> and
        <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/>,
      </p>
      <me>
        \int_0^{\pi/4}\!\!\int_1^2 r^3 \sin\theta\cos\theta
        \,dr\,d\theta .
      </me>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-two-circles">
    <title>Mass Between Two Circles</title>
    <statement>
      <p>
        Find the mass of the region bounded by <m>x^2+y^2 = 2x</m> and
        <m>x^2+y^2 = 2y</m>, whose density is <m>\rho = 1/x</m>.
      </p>
      <p>
        Away from the origin the two circles cross at the polar angle
        <m>\theta = </m> <var width="8"/>, and the mass is
        <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="2.264" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The two circles are <m>r = 2\sin\theta</m> and
        <m>r = 2\cos\theta</m>, meeting where
        <m>\theta = \pi/4</m>. With
        <m>\rho = \frac{1}{r\cos\theta}</m> and
        <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/>,
      </p>
      <md>
        <mrow>
          M \amp = \int_0^{\pi/4}\!\!\int_0^{2\sin\theta}
          \frac{r\,dr\,d\theta}{r\cos\theta}
          + \int_{\pi/4}^{\pi/2}\!\!\int_0^{2\cos\theta}
          \frac{r\,dr\,d\theta}{r\cos\theta}
        </mrow>
        <mrow>
          \amp = 2\int_0^{\pi/4}\tan\theta\,d\theta
          + 2\int_{\pi/4}^{\pi/2} d\theta
          = \ln 2 + \frac{\pi}{2} \approx 2.264 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-polar-points">
    <title>Polar Coordinates of Two Points</title>
    <statement>
      <p>
        Find polar coordinates <m>(r,\theta)</m> of each point below,
        with <m>0 \le \theta \lt 2\pi</m>, first with <m>r \gt 0</m> and
        then with <m>r \lt 0</m>. Enter <m>\theta</m> in radians as a
        decimal.
      </p>
      <p>
        (a) The point with Cartesian coordinates <m>(1,1)</m>.
      </p>
      <p>
        With <m>r \gt 0</m>: <m>r = </m> <var width="8"/>,
        <m>\theta = </m> <var width="8"/>.
      </p>
      <p>
        With <m>r \lt 0</m>: <m>r = </m> <var width="8"/>,
        <m>\theta = </m> <var width="8"/>.
      </p>
      <p>
        (b) The point with Cartesian coordinates <m>(2\sqrt3,\,-2)</m>.
      </p>
      <p>
        With <m>r \gt 0</m>: <m>r = </m> <var width="8"/>,
        <m>\theta = </m> <var width="8"/>.
      </p>
      <p>
        With <m>r \lt 0</m>: <m>r = </m> <var width="8"/>,
        <m>\theta = </m> <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1.414" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="-1.414" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="3.927" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="4" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="5.760" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="-4" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="2.618" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        (a) <m>r = \sqrt{1^2+1^2} = \sqrt2</m> and the point lies on the
        ray <m>\theta = \pi/4</m>, so <m>(r,\theta) = (\sqrt2, \pi/4)
        \approx (1.414, 0.785)</m>. A negative <m>r</m> points the
        opposite way, so the same point is
        <m>(-\sqrt2, 5\pi/4) \approx (-1.414, 3.927)</m>.
      </p>
      <p>
        (b) <m>r = \sqrt{12 + 4} = 4</m>. The point is in the fourth
        quadrant with <m>\tan\theta = -2/(2\sqrt3) = -1/\sqrt3</m>, so
        <m>\theta = 11\pi/6 \approx 5.760</m>: <m>(4, 11\pi/6)</m>. With
        <m>r \lt 0</m>, add <m>\pi</m> to the angle:
        <m>(-4, 5\pi/6) \approx (-4, 2.618)</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-limacon-point">
    <title>A Point on a Polar Curve</title>
    <statement>
      <p>
        A curve in polar coordinates is given by
        <m>r = 12 + 2\cos\theta</m>, and the point <m>P</m> on it is at
        <m>\theta = \dfrac{26\pi}{24}</m>.
      </p>
      <p>
        (a) Find the polar coordinate <m>r</m> of <m>P</m>, with
        <m>r \gt 0</m> and <m>\pi \lt \theta \lt \frac{3\pi}{2}</m>:
        <m>r = </m> <var width="8"/>.
      </p>
      <p>
        (b) Find the Cartesian coordinates of <m>P</m>:
        <m>x = </m> <var width="8"/>, <m>y = </m> <var width="8"/>.
      </p>
      <p>
        (c) How many times does the curve pass through the origin as
        <m>\theta</m> runs over <m>0 \lt \theta \lt 2\pi</m>?
        Answer: <var width="4"/>
      </p>
    </statement>
    <setup>
      <var>
        <condition number="10.068" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="-9.725" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="-2.606" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="0" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        (a) <m>\theta = 26\pi/24 = 13\pi/12</m> already lies in
        <m>(\pi, 3\pi/2)</m>, so
        <m>r = 12 + 2\cos(13\pi/12) = 12 - 2\cos(\pi/12)
        \approx 10.068</m>, which is positive.
      </p>
      <p>
        (b) <m>x = r\cos\theta \approx 10.068 \cdot (-0.9659)
        \approx -9.725</m> and
        <m>y = r\sin\theta \approx 10.068 \cdot (-0.2588)
        \approx -2.606</m>.
      </p>
      <p>
        (c) Since <m>-1 \le \cos\theta \le 1</m>, we have
        <m>r = 12 + 2\cos\theta \ge 10</m> for every <m>\theta</m>, so
        <m>r</m> is never zero: the curve never passes through the origin.
        The answer is <m>0</m>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-cartesian-to-polar">
    <title>Cartesian Equations in Polar Form</title>
    <statement>
      <p>
        Write each equation in polar coordinates, solved for <m>r</m>.
        Type only the right-hand side, using <c>t</c> for
        <m>\theta</m>: for instance <c>3/cos(t)</c>, <c>sqrt(5)</c>,
        <c>2sin(t)</c>.
      </p>
      <p>
        (a) <m>y = 10</m>: <m>r = </m> <var width="14"/>
      </p>
      <p>
        (b) <m>x^2 + y^2 = 2</m>: <m>r = </m> <var width="14"/>
      </p>
      <p>
        (c) <m>x^2 + y^2 - 5x = 0</m>: <m>r = </m> <var width="14"/>
      </p>
      <p>
        (d) <m>x^2(x^2 + y^2) = 8y^2</m>, assuming <m>r \ge 0</m>:
        <m>r = </m> <var width="18"/>
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="(?:10\s*/\s*sin\s*\(\s*t\s*\)|10\s*\*?\s*csc\s*\(\s*t\s*\))">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="(?:sqrt\s*\(\s*2\s*\)|2\s*\^\s*\(\s*1\s*/\s*2\s*\)|2\s*\^\s*0?\.5|1\.414\d*)">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="5\s*\*?\s*cos\s*\(\s*t\s*\)">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="(?:(2\s*\*?\s*sqrt\s*\(\s*2\s*\)|sqrt\s*\(\s*8\s*\)|8\s*\^\s*\(\s*1\s*/\s*2\s*\)|2\.828\d*)\s*\*?\s*(tan\s*\(\s*t\s*\)|sin\s*\(\s*t\s*\)\s*/\s*cos\s*\(\s*t\s*\)))">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        Use <m>x = r\cos\theta</m>, <m>y = r\sin\theta</m>, and
        <m>x^2 + y^2 = r^2</m>.
      </p>
      <p>
        (a) <m>r\sin\theta = 10</m>, so <m>r = 10/\sin\theta
        = 10\csc\theta</m>.
      </p>
      <p>
        (b) <m>r^2 = 2</m>, so <m>r = \sqrt2</m>: a circle of radius
        <m>\sqrt2</m> about the origin.
      </p>
      <p>
        (c) <m>r^2 - 5r\cos\theta = 0</m>; dividing by <m>r</m> gives
        <m>r = 5\cos\theta</m>, the circle of diameter <m>5</m> through
        the origin centered at <m>(5/2, 0)</m>.
      </p>
      <p>
        (d) <m>r^2\cos^2\theta \cdot r^2 = 8r^2\sin^2\theta</m>, so
        <m>r^2\cos^2\theta = 8\sin^2\theta</m> and, with <m>r \ge 0</m>,
        <m>r = \sqrt8\,\dfrac{\sin\theta}{\cos\theta}
        = 2\sqrt2\,\tan\theta</m> (on the angles where this is
        nonnegative).
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-half-disk">
    <title>A Half-Disk Integral in Polar Form</title>
    <statement>
      <p>
        Sketch the region of integration and evaluate by changing to polar
        coordinates:
      </p>
      <me>
        \int_{9}^{18}\!\!\int_{0}^{\sqrt{18x - x^2}}
        \frac{1}{\sqrt{x^2+y^2}}\,dy\,dx .
      </me>
      <p>
        Answer: <var width="10"/>
      </p>
    </statement>
    <setup>
      <var>
        <condition number="4.796" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The curve <m>y = \sqrt{18x - x^2}</m> is the upper half of
        <m>x^2 + y^2 = 18x</m>, the circle of radius <m>9</m> centered at
        <m>(9,0)</m>, which in polar form is <m>r = 18\cos\theta</m>. The
        condition <m>x \ge 9</m> is <m>r\cos\theta \ge 9</m>, that is
        <m>r \ge 9\sec\theta</m>. The vertical line and the circle meet
        where <m>18\cos\theta = 9\sec\theta</m>, so <m>\cos^2\theta =
        1/2</m> and <m>\theta = \pi/4</m>. The region is the part of the
        upper half-disk to the right of <m>x = 9</m>, described by
        <m>0 \le \theta \le \pi/4</m>,
        <m>9\sec\theta \le r \le 18\cos\theta</m>. With
        <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/> and
        <m>1/\sqrt{x^2+y^2} = 1/r</m>,
      </p>
      <md>
        <mrow>
          \int_0^{\pi/4}\!\!\int_{9\sec\theta}^{18\cos\theta}
          \frac{1}{r}\,r\,dr\,d\theta
          \amp = \int_0^{\pi/4} \left(18\cos\theta - 9\sec\theta\right)
          d\theta
        </mrow>
        <mrow>
          \amp = \Big[\,18\sin\theta
          - 9\ln\lvert\sec\theta + \tan\theta\rvert\,\Big]_0^{\pi/4}
          = 9\sqrt2 - 9\ln\!\left(1 + \sqrt2\right) \approx 4.796 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-cardioid-circle">
    <title>Between a Circle and a Cardioid</title>
    <statement>
      <p>
        Use a double integral in polar coordinates to find the area of the
        region bounded on the inside by the circle of radius <m>5</m>
        centered at the origin and on the outside by the cardioid
        <m>r = 5(1 + \cos\theta)</m>.
      </p>
      <p>
        Area: <var width="10"/>
      </p>
    </statement>
    <setup>
      <var>
        <condition number="69.635" tolerance="0.05">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The circle is <m>r = 5</m>, and it meets the cardioid where
        <m>5(1+\cos\theta) = 5</m>, that is <m>\cos\theta = 0</m>,
        <m>\theta = \pm\pi/2</m>. The cardioid is outside the circle
        exactly when <m>\cos\theta \gt 0</m>, so the region is
        <m>-\pi/2 \le \theta \le \pi/2</m>,
        <m>5 \le r \le 5(1+\cos\theta)</m>, and
      </p>
      <md>
        <mrow>
          A \amp = \int_{-\pi/2}^{\pi/2}\!\!\int_{5}^{5(1+\cos\theta)}
          r\,dr\,d\theta
          = \frac{25}{2}\int_{-\pi/2}^{\pi/2}
          \left[(1+\cos\theta)^2 - 1\right] d\theta
        </mrow>
        <mrow>
          \amp = \frac{25}{2}\int_{-\pi/2}^{\pi/2}
          \left(2\cos\theta + \cos^2\theta\right) d\theta
          = \frac{25}{2}\left(4 + \frac{\pi}{2}\right)
          = 50 + \frac{25\pi}{4} \approx 69.635 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw5o-triangle-polar">
    <title>A Triangle in Polar Coordinates</title>
    <statement>
      <p>
        Convert the integral
        <m>\displaystyle\int_{0}^{\sqrt{10}}\!\!\int_{-x}^{x} dy\,dx</m>
        to polar coordinates and evaluate it. Use <c>t</c> for
        <m>\theta</m>; enter the limits <m>a</m>, <m>b</m>, <m>c</m> as
        decimal numbers and <m>d</m>, like the integrands, as an
        expression in <c>t</c> (for instance <c>3/cos(t)</c>).
      </p>
      <p>
        With <m>a = </m> <var width="8"/>, <m>b = </m> <var width="8"/>,
        <m>c = </m> <var width="8"/>, and <m>d = </m> <var width="14"/>,
        the integral becomes
        <m>\displaystyle\int_a^b\!\!\int_c^d</m> <var width="8"/>
        <m>dr\,dt</m>
        <m>\displaystyle = \int_a^b</m> <var width="14"/> <m>dt</m>
        <m>\displaystyle = \Big[</m> <var width="14"/>
        <m>\Big]_a^b</m>
        <m>=</m> <var width="8"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="-0.785" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="0" tolerance="0.005">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="(?:(sqrt\s*\(\s*10\s*\)|10\s*\^\s*\(\s*1\s*/\s*2\s*\)|3\.162\d*)\s*(/\s*cos\s*\(\s*t\s*\)|\*?\s*sec\s*\(\s*t\s*\)))">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="r">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="(?:5\s*\*?\s*(sec\s*\(\s*t\s*\)\s*\^\s*2|sec\s*\^\s*2\s*\(\s*t\s*\))|5\s*/\s*(cos\s*\(\s*t\s*\)\s*\^\s*2|cos\s*\^\s*2\s*\(\s*t\s*\))|\(?\s*sqrt\s*\(\s*10\s*\)\s*/\s*cos\s*\(\s*t\s*\)\s*\)?\s*\^\s*2\s*/\s*2)">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var case="insensitive">
        <condition string="(?:5\s*\*?\s*tan\s*\(\s*t\s*\)|5\s*\*?\s*sin\s*\(\s*t\s*\)\s*/\s*cos\s*\(\s*t\s*\))">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
      <var>
        <condition number="10" tolerance="0.01">
          <feedback><p>Correct.</p></feedback>
        </condition>
        <condition string=".*">
          <feedback><p>Incorrect.</p></feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw5-solutions">
      <p>
        The region <m>0 \le x \le \sqrt{10}</m>, <m>-x \le y \le x</m> is
        the triangle with vertices <m>(0,0)</m>,
        <m>(\sqrt{10}, \sqrt{10})</m>, and <m>(\sqrt{10}, -\sqrt{10})</m>.
        The two slanted sides are the rays <m>\theta = \pm\pi/4</m>, and
        the vertical side <m>x = \sqrt{10}</m> is
        <m>r\cos\theta = \sqrt{10}</m>, that is
        <m>r = \sqrt{10}\sec\theta</m>. So <m>a = -\pi/4</m>,
        <m>b = \pi/4</m>, <m>c = 0</m>, <m>d = \sqrt{10}\sec\theta</m>,
        and with <m>dA = r\,dr\,d\theta</m> by
        <xref ref="eq-polar-area-element"/>,
      </p>
      <md>
        <mrow>
          \int_{-\pi/4}^{\pi/4}\!\!\int_{0}^{\sqrt{10}\sec\theta}
          r\,dr\,d\theta
          \amp = \int_{-\pi/4}^{\pi/4} 5\sec^2\theta\,d\theta
          = \Big[\,5\tan\theta\,\Big]_{-\pi/4}^{\pi/4}
        </mrow>
        <mrow>
          \amp = 5 - (-5) = 10 ,
        </mrow>
      </md>
      <p>
        which is the triangle's area:
        <m>\tfrac12 \cdot 2\sqrt{10} \cdot \sqrt{10} = 10</m>.
      </p>
    </solution>
  </exercise>
  </exercises>
</section>
