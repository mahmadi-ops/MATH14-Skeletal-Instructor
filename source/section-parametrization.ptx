\node[left=3pt, font=\footnotesize] at (0,1) {$1$};
\node[font=\small\itshape] at (0.5,-0.9517) {A.};
\end{tikzpicture}
]]></latex-image>
            <shortdescription>Empty coordinate grid for part A, for sketching the segment from zero comma one to one comma zero.</shortdescription>
          </image>
          <image>
            <latex-image><![CDATA[
\begin{tikzpicture}[x=0.75cm, y=0.75cm, >=stealth, font=\small]
\useasboundingbox (-4,-4.9333) rectangle (4,4);
\draw[gray!30, very thin, step=0.5] (-3.5,-3.5) grid (3.5,3.5);
\draw[->, thick] (-3.6,0) -- (3.6,0) node[right] {$x$};
\draw[->, thick] (0,-3.6) -- (0,3.6) node[above] {$y$};
\foreach \x in {-3,-2,-1,1,2,3} \draw (\x,-0.12) -- (\x,0.12) node[below=3pt, font=\footnotesize] {$\x$};
\foreach \y in {-3,-2,-1,1,2,3} \draw (-0.12,\y) -- (0.12,\y) node[left=3pt, font=\footnotesize] {$\y$};
\node[font=\small\itshape] at (0,-4.4667) {B.};
\end{tikzpicture}
