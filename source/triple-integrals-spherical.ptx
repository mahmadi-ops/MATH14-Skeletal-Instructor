</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-halfdisk-prefigure">
<caption>
The <m>xy</m>-projection of the solid in
<xref ref="example-spherical-rewrite"/>: the lower half of the unit
disk.
</caption>
<image width="45%">
<shortdescription>
The lower half of the unit disk, shaded.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-halfdisk">
<diagram dimensions="(384,215)" margins="10">
<definition>arc(t) = (cos(t), sin(t))</definition>
<coordinates bbox="(-1.5,-1.35,2.1,0.65)">
<axes at="hd-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<polygon at="hd-region" fill="#f5c6bc" stroke="none" closed="yes"
    points="((1,0),(0.9877,-0.1564),(0.9511,-0.309),(0.891,-0.454),(0.809,-0.5878),(0.7071,-0.7071),(0.5878,-0.809),(0.454,-0.891),(0.309,-0.9511),(0.1564,-0.9877),(0,-1),(-0.1564,-0.9877),(-0.309,-0.9511),(-0.454,-0.891),(-0.5878,-0.809),(-0.7071,-0.7071),(-0.809,-0.5878),(-0.891,-0.454),(-0.9511,-0.309),(-0.9877,-0.1564),(-1,0))"/>
<parametric-curve at="hd-arc" function="arc" domain="(pi,2*pi)"
    stroke="#D55E00" thickness="3"/>
<line at="hd-diam" endpoints="((-1,0),(1,0))" stroke="#555555"
    thickness="2"/>
<label at="hd-eq" anchor="(0.72,-0.85)" alignment="se"
    color="#D55E00"><m>y = -\sqrt{1-x^2}</m></label>
<point at="hd-1" p="(1,0)" fill="black" alignment="ne">
<m>1</m>
</point>
<point at="hd-m1" p="(-1,0)" fill="black" alignment="nw">
<m>-1</m>
</point>
</coordinates>
<annotations>
<annotation ref="figure" text="The lower half of the unit disk, below the x axis, shaded light red. Its curved boundary y equals negative square root of one minus x squared is drawn in vermillion.">
  <annotation ref="hd-region" text="The projection: the lower half of the unit disk."/>
  <annotation ref="hd-arc" text="The lower half of the unit circle."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>

<figure xml:id="fig-cone-plane-tikz">
<caption>
The solid of <xref ref="example-spherical-rewrite"/>: over the lower
half disk, between the cone <m>z = \sqrt{x^2+y^2}</m> and the plane
<m>z = 1</m>.
</caption>
<image width="60%">
<shortdescription>
A half cone over the negative y half plane, capped by a flat half disk.
</shortdescription>
<description>
Three coordinate axes in space with a half cone opening upward from
the origin at forty five degrees, over the half of the plane with y
negative, capped above by the flat half disk in the plane z equals
one. The straight edge of the cap lies over the x axis.
</description>
<latex-image>
<![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  % Okabe-Ito colorblind-safe palette
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oivermillion}{RGB}{213,94,0}
  \definecolor{oigreen}{RGB}{0,158,115}
  \begin{axis}[
      view={35}{18},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!75, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=-1.3, xmax=1.5, ymin=-1.5, ymax=1.3, zmin=0, zmax=1.6,
      clip=false,
    ]
    % half cone z = r over theta in [180,360]
    \addplot3[surf, shader=interp,
              colormap={softk}{color=(oigreen!12!white) color=(oigreen!42!white)},
              opacity=0.45, fill opacity=0.45,
              domain=180:360, samples=25,
              y domain=0:1, samples y=7,
              z buffer=sort, forget plot]
      ({y*cos(x)}, {y*sin(x)}, {y});
    % top half disk z = 1
    \fill[oiblue, opacity=0.35]
      (axis cs:1,0,1)
      \foreach \a in {350,340,...,180} { -- (axis cs:{cos(\a)},{sin(\a)},1) }
      -- cycle;
    \draw[oiblue, line width=1.2pt]
      (axis cs:1,0,1)
      \foreach \a in {350,340,...,180} { -- (axis cs:{cos(\a)},{sin(\a)},1) }
      -- cycle;
    % cone edge lines
    \draw[oigreen!60!black, line width=1.0pt]
      (axis cs:0,0,0) -- (axis cs:1,0,1)
      (axis cs:0,0,0) -- (axis cs:-1,0,1);
    % projection half disk (dashed)
    \draw[oivermillion, line width=1.0pt, dashed]
      (axis cs:1,0,0)
      \foreach \a in {350,340,...,180} { -- (axis cs:{cos(\a)},{sin(\a)},0) }
      -- cycle;
    % labels
    \node[oiblue, anchor=west, font=\small]
      at (axis cs:1.08,0,1.0) {$z = 1$};
    \draw[oigreen!60!black, line width=0.5pt]
      (axis cs:0.55,-0.25,0.6) -- (axis cs:1.15,0,0.3);
    \node[oigreen!60!black, anchor=west, font=\small]
      at (axis cs:1.15,0,0.3) {$z = \sqrt{x^2+y^2}$};
    \node[oivermillion, anchor=north, font=\small]
      at (axis cs:0.1,-1.15,-0.12) {projection};
  \end{axis}
\end{tikzpicture}]]>
</latex-image>
</image>
</figure>

<exercise xml:id="exercise-spherical-volume">
<statement>
<p>
Calculate the volume of the region inside <m>\rho = 2\cos\phi</m> and
below <m>z = \sqrt{x^2+y^2}</m>.
</p>
