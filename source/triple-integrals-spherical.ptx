<subsection xml:id="sec-spherical-rewrite">
<title>Re-Writing an Integral in Spherical and Cylindrical Coordinates</title>

<example xml:id="example-spherical-rewrite">
<title>Example V</title>
<statement>
<p>
Re-write (do not evaluate) the following integral in
<em>spherical</em> and <em>cylindrical</em> coordinates:
</p>

<me>
\int_{-1}^{1}\!\!\int_{-\sqrt{1-x^2}}^{0}
\!\!\int_{\sqrt{x^2+y^2}}^{1}
(x^2+y^2)\, dz\,dy\,dx.
</me>
<p>
<em>Solution.</em>
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,12);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,11.75) {workspace};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank workspace for Example V.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

