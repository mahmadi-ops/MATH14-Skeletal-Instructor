<!-- MATH 14 - Assignment 2, the version WITH solutions.                        -->
<!--                                                                        -->
<!-- Statements come from the written assignment, solutions from the auto-   -->
<!-- graded version; each problem is a <problem> whose <solution> is printed -->
<!-- directly beneath it.  The auto-graded version is hw2-online.ptx.        -->
<!--                                                                        -->
<!-- HIDING THE SOLUTIONS.  Every <solution> here carries                    -->
<!--   component="hw2-solutions"                                            -->
<!-- so this assignment's solutions can be switched off from                 -->
<!-- publication/publication.ptx; see the comment in <source> there.         -->
<section xml:id="sec-solutions-hw2" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 2</title>

    <p>
    Section: <xref ref="sec-line-integrals" text="title"/>.
    </p>

  <p>
    Work each problem yourself first; the full solution follows immediately
    below it. The auto-graded version of the same problems is
    <xref ref="sec-exercises-hw2-online" text="title"/>.
  </p>

  <problem xml:id="ex-hw2-quarter-circle">
    <statement>
      <p>
      Consider a wire whose shape is a quarter circle of radius one,
      centered at <m>(a,0)</m>, where <m>a \gt 0</m>. The density of the
      wire is
      </p>

      <me>
      \rho(x,y) = \frac{18(x-a)y}{(x-a)^2 + y^2}
      </me>

      <p>
      measured in kilograms per meter. Find the total mass of the wire.
      </p>
    </statement>
    <solution component="hw2-solutions">
      <p>
      Parametrize the quarter circle by
      <m>\mathbf{r}(t) = \left\langle R\cos t + a,\ R\sin t
      \right\rangle</m>, <m>0 \le t \le \pi/2</m>, where <m>R</m> is
      the radius. Then <m>\lVert\mathbf{v}\rVert = R</m> and
      <m>(x-a)^2 + y^2 = R^2</m>, so the density along the wire is
      </p>

      <me>
      \rho = \frac{k\,(R\cos t)(R\sin t)}{R^2} = k\cos t\sin t
      = \frac{k}{2}\sin(2t) ,
      </me>

      <p>
      where <m>k</m> is the coefficient in the numerator. Hence
      </p>

      <me>
      M = \int_0^{\pi/2} \frac{k}{2}\sin(2t)\;R\,dt
      = \frac{kR}{2}\Big[-\tfrac12\cos(2t)\Big]_0^{\pi/2}
      = \frac{kR}{2} .
      </me>

      <p>
      The center <m>a</m> never enters: shifting the wire sideways moves
      the density with it.
      </p>
      <p>
        Here the density constant is <m>18</m> and the radius is <m>1</m>,
        so the mass is <m>\dfrac{(18)(1)}{2} = 9</m> kilograms.
      </p>    </solution>
  </problem>

  <problem xml:id="ex-hw2-segment">
    <statement>
      <p>
      Evaluate the line integral
      <m>\displaystyle\int_C (x - y + z - 2)\,ds</m>, where <m>C</m> is
      the straight-line segment parametrized by <m>x = t</m>,
      <m>y = 1-t</m>, and <m>z = 1</m>, from <m>(0,1,1)</m> to
      <m>(1,0,1)</m>.
      </p>
    </statement>
    <solution component="hw2-solutions">
      <p>
      Here <m>x-y+z-2 = t-(1-t)+1-2 = 2t-2</m> and
      <m>\mathbf{v} = \left\langle 1,-1,0 \right\rangle</m>, so
      <m>\lVert \mathbf{v} \rVert = \sqrt2</m>, and <m>t</m> runs
      from <m>0</m> to <m>1</m>:
      </p>

      <md>
      <mrow>
      \int_C (x-y+z-2)\,ds \amp = \sqrt2\int_0^1 (2t-2)\,dt
      </mrow>
      <mrow>
      \amp = \sqrt2\Big[(t-1)^2\Big]_0^1 = -\sqrt2 \approx -1.414 .
      </mrow>
      </md>
    </solution>
  </problem>

  <problem xml:id="ex-hw2-square-path">
    <statement>
      <p>
      Evaluate the line integral
      <m>\displaystyle\int_C \frac{1}{x^2 + y^2 + 1}\,ds</m> over the
      curve <m>C</m> of <xref ref="fig-hw2-square"/>.
      </p>
    </statement>
    <solution component="hw2-solutions">
      <p>
      On the side from <m>(0,0)</m> to <m>(1,0)</m>,
      <m>f = 1/(t^2+1)</m> and <m>ds = dt</m>, giving
      <m>\tan^{-1}(1) = \pi/4 \approx 0.785</m>; the side on the
      <m>y</m>-axis gives the same. On each of the other two sides
      <m>f = 1/(t^2+2)</m>, giving
      <m>\frac{1}{\sqrt2}\tan^{-1}\left(\frac{1}{\sqrt2}\right)
      \approx 0.615</m>. Adding,
      </p>

      <me>
      \int_C f\,ds = \frac{\pi}{2}
      + \sqrt2 \tan^{-1}\left(\frac{1}{\sqrt2}\right)
      \approx 2.441 .
      </me>

      <p>
      A line integral of a scalar function does not depend on the
      direction of travel, and opposite sides of the square give equal
      contributions.
      </p>
    </solution>
  </problem>

