<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW3, online version: the same problems as the written       -->
<!-- Assignment 3, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw3-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 3</title>

  <introduction>
    <p>
      Section: <xref ref="sec-vector-fields" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw3-online">

  <figure xml:id="fig-hw3o-field">
    <caption>
      The vector field <m>\mathbf{F}</m> and the curve <m>C</m> of
      <xref ref="ex-hw3o-sign"/>. The curve is traversed in the direction of
      the arrowhead.
    </caption>
    <image width="70%">
      <shortdescription>
      A field over the first quadrant tilting from downward to rightward, with a blue circle.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw3o-field">
        <diagram dimensions="(380,320)" margins="10">
          <definition>F(x,y) = (0.30*y, -0.30)</definition>
          <definition>circle(t) = (1.5 + 1.05*cos(t), 1.35 + 1.05*sin(t))</definition>
          <coordinates bbox="(-0.35,-0.35,3.35,2.95)">
            <axes at="hf-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <repeat at="hf-cols" parameter="i=0..6">
              <repeat parameter="j=0..5">
                <vector at="hf-v-((i))-((j))" v="F(0.45*i+0.15, 0.5*j+0.1)"
                    tail="(0.45*i+0.15, 0.5*j+0.1)" stroke="#009E73"
                    thickness="2"/>
              </repeat>
            </repeat>
            <parametric-curve at="hf-C" function="circle" domain="(0,2*pi)"
                stroke="#0072B2" thickness="3"/>
            <vector at="hf-Cdir" v="(0.02,0.30)" tail="(2.54,1.15)"
                stroke="#0072B2" thickness="3"/>
            <label at="hf-Clabel" anchor="(1.5,1.35)" alignment="center"
                color="#0072B2"><m>C</m></label>
            <label at="hf-Flabel" anchor="(2.75,2.70)" alignment="e"
                color="#009E73"><m>\mathbf{F}</m></label>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A grid of green field vectors over the first quadrant, together with a blue circle. Near the x axis the field vectors point almost straight down and are short. Higher up they tilt to the right and grow longer, so the field is strongest across the top of the circle. The circle is traversed counterclockwise, and its right side carries an arrowhead pointing upward.">
              <annotation ref="hf-C" text="The closed curve C, a circle, traversed in the direction of the arrowhead on its right side, counterclockwise."/>
              <annotation ref="hf-Cdir" text="The arrowhead giving the direction of travel along C, pointing upward on the right side of the circle."/>
              <annotation ref="hf-cols" text="The field vectors. They are short and nearly vertical near the x axis and grow longer and more tilted as y increases."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw3o-sign">
    <title>The Sign of a Line Integral</title>
    <statement>
      <p>
        For the field and curve of <xref ref="fig-hw3o-field"/>, is
        <m>\displaystyle\oint_C \mathbf{F} \cdot d\mathbf{r}</m>
        positive, negative, or zero? Type one word:
        <c>positive</c>, <c>negative</c>, or <c>zero</c>.
      </p>
      <p>Answer: <var width="12"/></p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="negative">
          <feedback>
   <p>Correct.</p>
 </feedback>
        </condition>
        <condition string="positive">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
        <condition string="zero">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw3-solutions">
      <p>
        Along the bottom of <m>C</m> the field and the unit tangent make
        acute angles, so <m>\mathbf{F} \cdot \hat{\mathbf{T}} \gt 0</m>
        there; along the top they make obtuse angles, so
        <m>\mathbf{F} \cdot \hat{\mathbf{T}} \lt 0</m>. The field is
        longer<mdash/>stronger<mdash/>over the top half, so the negative
        contribution wins and the integral is <term>negative</term>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw3o-two-paths">
    <title>Two Particles, Two Paths</title>
    <statement>
      <p>
        With <m>\mathbf{F} = \left\langle y, x \right\rangle</m>, find
        the work done from <m>(-1,1)</m> to <m>(1,1)</m> along the parabola
        <m>C_1: y = 2x^2-1</m> and along <m>C_2</m>, the bottom half of
        <m>x^2 + (y-1)^2 = 1</m>.
      </p>
      <p>Work along <m>C_1</m>: <var width="10"/> foot-pounds.</p>
      <p>Work along <m>C_2</m>: <var width="10"/> foot-pounds.</p>
    </statement>
    <setup>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
         <condition string=".*">
     <feedback>
           <p>Incorrect.</p>
         </feedback>
   </condition>
 </var>
      <var>
        <condition number="2" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw3-solutions">
      <p>
        On <m>C_1</m>, <m>\mathbf{r}(t) = \left\langle t, 2t^2-1
        \right\rangle</m> with <m>-1 \le t \le 1</m>, so
        <m>\mathbf{F} \cdot \mathbf{v} = 6t^2 - 1</m> and
        <m>W = \int_{-1}^{1}(6t^2-1)\,dt = 2</m>.
      </p>
      <p>
        On <m>C_2</m>, <m>\mathbf{r}(t) = \left\langle \cos t,
        1+\sin t \right\rangle</m> with <m>\pi \le t \le 2\pi</m>,
        so <m>\mathbf{F} \cdot \mathbf{v} = \cos(2t) - \sin t</m> and
        <m>W = 2</m> again.
      </p>
      <p>
        The two answers agree because
        <m>\mathbf{F} = \nabla(xy)</m> is conservative<mdash/>revisit this
        problem after <xref ref="section-conservative-fields" text="title"/>.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw3o-helix">
    <title>A Line Integral Along a Helix</title>
    <statement>
      <p>
        For the helix <m>\mathbf{r}(t) = \left\langle \cos t, \sin t,
        t/2\pi \right\rangle</m>, <m>0 \le t \le 2\pi</m>, compute
        <m>\displaystyle\int_C x\,dy - y\,dx + dz</m>.
      </p>
      <p>
        The integrand <m>\mathbf{F} \cdot \mathbf{v}</m> is the constant
        <var width="10"/>, and the integral equals <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="1.159" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
                <condition string=".*">
            <feedback>
                  <p>Incorrect.</p>
                </feedback>
          </condition>
        </var>
      <var>
        <condition number="7.283" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="6.283" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw3-solutions">
      <p>
        The integral is <m>\int_C \mathbf{F} \cdot d\mathbf{r}</m> with
        <m>\mathbf{F} = \left\langle -y, x, 1 \right\rangle</m>. Along
        the helix <m>\mathbf{F} = \left\langle -\sin t, \cos t, 1
        \right\rangle</m> and
        <m>\mathbf{v} = \left\langle -\sin t, \cos t, \frac{1}{2\pi}
        \right\rangle</m>, so
        <m>\mathbf{F} \cdot \mathbf{v} = 1 + \frac{1}{2\pi}</m> and
      </p>
      <me>
        \int_C x\,dy - y\,dx + dz
        = \int_0^{2\pi}\left(1 + \frac{1}{2\pi}\right) dt
        = 2\pi + 1 \approx 7.283 .
      </me>
    </solution>
  </exercise>
  </exercises>
</section>
