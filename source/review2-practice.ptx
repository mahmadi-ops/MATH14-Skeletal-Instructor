                <axes at="axes" xlabel="x" ylabel="y" decorations="no" arrows="1" stroke="#555555" thickness="1"/>
                <vector at="v1" v="(-0.306,-0.306)" tail="(-1.5,-1.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q1" p="(-1.5,-1.5)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v2" v="(-0.336,-0.224)" tail="(-1.5,-1.0)" stroke="#3c6fbf" thickness="2"/>
                <point at="q2" p="(-1.5,-1.0)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v3" v="(-0.365,-0.122)" tail="(-1.5,-0.5)" stroke="#3c6fbf" thickness="2"/>
