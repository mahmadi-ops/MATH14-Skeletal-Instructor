                <vector at="v26" v="(0.261,-0.261)" tail="(1.0,-1.0)" stroke="#3c6fbf" thickness="2"/>
                <point at="q26" p="(1.0,-1.0)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v27" v="(0.306,-0.153)" tail="(1.0,-0.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q27" p="(1.0,-0.5)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v28" v="(0.306,0.153)" tail="(1.0,0.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q28" p="(1.0,0.5)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v29" v="(0.261,0.261)" tail="(1.0,1.0)" stroke="#3c6fbf" thickness="2"/>
                <point at="q29" p="(1.0,1.0)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v30" v="(0.224,0.336)" tail="(1.0,1.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q30" p="(1.0,1.5)" size="2" stroke="#8b1a2b" fill="none"/>
                <vector at="v31" v="(0.306,-0.306)" tail="(1.5,-1.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q31" p="(1.5,-1.5)" size="2" stroke="#8b1a2b" fill="none"/>
