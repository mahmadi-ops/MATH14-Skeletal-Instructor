                <vector at="v7" v="(-0.224,-0.336)" tail="(-1.0,-1.5)" stroke="#3c6fbf" thickness="2"/>
                <point at="q7" p="(-1.0,-1.5)" size="2" stroke="#8b1a2b" fill="none"/>
