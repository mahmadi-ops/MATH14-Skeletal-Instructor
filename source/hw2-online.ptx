<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW2, online version: the same problems as the written       -->
<!-- Assignment 2, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<!--                                                                         -->
<!-- The three figures sit inside their problems' statements and carry no    -->
<!-- xml:id.  For this kind of fill-in PreTeXt always adds an automatic       -->
<!-- solution that copies the statement (include-automatic="no" is not        -->
<!-- honored here), so any identifier inside a statement would be authored   -->
<!-- twice and the build would fail.  For the same reason they are TikZ       -->
<!-- (latex-image), not PreFigure: a PreFigure diagram needs a unique @label  -->
<!-- to name its file, and without one asset generation fails.  The           -->
<!-- statements say "shown below" instead of cross-referencing the figure.    -->
<section xml:id="sec-exercises-hw2-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 2</title>

  <introduction>
    <p>
      Section: <xref ref="sec-line-integrals" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw2-online">

  <exercise xml:id="ex-hw2o-quarter-circle">
    <title>Mass of a Quarter-Circle Wire</title>
    <setup>
      <de-object name="k" context="number">
        <de-random distribution="discrete" min="8" max="30" by="2"/>
      </de-object>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="M" context="number">
        <de-expression>k*R/2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        A wire is the quarter circle of radius <eval obj="R"/> centered at
        <m>(a,0)</m>, <m>a \gt 0</m>, lying in the first quadrant relative
        to its center. Its density is
      </p>
      <me>
        \rho(x,y) = \frac{<eval obj="k"/>\,(x-a)y}{(x-a)^2 + y^2}
      </me>
      <p>
        in kilograms per meter. The total mass of the wire is
        <fillin mode="number" ansobj="M" width="10"/> kilograms.
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <!-- The feedback here nudges, it does not solve: the dynamic runtime
             shows it to anyone who presses Check Me, so a full derivation
             would hand over the answer no matter how the solutions are
             switched in publication.ptx.  The worked solution lives in the
             "Solutions of the Assignments" chapter (hw2-solutions.ptx). -->
        <test correct="yes">
          <numcmp use-answer="yes" min="M.value({})-Math.max(0.01,1e-4*Math.abs(M.value({})))" max="M.value({})+Math.max(0.01,1e-4*Math.abs(M.value({})))"/>
          <feedback>
          <p>Correct.</p>
        </feedback>
        </test>
        <test>
          <numcmp object="k" min="k.value({})-Math.max(0.01,1e-4*Math.abs(k.value({})))" max="k.value({})+Math.max(0.01,1e-4*Math.abs(k.value({})))"/>
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </test>
      </evaluate>
    </evaluation>
    <solution component="hw2-solutions">
      <p>
        Parametrize the quarter circle by
        <m>\mathbf{r}(t) = \left\langle R\cos t + a,\ R\sin t
        \right\rangle</m>, <m>0 \le t \le \pi/2</m>, where <m>R</m> is
        the radius. Then <m>\lVert\mathbf{v}\rVert = R</m> and
        <m>(x-a)^2 + y^2 = R^2</m>, so the density along the wire is
      </p>
      <md>
        <mrow>
          \rho \amp = \frac{k\,(R\cos t)(R\sin t)}{R^2}
        </mrow>
        <mrow>
          \amp = k\cos t\sin t = \frac{k}{2}\sin(2t) ,
        </mrow>
      </md>
      <p>
        where <m>k</m> is the coefficient in the numerator. Hence
      </p>
      <md>
        <mrow>
          M \amp = \int_0^{\pi/2} \frac{k}{2}\sin(2t)\;R\,dt
        </mrow>
        <mrow>
          \amp = \frac{kR}{2}\Big[-\tfrac12\cos(2t)\Big]_0^{\pi/2}
          = \frac{kR}{2} .
        </mrow>
      </md>
      <p>
        The center <m>a</m> never enters: shifting the wire sideways moves
        the density with it.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-segment">
    <title>A Line Integral Along a Segment</title>
    <statement>
      <p>
        Evaluate <m>\displaystyle\int_C (x-y+z-2)\,ds</m> along the
        segment <m>x=t</m>, <m>y=1-t</m>, <m>z=1</m> from <m>(0,1,1)</m> to
        <m>(1,0,1)</m>.
      </p>
      <p>
        Along the path the integrand simplifies to <var width="10"/> (in
        terms of <m>t</m>); the speed of your parametrization is
        <var width="8"/>; and the integral equals <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="2\s*\*?\s*t\s*-\s*2">
          <feedback><p>Correct.</p></feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="1.414" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="-1.414" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="1.414" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        Along the segment <m>x-y+z-2</m> is
        <m>t-(1-t)+1-2 = 2t-2</m>, and
        <m>\mathbf{v} = \left\langle 1,-1,0 \right\rangle</m>, so
        <m>\lVert \mathbf{v} \rVert = \sqrt2</m>, and <m>t</m> runs
        from <m>0</m> to <m>1</m>:
      </p>
      <md>
        <mrow>
          \amp \int_C (x-y+z-2)\,ds
        </mrow>
        <mrow>
          \amp \qquad = \sqrt2\int_0^1 (2t-2)\,dt
        </mrow>
        <mrow>
          \amp \qquad = \sqrt2\Big[(t-1)^2\Big]_0^1
        </mrow>
        <mrow>
          \amp \qquad = -\sqrt2 \approx -1.414 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-square-path">
    <title>Around the Unit Square</title>
    <statement>
      <p>
        Evaluate <m>\displaystyle\int_C \frac{1}{x^2+y^2+1}\,ds</m>
        over the boundary <m>C</m> of the unit square, shown below.
      </p>
      <p>
        The side from <m>(0,0)</m> to <m>(1,0)</m> contributes
        <var width="10"/>; the side from <m>(1,0)</m> to <m>(1,1)</m>
        contributes <var width="10"/>; and the whole integral equals
        <var width="10"/>.
      </p>
      <figure>
        <caption>
          The curve <m>C</m> of <xref ref="ex-hw2o-square-path"/>: the boundary
          of the unit square, traversed once as shown.
        </caption>
        <image width="55%">
          <shortdescription>
          The unit square traversed counterclockwise, arrowheads on all four sides.
          </shortdescription>
          <description>
            <p>
              The unit square in the x y plane, with corners at the origin,
              one comma zero, one comma one, and zero comma one. Its sides
              are drawn in blue, and arrowheads on the four sides show the
              curve traversed counterclockwise starting along the bottom side.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[scale=3.4, line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  % axes
  \draw[-{Stealth[length=7pt]}, black!70, line width=0.7pt]
    (-0.45,0) -- (1.55,0) node[right] {$x$};
  \draw[-{Stealth[length=7pt]}, black!70, line width=0.7pt]
    (0,-0.45) -- (0,1.45) node[above] {$y$};
  % the curve C: the boundary of the unit square
  \draw[oiblue, line width=2.2pt] (0,0) -- (1,0) -- (1,1) -- (0,1) -- cycle;
  % arrows on the four sides: traversed once, counterclockwise
  \draw[oiblue, line width=2.2pt, -{Stealth[length=10pt, width=8pt]}]
    (0.40,0) -- (0.60,0);
  \draw[oiblue, line width=2.2pt, -{Stealth[length=10pt, width=8pt]}]
    (1,0.40) -- (1,0.60);
  \draw[oiblue, line width=2.2pt, -{Stealth[length=10pt, width=8pt]}]
    (0.60,1) -- (0.40,1);
  \draw[oiblue, line width=2.2pt, -{Stealth[length=10pt, width=8pt]}]
    (0,0.60) -- (0,0.40);
  % the corners
  \foreach \p in {(0,0),(1,0),(1,1),(0,1)} \fill[oiblue] \p circle (0.028);
  \node[below left]  at (0,0) {$(0,0)$};
  \node[below right] at (1,0) {$(1,0)$};
  \node[above right] at (1,1) {$(1,1)$};
  \node[above left]  at (0,1) {$(0,1)$};
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
                <condition string=".*">
            <feedback>
                  <p>Incorrect.</p>
                </feedback>
          </condition>
        </var>
      <var>
        <condition number="0.435" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.441" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="1.571" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        On the side from <m>(0,0)</m> to <m>(1,0)</m>,
        <m>f = 1/(t^2+1)</m> and <m>ds = dt</m>, giving
        <m>\tan^{-1}(1) = \pi/4 \approx 0.785</m>; the side on the
        <m>y</m>-axis gives the same. On each of the other two sides
        <m>f = 1/(t^2+2)</m>, giving
        <m>\frac{1}{\sqrt2}\tan^{-1}\left(\frac{1}{\sqrt2}\right)
        \approx 0.435</m>. Adding,
      </p>
      <md>
        <mrow>
          \int_C f\,ds \amp = \frac{\pi}{2}
          + \sqrt2 \tan^{-1}\left(\frac{1}{\sqrt2}\right)
        </mrow>
        <mrow>
          \amp \approx 2.441 .
        </mrow>
      </md>
      <p>
        A line integral of a scalar function does not depend on the
        direction of travel, and opposite sides of the square give equal
        contributions.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-wall">
    <title>Area of a Curved Wall</title>
    <statement>
      <p>
        Find the surface area of the wall shown below,
        whose height is <m>f(x,y) = x^2-y^2+3</m> over the unit circle.
      </p>
      <p>The surface area of the wall is <var width="10"/>.</p>
      <figure>
        <caption>
          The wall of <xref ref="ex-hw2o-wall"/>: its base is the unit circle in
          the <m>xy</m>-plane and its height above a point of that circle is
          <m>f(x,y) = x^2 - y^2 + 3</m>.
        </caption>
        <image width="60%">
          <shortdescription>
            A curved wall standing on the unit circle, whose top edge rises and
            falls twice around the circle.
          </shortdescription>
          <description>
            <p>
              A translucent blue wall stands vertically on the unit circle in
              the horizontal plane. Its top edge is a closed curve that reaches
              height four above the points where the circle meets the x axis
              and dips to height two above the points where it meets the y
              axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \begin{axis}[
      view={120}{18},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=-1.5, xmax=1.5, ymin=-1.5, ymax=1.5, zmin=0, zmax=4.6,
      clip=false,
    ]
    % ---- the wall: height x^2 - y^2 + 3 over the unit circle ----
    \addplot3[surf, shader=faceted, faceted color=oiblue!30,
              colormap={wallz}{color=(oiblue!14!white) color=(oiblue!42!white)},
              opacity=0.65, fill opacity=0.65,
              domain=0:360, samples=48, y domain=0:1, samples y=14,
              z buffer=sort, forget plot]
      ({cos(x)}, {sin(x)}, {y*(cos(x)^2 - sin(x)^2 + 3)});
    % ---- the base circle ----
    \addplot3[black!65, dashed, line width=1.1pt, samples=100, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, 0);
    % ---- the top edge ----
    \addplot3[oiblue, line width=1.6pt, samples=140, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, {cos(x)^2 - sin(x)^2 + 3});
    % ---- height marks ----
    \draw[black!55, line width=0.6pt] (axis cs:0,0,4) -- (axis cs:0.09,0,4);
    \node[anchor=east, font=\small] at (axis cs:0,0,4) {$4$};
    \node[anchor=north, font=\small] at (axis cs:1,0,-0.12) {$1$};
    \node[anchor=north, font=\small] at (axis cs:0,1,-0.12) {$1$};
    \node[oiblue, font=\large, anchor=south west]
      at (axis description cs:0.02,0.86) {$z = x^2 - y^2 + 3$};
  \end{axis}
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
    <setup>
      <var>
        <condition number="18.850" tolerance="0.02">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="6" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        With <m>\mathbf{r}(t) = \left\langle \cos t, \sin t
        \right\rangle</m> the speed is <m>1</m> and
      </p>
      <me>
        f = \cos^2 t - \sin^2 t + 3 = \cos(2t) + 3 ,
      </me>
      <p>so the area is</p>
      <me>
        \int_0^{2\pi} \left(\cos(2t)+3\right) dt = 6\pi \approx 18.850 .
      </me>
    </solution>
  </exercise>
  <exercise xml:id="ex-hw2o-exp-curve">
    <title>Along an Exponential Space Curve</title>
    <statement>
      <p>
        Compute the line integral of the scalar function
        <m>f(x,y,z) = 2x^2 + 8z</m> over the curve
        <m>\mathbf{c}(t) = \left\langle e^t,\ t^2,\ t \right\rangle</m>,
        <m>0 \le t \le 8</m>.
      </p>
      <p>
        The answer is large, so you may type it in e-notation, with at least
        four significant digits (for instance <c>1.234e10</c> for
        <m>1.234 \times 10^{10}</m>).
      </p>
      <p>
        <m>\displaystyle\int_C f(x,y,z)\,ds =</m> <var width="14"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="17660180863" tolerance="2000000">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        The velocity is
        <m>\mathbf{c}'(t) = \left\langle e^t,\ 2t,\ 1 \right\rangle</m>,
        so <m>\lVert \mathbf{c}'(t) \rVert = \sqrt{e^{2t} + 4t^2 + 1}</m>.
        Substituting <m>x = e^t</m>, <m>y = t^2</m>, <m>z = t</m> in
        <m>f</m> gives <m>f(\mathbf{c}(t)) = 2e^{2t} + 8t</m>. Hence
      </p>
      <md>
        <mrow>
          \int_C f\,ds \amp = \int_0^8 f(\mathbf{c}(t))\,
            \lVert \mathbf{c}'(t) \rVert\,dt
        </mrow>
        <mrow>
          \amp = \int_0^8 \left(2e^{2t} + 8t\right)
        </mrow>
        <mrow>
          \amp \qquad \times \sqrt{e^{2t} + 4t^2 + 1}\;dt .
        </mrow>
      </md>
      <p>
        With <m>u = e^{2t} + 4t^2 + 1</m>,
        <m>du = \left(2e^{2t} + 8t\right)dt</m>, the limits become
        <m>u = 2</m> and <m>u = e^{16} + 257</m>:
      </p>
      <md>
        <mrow>
          \int_C f\,ds \amp = \int_2^{e^{16}+257} u^{1/2}\,du
        </mrow>
        <mrow>
          \amp = \frac23 \Big[u^{3/2}\Big]_2^{e^{16}+257}
        </mrow>
        <mrow>
          \amp = \frac23\left( \left(e^{16}+257\right)^{3/2} - 2^{3/2} \right)
        </mrow>
        <mrow>
          \amp \approx 1.76602 \times 10^{10} .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-ellipse-wall">
    <title>A Wall on a Quarter Ellipse</title>
    <statement>
      <p>
        Find the surface area of the wall shown below. Its base
        is the curve <m>C</m>, the quarter of the ellipse
        <m>\frac{x^2}{5^2} + \frac{y^2}{7^2} = 1</m> that begins at
        <m>(5,0)</m> and ends at <m>(0,7)</m>, and its height above a point
        of <m>C</m> is <m>f(x,y) = xy</m>.
      </p>
      <p>The surface area of the wall is <var width="10"/>.</p>
      <figure>
        <caption>
          The wall of <xref ref="ex-hw2o-ellipse-wall"/>: its base is the quarter of the
          ellipse <m>\frac{x^2}{5^2} + \frac{y^2}{7^2} = 1</m> from
          <m>(5,0)</m> to <m>(0,7)</m>, and its height above a point of that
          curve is <m>f(x,y) = xy</m>.
        </caption>
        <image width="60%">
          <shortdescription>
            A curved wall standing on a quarter ellipse in the first quadrant,
            zero high at both ends and tallest in the middle.
          </shortdescription>
          <description>
            <p>
              A translucent blue wall stands vertically on the quarter of an
              ellipse in the first quadrant of the horizontal plane, running from
              the point five comma zero on the x axis to the point zero comma
              seven on the y axis. The top edge of the wall is the graph of
              z equals x y over that curve: it starts at height zero on the x
              axis, rises to a single hump in the middle, and falls back to
              height zero on the y axis.
            </p>
          </description>
          <latex-image>
            <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \definecolor{oired}{RGB}{213,94,0}
  \begin{axis}[
      view={130}{22},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=0, xmax=6.5, ymin=0, ymax=8.5, zmin=0, zmax=21,
      clip=false,
    ]
    % ---- the wall: height xy over the quarter ellipse ----
    \addplot3[surf, shader=faceted, faceted color=oiblue!30,
              colormap={wallxy}{color=(oiblue!14!white) color=(oiblue!42!white)},
              opacity=0.65, fill opacity=0.65,
              domain=0:90, samples=36, y domain=0:1, samples y=12,
              z buffer=sort, forget plot]
      ({5*cos(x)}, {7*sin(x)}, {y*35*cos(x)*sin(x)});
    % ---- the base curve C ----
    \addplot3[oired, line width=1.6pt, samples=80, samples y=0,
              domain=0:90, forget plot]
      ({5*cos(x)}, {7*sin(x)}, 0);
    % ---- the top edge ----
    \addplot3[oiblue, line width=1.6pt, samples=80, samples y=0,
              domain=0:90, forget plot]
      ({5*cos(x)}, {7*sin(x)}, {35*cos(x)*sin(x)});
    % ---- labels ----
    \node[anchor=north, font=\small] at (axis cs:5,0,-0.6) {$(5,0)$};
    \node[anchor=north, font=\small] at (axis cs:0,7,-0.6) {$(0,7)$};
    \node[oired, font=\large, anchor=north east]
      at (axis cs:3.54,4.95,-0.3) {$C$};
    \node[oiblue, font=\large, anchor=south west]
      at (axis description cs:0.02,0.86) {$z = f(x,y) = xy$};
  \end{axis}
\end{tikzpicture}]]>
          </latex-image>
        </image>
      </figure>
    </statement>
    <setup>
      <var>
        <condition number="105.972" tolerance="0.02">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        Parametrize <m>C</m> by
        <m>\mathbf{r}(t) = \left\langle 5\cos t,\ 7\sin t \right\rangle</m>,
        <m>0 \le t \le \pi/2</m>. Then
        <m>\mathbf{r}'(t) = \left\langle -5\sin t,\ 7\cos t \right\rangle</m>,
        so <m>\lVert \mathbf{r}'(t) \rVert = \sqrt{25\sin^2 t + 49\cos^2 t}</m>,
        which is <m>\sqrt{25 + 24\cos^2 t}</m>, and
        <m>f(\mathbf{r}(t)) = 35\cos t\sin t</m>.
        The area is
      </p>
      <md>
        <mrow>
          \int_C xy\,ds \amp = \int_0^{\pi/2} 35\cos t\sin t
        </mrow>
        <mrow>
          \amp \qquad \times \sqrt{25 + 24\cos^2 t}\;dt .
        </mrow>
      </md>
      <p>
        With <m>u = 25 + 24\cos^2 t</m>, <m>du = -48\cos t\sin t\,dt</m>,
        and <m>u</m> runs from <m>49</m> down to <m>25</m>:
      </p>
      <md>
        <mrow>
          \int_C xy\,ds \amp = \frac{35}{48}\int_{25}^{49} u^{1/2}\,du
        </mrow>
        <mrow>
          \amp = \frac{35}{48}\cdot\frac23\left(49^{3/2} - 25^{3/2}\right)
        </mrow>
        <mrow>
          \amp = \frac{35 \cdot 218}{72} = \frac{3815}{36}
        </mrow>
        <mrow>
          \amp \approx 105.972 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-power-curve">
    <title>Along the Curve <m>y = x^4/4</m></title>
    <statement>
      <p>
        Calculate <m>\displaystyle\int_C f\,ds</m>, where
        <m>f(x,y) = 64\,x^{-7}y^3</m> and the curve <m>C</m> is
        <m>y = \frac14 x^4</m> for <m>-1 \le x \le 0</m>.
      </p>
      <p>
        <m>\displaystyle\int_C f\,ds =</m> <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="-0.20316" tolerance="0.001">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition string=".*">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        Take <m>x</m> as the parameter: <m>x(t) = t</m>,
        <m>y(t) = \frac14 t^4</m>, <m>-1 \le t \le 0</m>. Then
        <m>\mathbf{r}(t) = \left\langle t,\ \frac14 t^4 \right\rangle</m>,
        <m>\mathbf{v}(t) = \left\langle 1,\ t^3 \right\rangle</m>, so
        <m>ds = \lVert\mathbf{v}(t)\rVert\,dt = \sqrt{1+t^6}\,dt</m>, and
      </p>
      <md>
        <mrow>
          \int_C f\,ds \amp = 64\int_{-1}^{0}
            \frac{\left(\frac14 t^4\right)^3}{t^7}\,\sqrt{1+t^6}\,dt
        </mrow>
        <mrow>
          \amp = \int_{-1}^{0} t^5\sqrt{1+t^6}\,dt
        </mrow>
        <mrow>
          \amp = \frac16\int_{-1}^{0} 6t^5\sqrt{1+t^6}\,dt
        </mrow>
        <mrow>
          \amp = \frac16\cdot\frac23\left(1+t^6\right)^{3/2}\Big|_{-1}^{0}
        </mrow>
        <mrow>
          \amp = \frac19\left(1 - 2\sqrt2\right) \approx -0.2032 .
        </mrow>
      </md>
      <p>
        The value is negative because <m>f \lt 0</m> all along <m>C</m>
        (there <m>x \lt 0</m> and <m>y \gt 0</m>).
      </p>
    </solution>
  </exercise>
  </exercises>
</section>
