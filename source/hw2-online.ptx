<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW2, online version: the same problems as the written       -->
<!-- Assignment 2, rebuilt as auto-graded exercises.  Same "fillin-basic"     -->
<!-- pattern as hw1-online.ptx: a <var/> per blank in the statement, matched  -->
<!-- in order by a <var> in <setup>, whose first <condition> is the correct   -->
<!-- answer.  Every blank is graded on its own, so partial credit survives.   -->
<section xml:id="sec-exercises-hw2-online" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 2</title>

  <introduction>
    <p>
      Section: <xref ref="sec-line-integrals" text="title"/>. Work each problem, then type your answers into the boxes and have them checked here.
    </p>
    <p>
      Press <q>Check Me</q> to submit; you may check as often as you like.
    </p>
    <p>
      <term>How to type your answers.</term> Numbers: a decimal number and
      nothing else<mdash/>no units, no <m>=</m> sign, no <m>\pi</m>; give at
      least three decimals (for instance <c>18.850</c>, not <c>6pi</c>).
      Answers are accepted within a small tolerance. Words: type just the
      word asked for, in lower case.
    </p>
  </introduction>

  <exercises xml:id="exercises-hw2-online">

  <exercise xml:id="ex-hw2o-quarter-circle">
    <title>Mass of a Quarter-Circle Wire</title>
    <setup>
      <de-object name="k" context="number">
        <de-random distribution="discrete" min="8" max="30" by="2"/>
      </de-object>
      <de-object name="R" context="number">
        <de-random distribution="discrete" min="1" max="5" by="1"/>
      </de-object>
      <de-object name="M" context="number">
        <de-expression>k*R/2</de-expression>
      </de-object>
    </setup>
    <statement>
      <p>
        A wire is the quarter circle of radius <eval obj="R"/> centered at
        <m>(a,0)</m>, <m>a \gt 0</m>, lying in the first quadrant relative
        to its center. Its density is
      </p>
      <me>
        \rho(x,y) = \frac{<eval obj="k"/>\,(x-a)y}{(x-a)^2 + y^2}
      </me>
      <p>
        in kilograms per meter. The total mass of the wire is
        <fillin mode="number" ansobj="M" width="10"/> kilograms.
      </p>
    </statement>
    <evaluation>
      <evaluate>
        <!-- The feedback here nudges, it does not solve: the dynamic runtime
             shows it to anyone who presses Check Me, so a full derivation
             would hand over the answer no matter how the solutions are
             switched in publication.ptx.  The worked solution lives in the
             "Solutions of the Assignments" chapter (hw2-solutions.ptx). -->
        <test correct="yes">
          <numcmp use-answer="yes" min="M.value({})-Math.max(0.01,1e-4*Math.abs(M.value({})))" max="M.value({})+Math.max(0.01,1e-4*Math.abs(M.value({})))"/>
          <feedback>
          <p>Correct.</p>
        </feedback>
        </test>
        <test>
          <numcmp object="k" min="k.value({})-Math.max(0.01,1e-4*Math.abs(k.value({})))" max="k.value({})+Math.max(0.01,1e-4*Math.abs(k.value({})))"/>
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </test>
        <test>
          <numcmp min="-1000000000" max="1000000000"/>
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </test>
      </evaluate>
    </evaluation>
    <solution component="hw2-solutions">
      <p>
        Parametrize the quarter circle by
        <m>\mathbf{r}(t) = \left\langle R\cos t + a,\ R\sin t
        \right\rangle</m>, <m>0 \le t \le \pi/2</m>, where <m>R</m> is
        the radius. Then <m>\lVert\mathbf{v}\rVert = R</m> and
        <m>(x-a)^2 + y^2 = R^2</m>, so the density along the wire is
      </p>
      <me>
        \rho = \frac{k\,(R\cos t)(R\sin t)}{R^2} = k\cos t\sin t
        = \frac{k}{2}\sin(2t) ,
      </me>
      <p>
        where <m>k</m> is the coefficient in the numerator. Hence
      </p>
      <me>
        M = \int_0^{\pi/2} \frac{k}{2}\sin(2t)\;R\,dt
        = \frac{kR}{2}\Big[-\tfrac12\cos(2t)\Big]_0^{\pi/2}
        = \frac{kR}{2} .
      </me>
      <p>
        The center <m>a</m> never enters: shifting the wire sideways moves
        the density with it.
      </p>
    </solution>
  </exercise>

  <exercise xml:id="ex-hw2o-segment">
    <title>A Line Integral Along a Segment</title>
    <statement>
      <p>
        Evaluate <m>\displaystyle\int_C (x-y+z-2)\,ds</m> along the
        segment <m>x=t</m>, <m>y=1-t</m>, <m>z=1</m> from <m>(0,1,1)</m> to
        <m>(1,0,1)</m>.
      </p>
      <p>
        Along the path the integrand simplifies to <var width="10"/> (in
        terms of <m>t</m>); the speed of your parametrization is
        <var width="8"/>; and the integral equals <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var case="insensitive">
        <condition string="2\s*\*?\s*t\s*-\s*2">
          <feedback><p>Correct.</p></feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="1.414" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="-1.414" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="1.414" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        Here <m>x-y+z-2 = t-(1-t)+1-2 = 2t-2</m> and
        <m>\mathbf{v} = \left\langle 1,-1,0 \right\rangle</m>, so
        <m>\lVert \mathbf{v} \rVert = \sqrt2</m>, and <m>t</m> runs
        from <m>0</m> to <m>1</m>:
      </p>
      <md>
        <mrow>
          \int_C (x-y+z-2)\,ds \amp = \sqrt2\int_0^1 (2t-2)\,dt
        </mrow>
        <mrow>
          \amp = \sqrt2\Big[(t-1)^2\Big]_0^1 = -\sqrt2 \approx -1.414 .
        </mrow>
      </md>
    </solution>
  </exercise>

  <figure xml:id="fig-hw2o-square">
    <caption>
      The curve <m>C</m> of <xref ref="ex-hw2o-square-path"/>: the boundary
      of the unit square, traversed once as shown.
    </caption>
    <image width="55%">
      <shortdescription>
      The unit square traversed counterclockwise, arrowheads on all four sides.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw2o-square">
        <diagram dimensions="(300,280)" margins="12">
          <coordinates bbox="(-0.55,-0.55,1.6,1.5)">
            <axes at="hs-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <polygon at="hs-square" closed="yes" stroke="#0072B2" thickness="3"
                fill="none" points="((0,0),(1,0),(1,1),(0,1))"/>
            <vector at="hs-a1" v="(0.16,0)" tail="(0.42,0)" stroke="#0072B2"
                thickness="3"/>
            <vector at="hs-a2" v="(0,0.16)" tail="(1,0.42)" stroke="#0072B2"
                thickness="3"/>
            <vector at="hs-a3" v="(-0.16,0)" tail="(0.58,1)" stroke="#0072B2"
                thickness="3"/>
            <vector at="hs-a4" v="(0,-0.16)" tail="(0,0.58)" stroke="#0072B2"
                thickness="3"/>
            <point at="hs-p00" p="(0,0)" fill="#0072B2" alignment="sw">
              <m>(0,0)</m>
            </point>
            <point at="hs-p10" p="(1,0)" fill="#0072B2" alignment="se">
              <m>(1,0)</m>
            </point>
            <point at="hs-p11" p="(1,1)" fill="#0072B2" alignment="ne">
              <m>(1,1)</m>
            </point>
            <point at="hs-p01" p="(0,1)" fill="#0072B2" alignment="nw">
              <m>(0,1)</m>
            </point>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="The unit square in the x y plane, with corners at the origin, one comma zero, one comma one, and zero comma one. Its sides are drawn in blue, and arrowheads on the four sides show the curve traversed counterclockwise starting along the bottom side.">
              <annotation ref="hs-square" text="The square path C, the boundary of the unit square."/>
              <annotation ref="hs-a1" text="An arrow on the bottom side pointing in the direction of increasing x."/>
              <annotation ref="hs-a2" text="An arrow on the right side pointing upward."/>
              <annotation ref="hs-a3" text="An arrow on the top side pointing in the direction of decreasing x."/>
              <annotation ref="hs-a4" text="An arrow on the left side pointing downward."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw2o-square-path">
    <title>Around the Unit Square</title>
    <statement>
      <p>
        Evaluate <m>\displaystyle\int_C \frac{1}{x^2+y^2+1}\,ds</m>
        over the boundary <m>C</m> of the unit square of
        <xref ref="fig-hw2o-square"/>.
      </p>
      <p>
        The side from <m>(0,0)</m> to <m>(1,0)</m> contributes
        <var width="10"/>; the side from <m>(1,0)</m> to <m>(1,1)</m>
        contributes <var width="10"/>; and the whole integral equals
        <var width="10"/>.
      </p>
    </statement>
    <setup>
      <var>
        <condition number="0.785" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
                <condition string=".*">
            <feedback>
                  <p>Incorrect.</p>
                </feedback>
          </condition>
        </var>
      <var>
        <condition number="0.615" tolerance="0.005">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
              <condition string=".*">
          <feedback>
                <p>Incorrect.</p>
              </feedback>
        </condition>
      </var>
      <var>
        <condition number="2.441" tolerance="0.01">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="1.571" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        On the side from <m>(0,0)</m> to <m>(1,0)</m>,
        <m>f = 1/(t^2+1)</m> and <m>ds = dt</m>, giving
        <m>\tan^{-1}(1) = \pi/4 \approx 0.785</m>; the side on the
        <m>y</m>-axis gives the same. On each of the other two sides
        <m>f = 1/(t^2+2)</m>, giving
        <m>\frac{1}{\sqrt2}\tan^{-1}\left(\frac{1}{\sqrt2}\right)
        \approx 0.615</m>. Adding,
      </p>
      <me>
        \int_C f\,ds = \frac{\pi}{2}
        + \sqrt2 \tan^{-1}\left(\frac{1}{\sqrt2}\right)
        \approx 2.441 .
      </me>
      <p>
        A line integral of a scalar function does not depend on the
        direction of travel, and opposite sides of the square give equal
        contributions.
      </p>
    </solution>
  </exercise>

  <figure xml:id="fig-hw2o-wall">
    <caption>
      The wall of <xref ref="ex-hw2o-wall"/>: its base is the unit circle in
      the <m>xy</m>-plane and its height above a point of that circle is
      <m>f(x,y) = x^2 - y^2 + 3</m>.
    </caption>
    <image xml:id="image-hw2o-wall" width="60%">
      <shortdescription>
        A curved wall standing on the unit circle, whose top edge rises and
        falls twice around the circle.
      </shortdescription>
      <description>
        <p>
          A translucent blue wall stands vertically on the unit circle in
          the horizontal plane. Its top edge is a closed curve that reaches
          height four above the points where the circle meets the x axis
          and dips to height two above the points where it meets the y
          axis.
        </p>
      </description>
      <latex-image>
        <![CDATA[\begin{tikzpicture}[line join=round, line cap=round]
  \definecolor{oiblue}{RGB}{0,114,178}
  \begin{axis}[
      view={120}{18},
      width=11cm,
      axis lines=center,
      axis line style={-latex, black!70, line width=0.7pt},
      xlabel={$x$}, ylabel={$y$}, zlabel={$z$},
      label style={font=\large},
      ticks=none,
      xmin=-1.5, xmax=1.5, ymin=-1.5, ymax=1.5, zmin=0, zmax=4.6,
      clip=false,
    ]
    % ---- the wall: height x^2 - y^2 + 3 over the unit circle ----
    \addplot3[surf, shader=faceted, faceted color=oiblue!30,
              colormap={wallz}{color=(oiblue!14!white) color=(oiblue!42!white)},
              opacity=0.65, fill opacity=0.65,
              domain=0:360, samples=48, y domain=0:1, samples y=14,
              z buffer=sort, forget plot]
      ({cos(x)}, {sin(x)}, {y*(cos(x)^2 - sin(x)^2 + 3)});
    % ---- the base circle ----
    \addplot3[black!65, dashed, line width=1.1pt, samples=100, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, 0);
    % ---- the top edge ----
    \addplot3[oiblue, line width=1.6pt, samples=140, samples y=0,
              domain=0:360, forget plot]
      ({cos(x)}, {sin(x)}, {cos(x)^2 - sin(x)^2 + 3});
    % ---- height marks ----
    \draw[black!55, line width=0.6pt] (axis cs:0,0,4) -- (axis cs:0.09,0,4);
    \node[anchor=east, font=\small] at (axis cs:0,0,4) {$4$};
    \node[anchor=north, font=\small] at (axis cs:1,0,-0.12) {$1$};
    \node[anchor=north, font=\small] at (axis cs:0,1,-0.12) {$1$};
    \node[oiblue, font=\large, anchor=south west]
      at (axis description cs:0.02,0.86) {$z = x^2 - y^2 + 3$};
  \end{axis}
\end{tikzpicture}]]>
      </latex-image>
    </image>
  </figure>

  <exercise xml:id="ex-hw2o-wall">
    <title>Area of a Curved Wall</title>
    <statement>
      <p>
        Find the surface area of the wall of <xref ref="fig-hw2o-wall"/>,
        whose height is <m>f(x,y) = x^2-y^2+3</m> over the unit circle.
      </p>
      <p>The surface area of the wall is <var width="10"/>.</p>
    </statement>
    <setup>
      <var>
        <condition number="18.850" tolerance="0.02">
          <feedback>
          <p>Correct.</p>
        </feedback>
        </condition>
        <condition number="6" tolerance="0.01">
          <feedback>
          <p>Incorrect.</p>
        </feedback>
        </condition>
      </var>
    </setup>
    <solution component="hw2-solutions">
      <p>
        With <m>\mathbf{r}(t) = \left\langle \cos t, \sin t
        \right\rangle</m> the speed is <m>1</m> and
      </p>
      <me>
        f = \cos^2 t - \sin^2 t + 3 = \cos(2t) + 3 ,
      </me>
      <p>so the area is</p>
      <me>
        \int_0^{2\pi} \left(\cos(2t)+3\right) dt = 6\pi \approx 18.850 .
      </me>
    </solution>
  </exercise>
  </exercises>
</section>
