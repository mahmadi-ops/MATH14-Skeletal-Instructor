<?xml version="1.0" encoding="UTF-8"?>
<!-- MATH 14 - HW3: vector fields and line integrals -->
<section xml:id="sec-exercises-hw3" xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Assignment 3</title>

  <introduction>
    <p>
      Sections: <xref ref="sec-vector-fields" text="title"/> and
      Path Independence, Conservative Fields, and Potential Functions.
      <!-- plain text until that section is posted: <xref ref="section-conservative-fields"/> -->
    </p>
  </introduction>

  <exercises xml:id="exercises-hw3">

  <exercise xml:id="ex-hw3-inverse-square">
    <statement>
      <p>
        Sketch the vector field
        <m>\displaystyle\mathbf{F}(x,y) = -\frac{\mathbf{r}}{\lVert \mathbf{r} \rVert^3}</m>
        in the plane, where
        <m>\mathbf{r} = \left\langle x, y \right\rangle</m>. Which of the following statements are true? Select all that apply.
      </p>
      <p>
        <ol marker="(a)">
          <li>All the vectors point toward the origin.</li>
          <li>The vectors decrease in length as you move away from the origin.</li>
          <li>All the vectors point away from the origin.</li>
          <li>The vectors increase in length as you move away from the origin.</li>
          <li>The length of each vector is <m>1</m>.</li>
        </ol>
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-segment-arc">
    <statement>
      <p>
        Curves <m>C_1</m> and <m>C_2</m> are parametrized as follows:
        <m>C_1</m> is <m>(x(t),y(t)) = (t,0)</m> for <m>-1 \le t \le 1</m>,
        and <m>C_2</m> is <m>(x(t),y(t)) = (\cos t, \sin t)</m> for
        <m>0 \le t \le \pi</m>. Sketch, on a separate sheet of paper,
        the curves <m>C_1</m> and <m>C_2</m> with arrows showing their
        orientation.
      </p>
      <p>
        Next, suppose that
        <m>\mathbf{F} = 3x\,\mathbf{i} + (4x + 2y)\,\mathbf{j}</m>.
        Calculate <m>\displaystyle\int_C \mathbf{F} \cdot d\mathbf{r}</m>,
        where <m>C</m> is the curve <m>C = C_1 \cup C_2</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-constant-field">
    <statement>
      <p>
        Sketch the vector field
        <m>\mathbf{F}(x,y) = 3\,\mathbf{i} + 4\,\mathbf{j}</m> and
        calculate the line integral of <m>\mathbf{F}</m> along the line
        segment from <m>(-1,3)</m> to <m>(4,1)</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-helix-twice">
    <statement>
      <p>
        Find <m>\displaystyle\int_C \mathbf{F} \cdot d\mathbf{r}</m> for
        <m>\mathbf{F} = 3y\,\mathbf{i} - 2x\,\mathbf{j} + z\,\mathbf{k}</m>
        if <m>C</m> is the helix <m>x = \cos t</m>, <m>y = \sin t</m>,
        <m>z = t</m>, for <m>0 \le t \le 4\pi</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-sign">
    <statement>
      <p>
        Determine whether the line integral of the vector field
        <m>\mathbf{F}</m> along the curve <m>C</m> is positive, negative,
        or zero. <m>\mathbf{F}</m> and <m>C</m> are shown in
        <xref ref="fig-hw3-field"/>. Remember to fully justify your answer.
      </p>
    </statement>
  </exercise>

  <figure xml:id="fig-hw3-field">
    <caption>
      The vector field <m>\mathbf{F}</m> and the curve <m>C</m> of
      <xref ref="ex-hw3-sign"/>. The curve is traversed in the direction of
      the arrowhead.
    </caption>
    <image width="70%">
      <shortdescription>
      A field over the first quadrant tilting from downward to rightward, with a blue circle.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw3-field">
        <diagram dimensions="(380,320)" margins="10">
          <definition>F(x,y) = (0.30*y, -0.30)</definition>
          <definition>circle(t) = (1.5 + 1.05*cos(t), 1.35 + 1.05*sin(t))</definition>
          <coordinates bbox="(-0.35,-0.35,3.35,2.95)">
            <axes at="hf-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <repeat at="hf-cols" parameter="i=0..6">
              <repeat parameter="j=0..5">
                <vector at="hf-v-((i))-((j))" v="F(0.45*i+0.15, 0.5*j+0.1)"
                    tail="(0.45*i+0.15, 0.5*j+0.1)" stroke="#009E73"
                    thickness="2"/>
              </repeat>
            </repeat>
            <parametric-curve at="hf-C" function="circle" domain="(0,2*pi)"
                stroke="#0072B2" thickness="3"/>
            <vector at="hf-Cdir" v="(0.02,0.30)" tail="(2.54,1.15)"
                stroke="#0072B2" thickness="3"/>
            <label at="hf-Clabel" anchor="(1.5,1.35)" alignment="center"
                color="#0072B2"><m>C</m></label>
            <label at="hf-Flabel" anchor="(2.75,2.70)" alignment="e"
                color="#009E73"><m>\mathbf{F}</m></label>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A grid of green field vectors over the first quadrant, together with a blue circle. Near the x axis the field vectors point almost straight down and are short. Higher up they tilt to the right and grow longer, so the field is strongest across the top of the circle. The circle is traversed counterclockwise, and its right side carries an arrowhead pointing upward.">
              <annotation ref="hf-C" text="The closed curve C, a circle, traversed in the direction of the arrowhead on its right side, counterclockwise."/>
              <annotation ref="hf-Cdir" text="The arrowhead giving the direction of travel along C, pointing upward on the right side of the circle."/>
              <annotation ref="hf-cols" text="The field vectors. They are short and nearly vertical near the x axis and grow longer and more tilted as y increases."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  <exercise xml:id="ex-hw3-two-paths">
    <statement>
      <p>
        Two particles move from <m>(-1,1)</m> to <m>(1,1)</m> under the
        influence of a force field
        <m>\mathbf{F} = \left\langle y, x \right\rangle</m>. One moves
        along the curve <m>C_1</m>, the parabola defined by
        <m>y = 2x^2 - 1</m>. The other particle moves along the curve
        <m>C_2</m>, the bottom half of the circle
        <m>x^2 + (y-1)^2 = 1</m>. Force is measured in pounds and distances
        are measured in feet. Find the work performed by moving each
        particle along its path.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-three-forms">
    <introduction>
      <p>
        The work done by a force field
        <m>\mathbf{F} = \left\langle M(x,y,z), N(x,y,z), P(x,y,z)
        \right\rangle</m> along a curve <m>C</m> is given by
        <m>\displaystyle\int_C \mathbf{F} \cdot \hat{\mathbf{T}}\,ds</m>,
        where <m>\hat{\mathbf{T}}</m> is the unit tangent vector to
        <m>C</m>. Show that
        <m>\displaystyle\int_C \mathbf{F} \cdot \hat{\mathbf{T}}\,ds</m>
        can be written in each of the following forms. Remember to fully
        justify your answers.
      </p>
    </introduction>
    <task xml:id="task-hw3-form-a">
      <statement>
        <p>
          <m>\displaystyle\int_{t=a}^{t=b} \mathbf{F} \cdot
          \mathbf{v}\,dt</m>
        </p>
      </statement>
    </task>
    <task xml:id="task-hw3-form-b">
      <statement>
        <p>
          <m>\displaystyle\int_C \mathbf{F} \cdot d\mathbf{r}</m>
        </p>
      </statement>
    </task>
    <task xml:id="task-hw3-form-c">
      <statement>
        <p>
          <m>\displaystyle\int_C M\,dx + N\,dy + P\,dz</m>
        </p>
      </statement>
    </task>
  </exercise>

  <exercise xml:id="ex-hw3-helix">
    <statement>
      <p>
        Suppose that <m>C</m> is the portion of the helix given by
        <m>\mathbf{r}(t) = \left\langle \cos(t), \sin(t), t/2\pi
        \right\rangle</m>, where <m>0 \le t \le 2\pi</m>. Calculate
        <m>\displaystyle\int_C x\,dy - y\,dx + dz</m>.
      </p>
    </statement>
  </exercise>

  <exercise xml:id="ex-hw3-less-work">
    <introduction>
      <p>
        The force field <m>\mathbf{F}</m> is shown by the arrows in
        <xref ref="fig-hw3-paths"/>.
      </p>
    </introduction>
    <task xml:id="task-hw3-less-work">
      <statement>
        <p>
          Over which of the two paths, <m>ADC</m> or <m>ABC</m>, does
          <m>\mathbf{F}</m> perform less work? Fully justify your answer.
        </p>
      </statement>
    </task>
    <task xml:id="task-hw3-conservative">
      <statement>
        <p>
          Is <m>\mathbf{F}</m> a conservative field or not? Why?
        </p>
      </statement>
    </task>
  </exercise>

  <figure xml:id="fig-hw3-paths">
    <caption>
      The vector field <m>\mathbf{F}</m> and the two paths <m>ADC</m> and
      <m>ABC</m> of <xref ref="ex-hw3-less-work"/>. Every field vector
      points in the same direction; only their lengths change.
    </caption>
    <image width="70%">
      <shortdescription>
      A uniform slanted field with a square path from corner A to corner B.
      </shortdescription>
      <prefigure xmlns="https://prefigure.org" label="prefigure-hw3-paths">
        <diagram dimensions="(360,320)" margins="10">
          <definition>G(x,y) = (0.16*(1+x), 0.16*(1+x))</definition>
          <coordinates bbox="(-0.3,-0.3,3.3,3.0)">
            <axes at="hp-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
            <repeat at="hp-cols" parameter="i=0..6">
              <repeat parameter="j=0..5">
                <vector at="hp-v-((i))-((j))" v="G(0.45*i+0.12, 0.5*j+0.12)"
                    tail="(0.45*i+0.12, 0.5*j+0.12)" stroke="#56B4E9"
                    thickness="2"/>
              </repeat>
            </repeat>
            <polygon at="hp-square" closed="yes" stroke="#CC0079" thickness="3"
                fill="none" points="((0.8,0.7),(2.4,0.7),(2.4,2.3),(0.8,2.3))"/>
            <point at="hp-A" p="(0.8,0.7)" fill="black" alignment="sw">
              <m>A</m>
            </point>
            <point at="hp-D" p="(2.4,0.7)" fill="black" alignment="se">
              <m>D</m>
            </point>
            <point at="hp-C" p="(2.4,2.3)" fill="black" alignment="ne">
              <m>C</m>
            </point>
            <point at="hp-B" p="(0.8,2.3)" fill="black" alignment="nw">
              <m>B</m>
            </point>
          </coordinates>
          <annotations>
            <annotation ref="figure" text="A grid of light blue field vectors, all pointing up and to the right at the same angle, with lengths that grow as x increases. A magenta square is drawn with corners A at the lower left, D at the lower right, C at the upper right and B at the upper left, so the path A D C runs along the bottom and up the right side, while A B C runs up the left side and along the top.">
              <annotation ref="hp-cols" text="The field vectors, all parallel and pointing up and to the right, growing longer toward the right of the picture."/>
              <annotation ref="hp-square" text="The square whose corners are A, B, C and D; the two paths of the problem run along its sides."/>
              <annotation ref="hp-A" text="The corner A, at the lower left."/>
              <annotation ref="hp-D" text="The corner D, at the lower right; the path A D C passes through it."/>
              <annotation ref="hp-C" text="The corner C, at the upper right."/>
              <annotation ref="hp-B" text="The corner B, at the upper left; the path A B C passes through it."/>
            </annotation>
          </annotations>
        </diagram>
      </prefigure>
    </image>
  </figure>

  </exercises>
</section>
