    points="((-1,0),(-0.7959,0.04167),(-0.7113,0.08333),(-0.6464,0.125),(-0.5918,0.1667),(-0.5436,0.2083),(-0.5,0.25),(-0.4599,0.2917),(-0.4226,0.3333),(-0.3876,0.375),(-0.3545,0.4167),(-0.323,0.4583),(-0.2929,0.5),(-0.264,0.5417),(-0.2362,0.5833),(-0.2094,0.625),(-0.1835,0.6667),(-0.1584,0.7083),(-0.134,0.75),(-0.1102,0.7917),(-0.08713,0.8333),(-0.06459,0.875),(-0.04257,0.9167),(-0.02105,0.9583),(0,1),(0.0782,0.9583),(0.1464,0.9167),(0.2051,0.875),(0.2546,0.8333),(0.2955,0.7917),(0.3281,0.75),(0.3529,0.7083),(0.3704,0.6667),(0.3809,0.625),(0.3848,0.5833),(0.3827,0.5417),(0.375,0.5),(0.3621,0.4583),(0.3443,0.4167),(0.3223,0.375),(0.2963,0.3333),(0.2669,0.2917),(0.2344,0.25),(0.1993,0.2083),(0.162,0.1667),(0.123,0.125),(0.08275,0.08333),(0.04159,0.04167),(0,0))"/>
<parametric-curve at="ar-right" function="right" domain="(-1,1)"
    stroke="#0072B2" thickness="3"/>
