                <point at="q59" p="(4.00,1.50)" size="3" stroke="#2f6fb5" fill="#2f6fb5"/>
                <vector at="v60" v="(0.34,0)" tail="(4.00,2.00)" stroke="#2f6fb5" thickness="2"/>
                <point at="q60" p="(4.00,2.00)" size="3" stroke="#2f6fb5" fill="#2f6fb5"/>
