       alignment="nw">
<m>(x, y+\Delta y)</m>
</point>
<point at="df-corner-tr" clear-background="yes" background-margin="3" p="(4.8,3.2)" fill="#2b9ad6" size="3"
       alignment="ne">
<m>(x+\Delta x, y+\Delta y)</m>
</point>
<line at="df-top" p1="(3.0,3.2)" p2="(3.0,3.75)" arrows="1"
      stroke="#D55E00" thickness="3"/>
<line at="df-bottom" p1="(3.0,1.0)" p2="(3.0,0.45)" arrows="1"
      stroke="#E69F00" thickness="3"/>
<line at="df-right" p1="(4.8,2.1)" p2="(5.35,2.1)" arrows="1"
      stroke="#009E73" thickness="3"/>
<line at="df-left" p1="(1.2,2.1)" p2="(0.65,2.1)" arrows="1"
      stroke="#7b3294" thickness="3"/>
<!-- Legend: the field itself (the gray arrows).  The rows that paired -->
<!-- each side's color with its dot product were cut: they gave the    -->
<!-- derivation away.                                                  -->
<line at="df-leg-field" p1="(-5.45,4.35)" p2="(-5.05,4.35)" arrows="1"
      stroke="#bbbbbb" thickness="2"/>
<label at="df-leg-field-label" clear-background="yes" background-margin="4" anchor="(-4.95,4.35)" alignment="e">
<m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>
</label>
<label at="df-A" clear-background="yes" background-margin="4" anchor="(3.0,2.35)" alignment="c">
<m>A</m>
</label>
<label at="df-dx" clear-background="yes" background-margin="4" anchor="(3.0,0.05)" alignment="s">
<m>\Delta x</m>
</label>
