  at (0.25,11.75) {workspace};
\node[anchor=north west, font=\small\itshape] at (0.35,3.7) {$\mathbf n =$ \qquad\qquad\qquad\qquad\qquad\qquad $\mathbf T =$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank workspace, with a last row for the unit normal and the unit tangent.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-unit-normal-circle">
<caption>
The unit tangent <m>\mathbf{T}</m> (pink) and the outward unit normal
<m>\mathbf{n}</m> (green) at three points of the unit circle <m>C</m>;
the arrowheads on <m>C</m> show the direction of the path,
counterclockwise. Compare with what you found.
</caption>
<image width="55%">
<shortdescription>
The unit circle with a unit tangent vector and an outward unit normal vector drawn at three of its points.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-unit-normal-circle">
<diagram dimensions="(300,300)" margins="10">
<definition>r(t) = (cos(t), sin(t))</definition>
<definition>T(t) = (-sin(t), cos(t))</definition>
<definition>nn(t) = (cos(t), sin(t))</definition>
<definition>tipT(t) = (cos(t) - sin(t), sin(t) + cos(t))</definition>
<definition>tipN(t) = (2*cos(t), 2*sin(t))</definition>
<coordinates bbox="(-2.3,-2.3,2.3,2.3)">
<circle at="un-disk" center="(0,0)" radius="1" fill="#dff4f6"
        stroke="#00b0c0" thickness="3"/>
<axes at="un-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<!-- arrowheads on C showing the direction of the path -->
<parametric-curve at="un-dir-1" function="r" domain="(1.5,1.745)"
                  stroke="#00b0c0" thickness="3" arrows="1" arrow-width="5"/>
<parametric-curve at="un-dir-2" function="r" domain="(3.6,3.84)"
                  stroke="#00b0c0" thickness="3" arrows="1" arrow-width="5"/>
<parametric-curve at="un-dir-3" function="r" domain="(5.78,6.021)"
                  stroke="#00b0c0" thickness="3" arrows="1" arrow-width="5"/>
<!-- t = pi/6 -->
<angle-marker at="un-right-1" p="r(pi/6)" p1="tipN(pi/6)" p2="tipT(pi/6)"
              radius="9" stroke="#555555" thickness="1"/>
<vector at="un-T-1" tail="r(pi/6)" v="T(pi/6)" stroke="#d02090" thickness="3"/>
<vector at="un-n-1" tail="r(pi/6)" v="nn(pi/6)" stroke="#009E73" thickness="3"/>
<point at="un-P-1" p="r(pi/6)" size="3" fill="black"/>
<label at="un-T-1-label" anchor="tipT(pi/6)" alignment="n" color="#d02090"
       clear-background="yes" background-margin="2">
<m>\mathbf{T}</m>
</label>
<label at="un-n-1-label" anchor="tipN(pi/6)" alignment="e" color="#009E73"
       clear-background="yes" background-margin="2">
<m>\mathbf{n}</m>
</label>
<!-- t = 5 pi/6 -->
<angle-marker at="un-right-2" p="r(5*pi/6)" p1="tipN(5*pi/6)" p2="tipT(5*pi/6)"
              radius="9" stroke="#555555" thickness="1"/>
<vector at="un-T-2" tail="r(5*pi/6)" v="T(5*pi/6)" stroke="#d02090" thickness="3"/>
<vector at="un-n-2" tail="r(5*pi/6)" v="nn(5*pi/6)" stroke="#009E73" thickness="3"/>
<point at="un-P-2" p="r(5*pi/6)" size="3" fill="black"/>
<label at="un-T-2-label" anchor="tipT(5*pi/6)" alignment="s" color="#d02090"
       clear-background="yes" background-margin="2">
<m>\mathbf{T}</m>
</label>
<label at="un-n-2-label" anchor="tipN(5*pi/6)" alignment="w" color="#009E73"
       clear-background="yes" background-margin="2">
<m>\mathbf{n}</m>
</label>
<!-- t = 5 pi/3 -->
<angle-marker at="un-right-3" p="r(5*pi/3)" p1="tipN(5*pi/3)" p2="tipT(5*pi/3)"
              radius="9" stroke="#555555" thickness="1"/>
<vector at="un-T-3" tail="r(5*pi/3)" v="T(5*pi/3)" stroke="#d02090" thickness="3"/>
<vector at="un-n-3" tail="r(5*pi/3)" v="nn(5*pi/3)" stroke="#009E73" thickness="3"/>
<point at="un-P-3" p="r(5*pi/3)" size="3" fill="black"/>
<label at="un-T-3-label" anchor="tipT(5*pi/3)" alignment="e" color="#d02090"
       clear-background="yes" background-margin="2">
<m>\mathbf{T}</m>
</label>
<label at="un-n-3-label" anchor="tipN(5*pi/3)" alignment="se" color="#009E73"
       clear-background="yes" background-margin="2">
<m>\mathbf{n}</m>
</label>
<label at="un-C-label" anchor="(-0.36,-1.02)" alignment="sw" color="#00a0b0"
       clear-background="yes" background-margin="2">
<m>C</m>
</label>
<label at="un-R-label" anchor="(-0.42,-0.36)" alignment="c"
       clear-background="yes" background-margin="2">
<m>R</m>
</label>
</coordinates>
<annotations>
<annotation ref="figure" text="The unit circle C drawn in teal around the shaded disk R, with three arrowheads on it showing that the path runs counterclockwise. At three points of the circle a pink unit tangent vector T and a green unit normal vector n start from the same point; a small square marks the right angle between them. Every T points in the direction of travel, and every n is on the right of the direction of travel, pointing straight away from the center, out of the disk.">
  <annotation ref="un-disk" text="The unit circle C, traversed counterclockwise, enclosing the disk R."/>
  <annotation ref="un-dir-1" text="An arrowhead on the circle near the top, pointing to the left: the path runs counterclockwise."/>
  <annotation ref="un-T-1" text="At the point at angle pi over 6, the unit tangent T points up and to the left, along the direction of travel."/>
  <annotation ref="un-n-1" text="At the same point, the outward unit normal n points away from the center, up and to the right."/>
  <annotation ref="un-T-2" text="At the point at angle 5 pi over 6, the unit tangent T points down and to the left."/>
  <annotation ref="un-n-2" text="At the same point, the outward unit normal n points away from the center, up and to the left."/>
  <annotation ref="un-T-3" text="At the point at angle 5 pi over 3, the unit tangent T points up and to the right."/>
  <annotation ref="un-n-3" text="At the same point, the outward unit normal n points away from the center, down and to the right."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>

<p>
This is where the line integral <m>\oint_C M\,dy - N\,dx</m> in the
normal form of Green's theorem, <xref ref="eq-green-normal"/>, comes
from. For <m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>, the line
element <m>ds = \left\lVert\mathbf{v}\right\rVert\,dt</m> of
<xref ref="eq-line-element-2d"/> cancels the length in
<xref ref="eq-outward-unit-normal"/>:
<md>
<mrow>
\amp \mathbf{F}\cdot\mathbf{n}\,ds
</mrow>
<mrow>
\amp \quad = \frac{1}{\left\lVert\mathbf{v}\right\rVert}
\left( M\,\frac{dy}{dt} - N\,\frac{dx}{dt} \right)
\left\lVert\mathbf{v}\right\rVert\,dt
</mrow>
<mrow>
\amp \quad = M\,dy - N\,dx.
</mrow>
</md>
</p>
</subsubsection>

<subsubsection xml:id="sec-greens-theorem-forms">
<title>Green's Theorem: The Flux-Divergence (Normal) Form</title>

<p>
We can now state Green's theorem in 2D<fn>Note that we only cover Green's
theorem in 2D; however, you should know that this theorem can be
generalized to 3D, and in that case it is known as Stokes' theorem,
which is <xref ref="section-stokes-theorem"/>.</fn>. It comes in two
forms, and the first, the flux form, relates the outward flux
across a simple<fn>A curve in the <m>xy</m>-plane is
<term>simple</term> if it does not cross itself.</fn> closed curve
<m>C</m> and the double integral of the divergence over the region
<m>R</m> bounded by the curve <m>C</m>.
</p>

<theorem xml:id="thm-green-normal">
<title>Green's Theorem (Flux-Divergence or Normal Form)</title>
<statement>
<p>
Let <m>C</m> be a piecewise smooth, simple closed curve enclosing a
region <m>R</m> in the plane. Let
<m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m> be a vector field
with <m>M</m> and <m>N</m> having continuous first partial derivatives
in an open region containing <m>R</m>. Then the outward flux of
<m>\mathbf{F}</m> across <m>C</m> equals the double integral of
<m>\operatorname{div} \mathbf{F}</m> over the region <m>R</m> enclosed
by <m>C</m>:
</p>

<md>
<mrow>
\amp \underbrace{\oint_C \mathbf{F} \cdot \mathbf{n}\, ds}_{\text{outward flux}}
= \oint_C M\, dy - N\, dx
</mrow>
<mrow xml:id="eq-green-normal" number="yes">
\amp \quad = \underbrace{\iint_R \left( \frac{\partial M}{\partial x}
+ \frac{\partial N}{\partial y} \right) dx\, dy}_{\substack{\text{integral of}
\\ \operatorname{div}\mathbf{F} \text{ over } R}}.
</mrow>
</md>
</statement>
</theorem>

<example xml:id="example-green-circle-normal">
<title>Verifying the Normal Form on the Unit Circle</title>
<statement>
<p>
Assume that the vector field
<m>\mathbf{F}(x,y) = (x - y)\,\mathbf{i} + x\,\mathbf{j}</m> and the
closed curve <m>C</m> is the unit circle centered at the origin.
Convince yourself of the normal form of Green's theorem,
<xref ref="eq-green-normal"/>, by applying it to this example.
</p>
<p>
<em>Solution.</em>
(Compare with <xref ref="fig-green-circle-video"/>.)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,14);
\draw[gray!35] (0,7) -- (15,7);
\node[anchor=north west, font=\small\itshape] at (0.35,13.7) {the outward flux, $\displaystyle\oint_C \mathbf F\cdot\mathbf n\,ds =$};
\node[anchor=north west, font=\small\itshape] at (0.35,6.7) {the double integral of $\operatorname{div}\mathbf F$ over $R$:};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in two rows, for the outward flux across the circle and for the double integral of the divergence over the disk.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

</subsubsection>

</subsection>

<!-- ================================================================ -->
<subsection xml:id="sec-green-circulation">
<title>Circulation and Curl</title>

<subsubsection xml:id="sec-curl">
<title>Curl</title>

<p>
Again, let us consider a vector field
<m>\mathbf{F}(x,y) = M(x,y)\,\mathbf{i} + N(x,y)\,\mathbf{j}</m> to be
the velocity field of a fluid. This time we are interested in answering
this question: how can we figure out the <term>circulation
density</term> of the fluid at any point on the <m>xy</m>-plane?
</p>

<p>
To answer this question, we compute the flow rates of the vector field
<m>\mathbf{F}</m> <em>along</em> the sides of the rectangle
(counterclockwise), as in <xref ref="fig-curl-circulation"/>, and then
we take the limit as <m>\Delta x, \Delta y \to 0</m> to find the
circulation density at a point in the <m>xy</m>-plane.
</p>

<figure xml:id="fig-curl-circulation">
<caption>
The counterclockwise circulation of
<m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m> around the rectangle.
Each side's direction of travel is drawn in its own color.
</caption>
<image width="92%">
<shortdescription>
A rectangle in a vector field with differently colored arrows tracing a counterclockwise loop along its sides.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-curl-circulation">
<diagram dimensions="(580,300)" margins="10">
<definition>field(x,y) = (0.4*x + 0.25, 0.32*y + 0.18)</definition>
<coordinates bbox="(-5.6,-0.6,8.7,4.6)">
<vector-field at="cf-field" function="field"
              spacings="((1.8,1.8,5.5),(0.15,1.3,4.1))" scale="0.36"
              stroke="#bbbbbb"/>
<polygon closed="yes" at="cf-rect" points="((1.2,1.0),(4.8,1.0),(4.8,3.2),(1.2,3.2))"
         stroke="#2b9ad6" thickness="2.5" fill="none"/>
<point at="cf-corner-bl" clear-background="yes" background-margin="3" p="(1.2,1.0)" fill="#d02090" size="3"
       alignment="sw">
<m>(x,y)</m>
</point>
<point at="cf-corner-br" clear-background="yes" background-margin="3" p="(4.8,1.0)" fill="#2b9ad6" size="3"
       alignment="se">
<m>(x+\Delta x, y)</m>
</point>
<point at="cf-corner-tl" clear-background="yes" background-margin="3" p="(1.2,3.2)" fill="#2b9ad6" size="3"
       alignment="nw">
<m>(x, y+\Delta y)</m>
</point>
<point at="cf-corner-tr" clear-background="yes" background-margin="3" p="(4.8,3.2)" fill="#2b9ad6" size="3"
       alignment="ne">
<m>(x+\Delta x, y+\Delta y)</m>
</point>
<line at="cf-top" p1="(3.2,3.2)" p2="(2.65,3.2)" arrows="1"
      stroke="#D55E00" thickness="3"/>
<line at="cf-bottom" p1="(2.8,1.0)" p2="(3.35,1.0)" arrows="1"
      stroke="#E69F00" thickness="3"/>
<line at="cf-right" p1="(4.8,1.9)" p2="(4.8,2.45)" arrows="1"
      stroke="#009E73" thickness="3"/>
<line at="cf-left" p1="(1.2,2.3)" p2="(1.2,1.75)" arrows="1"
      stroke="#7b3294" thickness="3"/>
<!-- Legend: the field itself (the gray arrows).  The rows that paired -->
<!-- each side's color with its dot product were cut: they gave the    -->
<!-- derivation away.                                                  -->
<!-- The side colors match the flux figure earlier in this section,   -->
<!-- and as there the dot-product rows of the legend were cut.        -->
<line at="cf-leg-field" p1="(-5.45,4.35)" p2="(-5.05,4.35)" arrows="1"
      stroke="#bbbbbb" thickness="2"/>
<label at="cf-leg-field-label" clear-background="yes" background-margin="4" anchor="(-4.95,4.35)" alignment="e">
<m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m>
</label>
<label at="cf-A" clear-background="yes" background-margin="4" anchor="(3.0,2.35)" alignment="c">
<m>A</m>
</label>
<label at="cf-dx" clear-background="yes" background-margin="4" anchor="(3.0,0.05)" alignment="s">
<m>\Delta x</m>
</label>
<label at="cf-dy" clear-background="yes" background-margin="4" anchor="(5.95,2.1)" alignment="e">
<m>\Delta y</m>
</label>
</coordinates>
<annotations>
<annotation ref="figure" text="The same blue rectangle in the same gray vector field, but now the arrows point along the sides, tracing a counterclockwise loop: rightward along the bottom, up the right side, leftward along the top, and down the left side. Each side's arrow has its own color, the same color as in the flux figure, and a legend at the upper left names the gray arrows as the field F.">
  <annotation ref="cf-rect" text="The rectangle around which we measure the counterclockwise circulation."/>
  <annotation ref="cf-bottom" text="The bottom side, in orange, travelled to the right."/>
  <annotation ref="cf-right" text="The right side, in green, travelled upward."/>
  <annotation ref="cf-top" text="The top side, in vermillion, travelled to the left."/>
  <annotation ref="cf-left" text="The left side, in purple, travelled downward."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</figure>

<p>
Find the circulation density for the rectangle of
<xref ref="fig-curl-circulation"/>.
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,11);
\draw[gray!35] (0,3.5) -- (15,3.5);
\node[anchor=north west, text=gray!60, font=\footnotesize\itshape]
  at (0.25,10.75) {workspace};
\node[anchor=north west, font=\small\itshape] at (0.35,3.2) {circulation density $\approx$};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank workspace, with a last row for the circulation density.</shortdescription>
</image>
</sidebyside>

<p>
This quantity is denoted by
<m>\operatorname{curl} \mathbf{F} \cdot \mathbf{k}</m> and is known as
the <term><m>k</m>-component of curl</term>.
</p>

<definition xml:id="def-curl-k">
<statement>
<p>
The <m>k</m>-component of the curl of the vector field
<m>\mathbf{F}(x,y) = M(x,y)\,\mathbf{i} + N(x,y)\,\mathbf{j}</m> is
</p>

<men xml:id="eq-curl-def">
\operatorname{curl} \mathbf{F} \cdot \mathbf{k}
= \frac{\partial N}{\partial x} - \frac{\partial M}{\partial y}.
</men>
</statement>
</definition>

<p>
To find out the circulation density at a point in the
<m>xy</m>-plane, you can imagine a <term>paddle wheel</term> whose axis
goes through the point of interest. Then the <m>k</m>-component of curl
is positive if the fluid flow causes the paddle wheel to rotate
counterclockwise, and it is negative if it turns clockwise. The
animation in <xref ref="fig-curl-video"/> shows both behaviors.
</p>

<figure xml:id="fig-curl-video">
<caption>
The counterclockwise circulation of <m>\mathbf{F}</m> around a small
rectangle, divided by its area, converges to the <m>k</m>-component of
curl. A paddle wheel placed in the fluid spins counterclockwise where
the curl is positive.
</caption>
<video preview="play-button.png" xml:id="video-curl"
       source="videos/curl_circulation_1080p.mp4"
       width="70%" aspect="16:9"/>
</figure>

<example xml:id="example-curl-fields">
<title>Computing and Interpreting Curl</title>
<statement>
<p>
The vector fields below represent the velocity field of a fluid.
Calculate the curl in each case and explain what it means physically.
</p>

<p>
<ol marker="A.">
<li>
<p>
<m>\mathbf{F}(x,y) = 2x\,\mathbf{i} + 2y\,\mathbf{j}</m>
</p>
</li>
<li>
<p>
<m>\mathbf{F}(x,y) = -2y\,\mathbf{i} + 2x\,\mathbf{j}</m>
</p>
</li>
</ol>
</p>
<p>
<em>Solution.</em>
(Compare with <xref ref="fig-curl-fields"/>.)
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,9);
\draw[gray!35] (0,4.5) -- (15,4.5);
\node[anchor=north west, font=\small\itshape] at (0.35,8.7) {A. $\operatorname{curl}\mathbf F\cdot\mathbf k =$ \qquad meaning:};
\node[anchor=north west, font=\small\itshape] at (0.35,4.2) {B. $\operatorname{curl}\mathbf F\cdot\mathbf k =$ \qquad meaning:};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in two labelled rows, one for the k component of the curl of each field with its physical meaning.</shortdescription>
</image>
</sidebyside>
</statement>
</example>

<figure xml:id="fig-curl-fields">
<caption>
Left: the field <m>2x\,\mathbf{i} + 2y\,\mathbf{j}</m>. Right: the
field <m>-2y\,\mathbf{i} + 2x\,\mathbf{j}</m>. Compare with the curls
you computed.
</caption>
<sidebyside widths="46% 46%" valign="middle">
<image>
<shortdescription>
A radial field with arrows pointing away from the origin.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-curl-field-A">
<diagram dimensions="(280,280)" margins="10">
<definition>fieldA(x,y) = (2*x, 2*y)</definition>
<coordinates bbox="(-3.4,-3.4,3.4,3.4)">
<axes at="cfa-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<vector-field at="cfa-field" function="fieldA"
              spacings="((-3,1,3),(-3,1,3))" stroke="#2b6cb0"/>
</coordinates>
<annotations>
<annotation ref="figure" text="The radial vector field 2 x i plus 2 y j, arrows pointing away from the origin. Its curl is zero: the flow does not rotate a paddle wheel.">
  <annotation ref="cfa-field" text="Arrows pointing radially outward; no rotation anywhere."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
<image>
<shortdescription>
A rotational field circulating counterclockwise, arrows longer farther out.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-curl-field-B">
<diagram dimensions="(280,280)" margins="10">
<definition>fieldB(x,y) = (-2*y, 2*x)</definition>
<coordinates bbox="(-3.4,-3.4,3.4,3.4)">
<axes at="cfb-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<vector-field at="cfb-field" function="fieldB"
              spacings="((-3,1,3),(-3,1,3))" stroke="#2b6cb0"/>
</coordinates>
<annotations>
<annotation ref="figure" text="The rotational vector field negative 2 y i plus 2 x j. Arrows circulate counterclockwise around the origin, longer farther out. Its curl is 4 everywhere: a paddle wheel spins counterclockwise.">
  <annotation ref="cfb-field" text="Arrows circulating counterclockwise around the origin, growing with distance."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
</sidebyside>
</figure>
</subsubsection>

<subsubsection xml:id="sec-green-circulation-integral">
<title>The Circulation Around a Plane Curve</title>

<p>
The second form of Green's theorem, in <xref ref="sec-green-tangential-form"/>,
measures how much of a field flows <em>along</em> a closed curve
<m>C</m>, traversed counterclockwise. That is the line integral of a
vector field from <xref ref="subsec-work-force-field"/>: the component of
<m>\mathbf{F}</m> along the unit tangent <m>\mathbf{T}</m> of
<xref ref="eq-unit-tangent"/>, integrated with respect to arc length.
Around a closed curve it is called the <term>circulation</term> of
<m>\mathbf{F}</m> around <m>C</m>. Since <m>\mathbf{T}\,ds = d\mathbf{r}</m>,
for <m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m> it is
</p>

<md>
<mrow>
\oint_C \mathbf{F}\cdot\mathbf{T}\,ds \amp = \oint_C \mathbf{F}\cdot d\mathbf{r}
</mrow>
<mrow>
\amp = \oint_C M\,dx + N\,dy,
</mrow>
</md>

<p>
the differential form of <xref ref="eq-work-differential"/>.
</p>
</subsubsection>

<subsubsection xml:id="sec-green-tangential-form">
<title>Green's Theorem: The Circulation-Curl (Tangential) Form</title>

<p>
The second form of Green's theorem connects the counterclockwise
circulation of a vector field around a simple closed curve <m>C</m>
and the double integral of the <m>\mathbf{k}</m>-component of the curl
of the field over the region <m>R</m> enclosed by the curve.
</p>

<theorem xml:id="thm-green-tangential">
<title>Green's Theorem (Circulation-Curl or Tangential Form)</title>
<statement>
<p>
Let <m>C</m> be a piecewise smooth, simple closed curve enclosing a
region <m>R</m> in the plane. Let
<m>\mathbf{F} = M\,\mathbf{i} + N\,\mathbf{j}</m> be a vector field
with <m>M</m> and <m>N</m> having continuous first partial derivatives
in an open region containing <m>R</m>. Then the counterclockwise
circulation of <m>\mathbf{F}</m> around <m>C</m> equals the double
integral of <m>(\operatorname{curl} \mathbf{F}) \cdot \mathbf{k}</m>
over <m>R</m>:
</p>

<md>
<mrow>
\amp \underbrace{\oint_C \mathbf{F} \cdot \mathbf{T}\, ds}_{\text{circulation}}
= \oint_C M\, dx + N\, dy
</mrow>
<mrow xml:id="eq-green-tangential" number="yes">
\amp \quad = \underbrace{\iint_R \left( \frac{\partial N}{\partial x}
- \frac{\partial M}{\partial y} \right) dx\, dy}_{\substack{\text{integral of}
\\ \operatorname{curl}\mathbf{F}\cdot\mathbf{k} \text{ over } R}}.
</mrow>
</md>
</statement>

<proof xml:id="proof-green-tangential">
<p>
Prove <xref ref="eq-green-tangential"/> for a region like the one in
<xref ref="fig-green-proof-prefigure"/>, and explain why it holds for a
general region. Compare with <xref ref="fig-green-proof-video"/>.
</p>

<sidebyside width="97%">
<image>
<latex-image>
\begin{tikzpicture}
\draw[rounded corners=8pt, draw=gray!55, thick] (0,0) rectangle (15,20);
\draw[gray!35] (0,7) -- (15,7);
\node[anchor=north west, font=\small\itshape] at (0.35,19.7) {for a region like the one in the figure:};
\node[anchor=north west, font=\small\itshape] at (0.35,6.7) {for a general region:};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in two rows, for the proof on a region like the one in the figure and for a general region.</shortdescription>
</image>
</sidebyside>
</proof>
</theorem>

<figure xml:id="fig-green-proof-prefigure">
<caption>
A region <m>R</m> with <m>f_2(x) \le y \le f_1(x)</m> for
<m>a \le x \le b</m>, and its boundary <m>C</m> traversed
counterclockwise.
</caption>
<image width="72%">
<shortdescription>
A region between an upper and a lower curve with a counterclockwise boundary.
</shortdescription>
<prefigure xmlns="https://prefigure.org" label="prefigure-green-proof">
<diagram dimensions="(430,300)" margins="12">
<definition>bottom(t) = (t, 0.55 + 0.30*sin(1.5*t - 0.6))</definition>
<definition>top(t) = (t, 2.35 - 0.35*sin(1.2*t + 0.4))</definition>
<coordinates bbox="(-0.5,-0.65,4.35,3.15)">
<polygon at="gp-region" closed="yes" fill="#dcecf7" stroke="none"
    points="((0.800,0.719),(1.025,0.792),(1.250,0.837),(1.475,0.850),(1.700,0.829),(1.925,0.776),(2.150,0.698),(2.375,0.603),(2.600,0.503),(2.825,0.407),(3.050,0.328),(3.275,0.274),(3.500,0.251),(3.500,2.698),(3.275,2.675),(3.050,2.628),(2.825,2.561),(2.600,2.479),(2.375,2.388),(2.150,2.294),(1.925,2.204),(1.700,2.124),(1.475,2.061),(1.250,2.019),(1.025,2.001),(0.800,2.008))"/>
<axes at="gp-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<parametric-curve at="gp-bottom" function="bottom" domain="(0.8,3.5)"
    stroke="#0072B2" thickness="3"/>
<parametric-curve at="gp-top" function="top" domain="(0.8,3.5)"
    stroke="#0072B2" thickness="3"/>
<line at="gp-left" endpoints="((0.8,0.719),(0.8,2.008))" stroke="#0072B2"
    thickness="3"/>
<line at="gp-right" endpoints="((3.5,0.251),(3.5,2.698))"
    stroke="#0072B2" thickness="3"/>
<vector at="gp-arrow-bottom" v="(0.34,-0.113)" tail="(1.85,0.792)"
    stroke="#0072B2" thickness="3"/>
<vector at="gp-arrow-top" v="(-0.34,-0.143)" tail="(2.45,2.297)"
    stroke="#0072B2" thickness="3"/>
<line at="gp-a" endpoints="((0.8,0),(0.8,-0.17))" stroke="#555555"
    thickness="1.5"/>
<line at="gp-b" endpoints="((3.5,0),(3.5,-0.17))" stroke="#555555"
    thickness="1.5"/>
<label at="gp-alab" anchor="(0.8,-0.2)" alignment="s"><m>a</m></label>
<label at="gp-blab" anchor="(3.5,-0.2)" alignment="s"><m>b</m></label>
<label at="gp-bottomlab" anchor="(1.55,0.80)" alignment="s"
    color="#0072B2"><m>y = f_2(x)</m></label>
<label at="gp-toplab" anchor="(1.35,2.07)" alignment="n"
    color="#0072B2"><m>y = f_1(x)</m></label>
<label at="gp-region-lab" anchor="(2.35,1.45)" alignment="center">
<m>R</m>
</label>
</coordinates>
<annotations>
<annotation ref="figure" text="A shaded region R in the plane lying between a lower curve y equals f two of x and an upper curve y equals f one of x, for x between a and b. The boundary is drawn in blue with an arrowhead on the lower curve pointing right and one on the upper curve pointing left, so the boundary is travelled counterclockwise. Short vertical sides close the region at x equals a and x equals b.">
  <annotation ref="gp-region" text="The region R, between the two curves."/>
  <annotation ref="gp-bottom" text="The lower boundary curve y equals f two of x, travelled from left to right."/>
  <annotation ref="gp-top" text="The upper boundary curve y equals f one of x, travelled from right to left."/>
