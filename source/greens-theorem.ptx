<annotations>
<annotation ref="figure" text="A blue rectangle with corner x comma y, width delta x, and height delta y, sitting in a gray vector field that points up and to the right. An arrow at the middle of each side, in that side's own color, points out of the rectangle, and a legend at the upper left names the gray arrows as the field F.">
  <annotation ref="df-rect" text="The rectangle with area A equals delta x delta y through whose boundary we measure the net flux."/>
  <annotation ref="df-top" text="The top side, in vermillion, with its outward arrow."/>
  <annotation ref="df-right" text="The right side, in green, with its outward arrow."/>
  <annotation ref="df-bottom" text="The bottom side, in orange, with its outward arrow."/>
