\draw[gray!35] (0,4.5) -- (15,4.5);
\node[anchor=north west, font=\small\itshape] at (0.35,7.7) {$\mathbf r(1) =$ \qquad $\mathbf r(2) =$};
\node[anchor=north west, font=\small\itshape] at (0.35,4.2) {$\displaystyle\int_C \mathbf F\cdot d\mathbf r =$ \qquad because};
\end{tikzpicture}
</latex-image>
<shortdescription>Blank box in two rows, for the two endpoints of the curve and for the value of the line integral with its justification.</shortdescription>
</image>
</sidebyside>
</statement>
</exercise>

<figure xml:id="fig-vf-curve">
<caption>
The same field <m>\mathbf{F}=\tfrac13\left\langle z,\ z,\ x+y\right\rangle</m>
and the same endpoints as in <xref ref="fig-vf-segment"/>, but now joined by
the curve
<m>\mathbf{r}(t)=\left\langle \frac{\ln t}{\ln 2},\ t^{3/2},\
t\cos(\pi t)\right\rangle</m>.
</caption>
