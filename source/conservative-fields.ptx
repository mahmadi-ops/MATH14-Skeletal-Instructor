(1.2 + 0.45*cos(2*t) + 0.25*sin(3*t))*sin(t) + 0.4)</definition>
<coordinates bbox="(-2.9,-2.2,2.9,2.8)">
<axes at="sc-axes" xlabel="x" ylabel="y" decorations="no" arrows="1"/>
<parametric-curve at="sc-region" function="blob" domain="(0,2*pi)"
    closed="yes" fill="#f4e3c1" stroke="#56B4E9" thickness="2"/>
<label at="sc-label" anchor="(1.5,-1.75)" alignment="s">
Simply connected
</label>
</coordinates>
<annotations>
<annotation ref="figure" text="A blob shaped region in the x y plane with no holes, filled in tan with a light blue boundary. The region is labeled simply connected.">
  <annotation ref="sc-region" text="A blob shaped region with no holes. Any loop drawn inside this region can be contracted to a point without leaving the region."/>
</annotation>
</annotations>
</diagram>
</prefigure>
</image>
<image>
